//@version=5
// ═══════════════════════════════════════════════════════════════════════════════
//  SMT DEV - SMT Divergence Detector
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Description:
//      Advanced SMT divergence detector that tracks and
//      compares price action across multiple correlated symbols in real-time.
//      Identifies divergences between main chart and comparison symbols across
//      multiple time cycles (90min, 30min, 10min & 3min) and major trading
//      sessions (Asia, London, NY) to spot potential reversal points.
//
//  Key Features:
//      • Real-time cycle and session high/low tracking with dynamic line updates
//      • Multi-symbol comparison (up to 2 additional symbols)
//      • 4 independent time cycles (90min, 30min, 10min, 3min)
//      • 4 major trading sessions (Asia, London, NY AM, NY PM)
//      • 8 SMT detection types (Normal & Inverse for Bullish/Bearish)
//      • Automatic invalidation of broken SMT patterns
//      • Smart symbol abbreviation for clean chart display
//
//  Version: DEV
//  Author: StoneFace / StoneFace_Trading
//  Release Date: Nov. 18. 2025
//  
//  © 2025. Stoneface. All rights reserved.
//
// ═══════════════════════════════════════════════════════════════════════════════

indicator("SMT DEV - SMT Detector", 
     shorttitle="SMT DEV", 
     overlay=true, 
     max_lines_count=500, 
     max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS & SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
string GROUP_SYMBOLS = "Comparison Symbols"
string GROUP_CYCLES = "Time Cycle Settings"
string GROUP_SESSIONS = "Session SMT Settings"
string GROUP_FILTER = "Session Filter (For Time Cycles)"
string GROUP_DISPLAY = "Display Settings"

// Symbols
enableSymbol1 = input.bool(true, "Enable Symbol 1", group=GROUP_SYMBOLS, inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", group=GROUP_SYMBOLS, inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group=GROUP_SYMBOLS, inline="sym2")
symbol2 = input.symbol("ES1!", "", group=GROUP_SYMBOLS, inline="sym2")

// Time Cycles
enable90min = input.bool(true, "90-Minute Cycle", group=GROUP_CYCLES)
enable30min = input.bool(true, "30-Minute Cycle", group=GROUP_CYCLES)
enable10min = input.bool(true, "10-Minute Cycle", group=GROUP_CYCLES)
enable3min = input.bool(true, "3-Minute Cycle", group=GROUP_CYCLES)

// Session SMT
enableSessionSmt = input.bool(true, "Enable Session SMT", group=GROUP_SESSIONS)

// Session Filter for Time Cycles
enableSessionFilter = input.bool(true, "Enable Session Filter", group=GROUP_FILTER)
sessionFilterTimes = input.session("0230-1600", "Session Time", group=GROUP_FILTER)
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group=GROUP_FILTER)

// Display
maxTotalLines = input.int(8, "Max Total SMT Lines", minval=1, maxval=40, group=GROUP_DISPLAY)


// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type PivotPoint
    float price
    int barIndex
    int time

createPivot(float price, int barIdx, int t) =>
    PivotPoint.new(price, barIdx, t)

// --- Cycle Types ---
type CycleData
    int startTime
    int startBar
    PivotPoint mainPivotHigh
    PivotPoint mainPivotLow
    PivotPoint s1PivotHigh
    PivotPoint s1PivotLow
    PivotPoint s2PivotHigh
    PivotPoint s2PivotLow
    bool active

type CycleManager
    int duration
    string label
    bool enabled
    CycleData current
    array<CycleData> history

// --- Session SMT Types ---
type SessionPivotData
    PivotPoint mainPivotHigh
    PivotPoint mainPivotLow
    PivotPoint s1PivotHigh
    PivotPoint s1PivotLow
    PivotPoint s2PivotHigh
    PivotPoint s2PivotLow

type SessionSmtManager
    string name
    string sessionTime
    bool active
    SessionPivotData currentPivots
    SessionPivotData previousPivots

// --- Shared Drawing Type ---
type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    float length
    int smtTypeId
    float mainPrice
    float compPrice
    string symbols
    string smtLabel // "90", "30", "London", "NY AM" etc.
    int historyBarStart
    bool isDynamic // Is this a line that updates in real-time?

// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE & CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// Security Data
[s1_high, s1_low, s1_close] = request.security(symbol1, "", [high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, "", [high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// State Variables
var array<CycleManager> cycleManagers = array.new<CycleManager>()
var array<SessionSmtManager> sessionManagers = array.new<SessionSmtManager>()
var array<LineMetadata> lines = array.new<LineMetadata>()

var int lastDay = na
var string s1Abbr = ""
var string s2Abbr = ""
var string lastSessionName = na
var int activeSessionManagerIdx = -1

// Session SMT Constants
string SESSION_ASIA = "Asia"
string SESSION_LONDON = "London"
string SESSION_NY_AM = "NY AM"
string SESSION_NY_PM = "NY PM"

string TIME_ASIA = "1900-0230"
string TIME_LONDON = "0230-0700"
string TIME_NY_AM = "0700-1130"
string TIME_NY_PM = "1130-1600"


// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getAbbr(sym) =>
    parts = str.split(sym, ":")
    ticker = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    clean = str.replace_all(str.replace_all(str.replace_all(ticker, "USDT", ""), ".P", ""), "USD", "")
    if str.contains(clean, "1!")
        clean := str.replace_all(clean, "1!", "")
        str.substring(clean, 0, math.min(str.length(clean), 2))
    else
        str.substring(clean, 0, math.min(str.length(clean), 4))

inTimeCycleSession() => 
    not enableSessionFilter or not na(time(timeframe.period, sessionFilterTimes, sessionTimezone))

inSession(sessionTime) =>
    not na(time(timeframe.period, sessionTime, sessionTimezone))

calcLen(bar1, price1, bar2, price2) =>
    barDiff = math.abs(bar2 - bar1)
    priceDiff = math.abs(price2 - price1)
    math.sqrt(barDiff * barDiff + priceDiff * priceDiff)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initCycleData() =>
    CycleData.new(na, na, createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), false)

initSessionPivotData() =>
    SessionPivotData.new(createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na))

if barstate.isfirst
    // Init Time Cycle Managers
    array.push(cycleManagers, CycleManager.new(90, "90", enable90min, initCycleData(), array.new<CycleData>()))
    array.push(cycleManagers, CycleManager.new(30, "30", enable30min, initCycleData(), array.new<CycleData>()))
    array.push(cycleManagers, CycleManager.new(10, "10", enable10min, initCycleData(), array.new<CycleData>()))
    array.push(cycleManagers, CycleManager.new(3, "3", enable3min, initCycleData(), array.new<CycleData>()))
    
    // Init Session SMT Managers
    array.push(sessionManagers, SessionSmtManager.new(SESSION_ASIA, TIME_ASIA, false, initSessionPivotData(), initSessionPivotData()))
    array.push(sessionManagers, SessionSmtManager.new(SESSION_LONDON, TIME_LONDON, false, initSessionPivotData(), initSessionPivotData()))
    array.push(sessionManagers, SessionSmtManager.new(SESSION_NY_AM, TIME_NY_AM, false, initSessionPivotData(), initSessionPivotData()))
    array.push(sessionManagers, SessionSmtManager.new(SESSION_NY_PM, TIME_NY_PM, false, initSessionPivotData(), initSessionPivotData()))

    s1Abbr := getAbbr(symbol1)
    s2Abbr := getAbbr(symbol2)

// ═══════════════════════════════════════════════════════════════════════════════
//                              PIVOT & STATE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

copyPivots(pivots) =>
    SessionPivotData.new(
         createPivot(pivots.mainPivotHigh.price, pivots.mainPivotHigh.barIndex, pivots.mainPivotHigh.time),
         createPivot(pivots.mainPivotLow.price, pivots.mainPivotLow.barIndex, pivots.mainPivotLow.time),
         createPivot(pivots.s1PivotHigh.price, pivots.s1PivotHigh.barIndex, pivots.s1PivotHigh.time),
         createPivot(pivots.s1PivotLow.price, pivots.s1PivotLow.barIndex, pivots.s1PivotLow.time),
         createPivot(pivots.s2PivotHigh.price, pivots.s2PivotHigh.barIndex, pivots.s2PivotHigh.time),
         createPivot(pivots.s2PivotLow.price, pivots.s2PivotLow.barIndex, pivots.s2PivotLow.time)
    )

startCycle(c) =>
    c.startTime := time
    c.startBar := bar_index
    c.mainPivotHigh := createPivot(na, na, na)
    c.mainPivotLow := createPivot(na, na, na)
    c.s1PivotHigh := createPivot(na, na, na)
    c.s1PivotLow := createPivot(na, na, na)
    c.s2PivotHigh := createPivot(na, na, na)
    c.s2PivotLow := createPivot(na, na, na)
    c.active := true

updatePivots(pivots) =>
    // This function updates a passed-in pivot object (CycleData or SessionPivotData)
    // Track highest high
    if high > pivots.mainPivotHigh.price or na(pivots.mainPivotHigh.price)
        pivots.mainPivotHigh.price := high
        pivots.mainPivotHigh.barIndex := bar_index
        pivots.mainPivotHigh.time := time
    // Track lowest low
    if low < pivots.mainPivotLow.price or na(pivots.mainPivotLow.price)
        pivots.mainPivotLow.price := low
        pivots.mainPivotLow.barIndex := bar_index
        pivots.mainPivotLow.time := time
    // Track Symbol 1 extremes
    if enableSymbol1 and not na(s1_high)
        if s1_high > pivots.s1PivotHigh.price or na(pivots.s1PivotHigh.price)
            pivots.s1PivotHigh.price := s1_high
            pivots.s1PivotHigh.barIndex := bar_index
            pivots.s1PivotHigh.time := time
        if s1_low < pivots.s1PivotLow.price or na(pivots.s1PivotLow.price)
            pivots.s1PivotLow.price := s1_low
            pivots.s1PivotLow.barIndex := bar_index
            pivots.s1PivotLow.time := time
    // Track Symbol 2 extremes
    if enableSymbol2 and not na(s2_high)
        if s2_high > pivots.s2PivotHigh.price or na(pivots.s2PivotHigh.price)
            pivots.s2PivotHigh.price := s2_high
            pivots.s2PivotHigh.barIndex := bar_index
            pivots.s2PivotHigh.time := time
        if s2_low < pivots.s2PivotLow.price or na(pivots.s2PivotLow.price)
            pivots.s2PivotLow.price := s2_low
            pivots.s2PivotLow.barIndex := bar_index
            pivots.s2PivotLow.time := time

completeCycle(m) =>
    mainHighCopy = createPivot(m.current.mainPivotHigh.price, m.current.mainPivotHigh.barIndex, m.current.mainPivotHigh.time)
    mainLowCopy = createPivot(m.current.mainPivotLow.price, m.current.mainPivotLow.barIndex, m.current.mainPivotLow.time)
    s1HighCopy = createPivot(m.current.s1PivotHigh.price, m.current.s1PivotHigh.barIndex, m.current.s1PivotHigh.time)
    s1LowCopy = createPivot(m.current.s1PivotLow.price, m.current.s1PivotLow.barIndex, m.current.s1PivotLow.time)
    s2HighCopy = createPivot(m.current.s2PivotHigh.price, m.current.s2PivotHigh.barIndex, m.current.s2PivotHigh.time)
    s2LowCopy = createPivot(m.current.s2PivotLow.price, m.current.s2PivotLow.barIndex, m.current.s2PivotLow.time)
    savedCycle = CycleData.new(m.current.startTime, m.current.startBar, mainHighCopy, mainLowCopy, s1HighCopy, s1LowCopy, s2HighCopy, s2LowCopy, true)
    array.push(m.history, savedCycle)
    startCycle(m.current)

shouldCompleteCycle(c, durMin) =>
    if not c.active or na(c.startTime)
        false
    else
        elapsedBars = bar_index - c.startBar
        expectedBars = math.floor((durMin * 60000) / (timeframe.in_seconds * 1000))
        elapsedBars >= expectedBars or (time - c.startTime >= durMin * 60000)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION & DRAWING
// ═══════════════════════════════════════════════════════════════════════════════

isInvalidated(meta, isS1, isHigh, bearish, inverse, currMain, currComp) =>
    if na(currComp) or na(currMain)
        false
    else
        if inverse // Inverse SMT invalidation
            bearish ? (currComp < meta.compPrice or currMain > meta.mainPrice) : (currComp > meta.compPrice or currMain < meta.mainPrice)
        else // Normal SMT invalidation
            bearish ? currMain > meta.mainPrice or currComp > meta.compPrice : currMain < meta.mainPrice or currComp < meta.compPrice

drawSMT(bar1, time1, price1, bar2, time2, price2, symbolStr, labelStr, isBearish, typeId, compPrice, isDynamicLine) =>
    if na(bar1) or na(bar2)
        false
    else
        newLen = calcLen(bar1, price1, bar2, price2)
        mergeIdx = -1
        
        lineColor = color.black
        textColor = color.black
        
        if array.size(lines) > 0
            for i = 0 to array.size(lines) - 1
                m = array.get(lines, i)
                if m.isBearish == isBearish and m.smtLabel == labelStr and m.isDynamic
                    mergeIdx := i
                    break
        
        if mergeIdx >= 0
            existing = array.get(lines, mergeIdx)
            if newLen > existing.length
                line.delete(existing.lineObj)
                existing.lineObj := line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1)
                existing.length := newLen
                existing.mainPrice := price1
                existing.compPrice := compPrice
                labTime = time1 > time2 ? time1 : time2
                labPrice = time1 > time2 ? price1 : price2
                label.set_xy(existing.labelObj, labTime, labPrice)
            
            if not str.contains(existing.symbols, symbolStr)
                newSymbols = existing.symbols + "+" + symbolStr
                label.set_text(existing.labelObj, "SMT-" + newSymbols + " " + labelStr)
                existing.symbols := newSymbols
            false
        else
            l = line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1)
            labTime = time1 > time2 ? time1 : time2
            labPrice = time1 > time2 ? price1 : price2
            txt = "SMT-" + symbolStr + " " + labelStr
            lab = label.new(labTime, labPrice, txt, xloc=xloc.bar_time, style=label.style_none, color=textColor, textcolor=textColor, size=size.small, yloc=isBearish ? yloc.abovebar : yloc.belowbar)
            
            array.push(lines, LineMetadata.new(l, lab, isBearish, newLen, typeId, price1, compPrice, symbolStr, labelStr, bar2, isDynamicLine))
            
            while array.size(lines) > maxTotalLines
                old = array.shift(lines)
                line.delete(old.lineObj)
                label.delete(old.labelObj)
            true

checkInvalidation() =>
    if array.size(lines) > 0
        toRemove = array.new<int>()
        for i = 0 to array.size(lines) - 1
            m = array.get(lines, i)
            isS1 = m.smtTypeId in {0, 1, 4, 5}
            isHigh = m.smtTypeId in {0, 2, 4, 6}
            inverse = m.smtTypeId >= 4
            enabled = isS1 ? enableSymbol1 : enableSymbol2
            
            if enabled
                currMain = isHigh ? high : low
                currComp = isS1 ? (isHigh ? s1_high : s1_low) : (isHigh ? s2_high : s2_low)
                
                if not na(currMain) and not na(currComp)
                    if isInvalidated(m, isS1, isHigh, m.isBearish, inverse, currMain, currComp)
                        array.push(toRemove, i)
        
        if array.size(toRemove) > 0
            for i = array.size(toRemove) - 1 to 0
                idxToRemove = array.get(toRemove, i)
                if idxToRemove < array.size(lines)
                    old = array.remove(lines, idxToRemove)
                    line.delete(old.lineObj)
                    label.delete(old.labelObj)

updateDynamicLines(manager, isSessionManager) =>
    data = isSessionManager ? manager.currentPivots : manager.current
    label = isSessionManager ? manager.name : manager.label
    startBar = isSessionManager ? 0 : data.startBar
    
    if array.size(lines) > 0 and (isSessionManager ? manager.active : data.active)
        for i = 0 to array.size(lines) - 1
            meta = array.get(lines, i)
            if meta.isDynamic and meta.smtLabel == label and meta.historyBarStart >= startBar
                isHigh = meta.smtTypeId in {0, 2, 4, 6}
                currPivot = isHigh ? data.mainPivotHigh : data.mainPivotLow
                if not na(currPivot.price)
                    line.set_xy2(meta.lineObj, currPivot.time, currPivot.price)
                    x1 = line.get_x1(meta.lineObj)
                    y1 = line.get_y1(meta.lineObj)
                    labTime = x1 > currPivot.time ? x1 : currPivot.time
                    labPrice = x1 > currPivot.time ? y1 : currPivot.price
                    label.set_xy(meta.labelObj, labTime, labPrice)

processCycleSMT(m) =>
    if array.size(m.history) > 0
        curr = m.current
        prev = array.get(m.history, array.size(m.history) - 1)
        
        processSMT(curr, prev, m.label, s1Abbr, s2Abbr, true, prev.startBar)
        
        while array.size(m.history) > 3
            array.remove(m.history, 0)

processSessionSMT(m) =>
    if m.active and not na(m.previousPivots.mainPivotHigh.price)
        processSMT(m.currentPivots, m.previousPivots, m.name, s1Abbr, s2Abbr, true, bar_index) // Pass bar_index as history start

processSMT(curr, prev, label, s1, s2, isDynamic, histBarStart) =>
    // A generic SMT processing function
    if enableSymbol1
        if curr.mainPivotHigh.price > prev.mainPivotHigh.price and curr.s1PivotHigh.price < prev.s1PivotHigh.price
            drawSMT(prev.mainPivotHigh.barIndex, prev.mainPivotHigh.time, prev.mainPivotHigh.price, curr.mainPivotHigh.barIndex, curr.mainPivotHigh.time, curr.mainPivotHigh.price, s1, label, true, 0, curr.s1PivotHigh.price, isDynamic)
        if curr.mainPivotLow.price < prev.mainPivotLow.price and curr.s1PivotLow.price > prev.s1PivotLow.price
            drawSMT(prev.mainPivotLow.barIndex, prev.mainPivotLow.time, prev.mainPivotLow.price, curr.mainPivotLow.barIndex, curr.mainPivotLow.time, curr.mainPivotLow.price, s1, label, false, 1, curr.s1PivotLow.price, isDynamic)
        if curr.s1PivotHigh.price > prev.s1PivotHigh.price and curr.mainPivotHigh.price < prev.mainPivotHigh.price
            drawSMT(prev.mainPivotHigh.barIndex, prev.mainPivotHigh.time, prev.mainPivotHigh.price, curr.mainPivotHigh.barIndex, curr.mainPivotHigh.time, curr.mainPivotHigh.price, s1, label, true, 4, curr.s1PivotHigh.price, isDynamic)
        if curr.s1PivotLow.price < prev.s1PivotLow.price and curr.mainPivotLow.price > prev.mainPivotLow.price
            drawSMT(prev.mainPivotLow.barIndex, prev.mainPivotLow.time, prev.mainPivotLow.price, curr.mainPivotLow.barIndex, curr.mainPivotLow.time, curr.mainPivotLow.price, s1, label, false, 5, curr.s1PivotLow.price, isDynamic)
    if enableSymbol2
        if curr.mainPivotHigh.price > prev.mainPivotHigh.price and curr.s2PivotHigh.price < prev.s2PivotHigh.price
            drawSMT(prev.mainPivotHigh.barIndex, prev.mainPivotHigh.time, prev.mainPivotHigh.price, curr.mainPivotHigh.barIndex, curr.mainPivotHigh.time, curr.mainPivotHigh.price, s2, label, true, 2, curr.s2PivotHigh.price, isDynamic)
        if curr.mainPivotLow.price < prev.mainPivotLow.price and curr.s2PivotLow.price > prev.s2PivotLow.price
            drawSMT(prev.mainPivotLow.barIndex, prev.mainPivotLow.time, prev.mainPivotLow.price, curr.mainPivotLow.barIndex, curr.mainPivotLow.time, curr.mainPivotLow.price, s2, label, false, 3, curr.s2PivotLow.price, isDynamic)
        if curr.s2PivotHigh.price > prev.s2PivotHigh.price and curr.mainPivotHigh.price < prev.mainPivotHigh.price
            drawSMT(prev.mainPivotHigh.barIndex, prev.mainPivotHigh.time, prev.mainPivotHigh.price, curr.mainPivotHigh.barIndex, curr.mainPivotHigh.time, curr.mainPivotHigh.price, s2, label, true, 6, curr.s2PivotHigh.price, isDynamic)
        if curr.s2PivotLow.price < prev.s2PivotLow.price and curr.mainPivotLow.price > prev.mainPivotLow.price
            drawSMT(prev.mainPivotLow.barIndex, prev.mainPivotLow.time, prev.mainPivotLow.price, curr.mainPivotLow.barIndex, curr.mainPivotLow.time, curr.mainPivotLow.price, s2, label, false, 7, curr.s2PivotLow.price, isDynamic)

// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Daily Reset
currentDay = dayofmonth(time)
if currentDay != lastDay and not na(lastDay)
    for i = 0 to array.size(cycleManagers) - 1
        m = array.get(cycleManagers, i)
        array.clear(m.history)
        m.current.active := false
    for i = 0 to array.size(sessionManagers) - 1
        m = array.get(sessionManagers, i)
        m.active := false
        m.currentPivots := initSessionPivotData()
        m.previousPivots := initSessionPivotData()
    while array.size(lines) > 0
        old = array.shift(lines)
        line.delete(old.lineObj)
        label.delete(old.labelObj)
lastDay := currentDay

// Invalidation Check (runs every bar)
checkInvalidation()

// TIME CYCLE SMT LOGIC
if inTimeCycleSession()
    for i = 0 to array.size(cycleManagers) - 1
        m = array.get(cycleManagers, i)
        if not m.enabled or (m.duration == 3 and timeframe.in_seconds > 60)
            continue
        if not m.current.active
            startCycle(m.current)
        
        updatePivots(m.current)
        
        if shouldCompleteCycle(m.current, m.duration)
            completeCycle(m)
        
        processCycleSMT(m)
        updateDynamicLines(m, false)

// SESSION SMT LOGIC
if enableSessionSmt
    string currentSessionName = na
    for i = 0 to array.size(sessionManagers) - 1
        if inSession(array.get(sessionManagers, i).sessionTime)
            currentSessionName := array.get(sessionManagers, i).name
            activeSessionManagerIdx := i
            break

    if not na(currentSessionName)
        // Check if session has changed
        if currentSessionName != lastSessionName and not na(lastSessionName)
            // Find previous manager that just ended
            prevSessionIdx = activeSessionManagerIdx == 0 ? array.size(sessionManagers) - 1 : activeSessionManagerIdx - 1
            prevManager = array.get(sessionManagers, prevSessionIdx)
            
            // Hand off the completed pivots to the new session manager
            activeManager = array.get(sessionManagers, activeSessionManagerIdx)
            activeManager.previousPivots := copyPivots(prevManager.currentPivots)
            activeManager.currentPivots := initSessionPivotData() // Reset current pivots for new session
            activeManager.active := true
            
            // Deactivate the old one
            prevManager.active := false

        // If this is the first session of the day
        else if na(lastSessionName)
            manager = array.get(sessionManagers, activeSessionManagerIdx)
            manager.active := true

        // Process active session
        if activeSessionManagerIdx != -1
            manager = array.get(sessionManagers, activeSessionManagerIdx)
            if manager.active
                updatePivots(manager.currentPivots)
                processSessionSMT(manager)
                updateDynamicLines(manager, true)
    
    lastSessionName := currentSessionName
