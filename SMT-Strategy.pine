//@version=6
// ============================================================================
// SMT DIVERGENCE STRATEGY
// ============================================================================
// Based on SMT V-2.0 indicator logic by StoneFace
// This strategy detects Smart Money Technique (SMT) divergences using 
// time-based cycles between the current chart asset and comparison symbols.
//
// HOW IT WORKS:
// 1. Tracks highs/lows within fixed time cycles (90min and/or 30min)
// 2. When a new cycle completes, compares it to previous cycles
// 3. BEARISH SMT: Main makes HH but comparison makes LH → Wait for Bearish FVG
// 4. BULLISH SMT: Main makes LL but comparison makes HL → Wait for Bullish FVG
// 5. FVG ENTRY: Places limit order at FVG level for better entry price
// 6. INVERSE SMT: Opposite movements (comparison leads, main follows)
//
// FVG DEFINITION:
// - Bearish FVG: 3-candle pattern where candle 1 low > candle 3 high (gap down)
// - Bullish FVG: 3-candle pattern where candle 1 high < candle 3 low (gap up)
// - Entry: Limit order at low of bearish FVG / high of bullish FVG
//
// KEY FEATURES:
// - Auto-detects chart symbol
// - Choose between 90-minute and/or 30-minute cycles
// - FVG-based entry for precision fills
// - Session filtering (NY trading hours)
// - SMT invalidation detection
// - Full risk management system
// ============================================================================

strategy("SMT Divergence Strategy", overlay=true, initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity, default_qty_value=100, 
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=3,
     calc_on_every_tick=true)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Comparison Symbols
enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("BINANCE:ETHUSDT", "", confirm=false, group="Comparison Symbols", inline="sym2")

// Cycle Settings - Choose which cycle(s) to trade
enable90min = input.bool(true, "Use 90-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 90-minute time cycle for SMT detection")
enable30min = input.bool(true, "Use 30-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 30-minute time cycle for SMT detection")

// Session Filter
enableSession = input.bool(true, "Enable Session Filter", group="Session Filter")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter")
sessionTimezone = input.string("America/New_York", "Timezone", 
     options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter")

// Strategy Settings
useInverseSMT = input.bool(true, "Trade Inverse SMT Signals", group="Strategy Settings", 
     tooltip="Inverse SMT: Comparison leads, main follows")
onlyTradeNewSMT = input.bool(true, "Only Enter on Fresh SMT", group="Strategy Settings",
     tooltip="Avoid re-entering same SMT pattern")

// FVG Settings
useFVGEntry = input.bool(true, "Use FVG Entry", group="FVG Settings", 
     tooltip="Wait for FVG formation after SMT, then place limit order at FVG level")
maxBarsForFVG = input.int(20, "Max Bars to Wait for FVG", minval=1, maxval=100, group="FVG Settings",
     tooltip="Maximum bars to wait for FVG after SMT detection")
cancelFVGOnOpposite = input.bool(true, "Cancel FVG Order on Opposite Signal", group="FVG Settings",
     tooltip="Cancel pending FVG order if opposite SMT appears")

// Risk Management
useStopLoss = input.bool(true, "Use Stop Loss", group="Risk Management")
stopLossPercent = input.float(2.0, "Stop Loss %", minval=0.1, step=0.1, group="Risk Management")
useTakeProfit = input.bool(true, "Use Take Profit", group="Risk Management")
takeProfitPercent = input.float(4.0, "Take Profit %", minval=0.1, step=0.1, group="Risk Management")
useTrailingStop = input.bool(true, "Use Trailing Stop", group="Risk Management")
trailingStopPercent = input.float(1.5, "Trailing Stop %", minval=0.1, step=0.1, group="Risk Management")
trailingStopOffset = input.float(0.5, "Trailing Stop Offset %", minval=0.1, step=0.1, group="Risk Management")

// Exit on Invalidation
exitOnInvalidation = input.bool(true, "Exit on SMT Invalidation", group="Risk Management",
     tooltip="Close position if SMT pattern breaks")

// Visual Settings
showSMTToFVGLines = input.bool(true, "Show SMT→FVG Lines", group="Visuals", tooltip="Draw lines from SMT signal to FVG entry")
showFVGBoxes = input.bool(true, "Show FVG Boxes", group="Visuals", tooltip="Highlight FVG gap zones")
showEntryLines = input.bool(true, "Show Entry/Exit Lines", group="Visuals", tooltip="Draw entry, stop loss, and take profit lines")
showLabels = input.bool(true, "Show Labels", group="Visuals", tooltip="Show text labels for signals and entries")

// ═══════════════════════════════════════════════════════════════════════════════
//                              CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// SMT Type IDs
const int SMT_S1_BEARISH = 0
const int SMT_S1_BULLISH = 1
const int SMT_S2_BEARISH = 2
const int SMT_S2_BULLISH = 3
const int SMT_S1_INV_BEARISH = 4
const int SMT_S1_INV_BULLISH = 5
const int SMT_S2_INV_BEARISH = 6
const int SMT_S2_INV_BULLISH = 7

const int MS_PER_MINUTE = 60000

// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Cycle data tracking
type CycleData
    int startTime
    int startBar
    float mainHigh
    float mainLow
    int mainHighBar
    int mainLowBar
    int mainHighTime
    int mainLowTime
    float s1High
    float s1Low
    int s1HighBar
    int s1LowBar
    int s1HighTime
    int s1LowTime
    float s2High
    float s2Low
    int s2HighBar
    int s2LowBar
    int s2HighTime
    int s2LowTime
    bool active

// Cycle configuration
type CycleConfig
    int durationMinutes
    string label
    bool enabled

// Cycle manager
type CycleManager
    CycleConfig config
    CycleData current
    array<CycleData> history

// SMT configuration
type SMTConfig
    int typeId
    bool isSymbol1
    bool isHigh
    bool isBearish
    bool isInverse

// Trade tracking
type TradeInfo
    int smtTypeId
    int entryBar
    float entryPrice
    float mainPrice
    float compPrice
    bool isBearish
    bool isInverse
    bool isSymbol1
    bool isHigh

// FVG tracking
type FVGInfo
    bool waitingForFVG
    bool isBearish
    int smtBar
    float fvgLevel
    bool fvgFound
    int fvgBar
    float smtPrice
    line smtToFvgLine

// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE
// ═══════════════════════════════════════════════════════════════════════════════

// Security data
[s1_high, s1_low, s1_close] = request.security(symbol1, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)

// Cycle managers array
var array<CycleManager> cycleManagers = array.new<CycleManager>()

// SMT configurations
var array<SMTConfig> smtConfigs = array.new<SMTConfig>()

// Trade tracking
var TradeInfo currentTrade = na
var int lastSMTBar = na

// FVG tracking
var FVGInfo pendingFVG = na
var bool limitOrderPlaced = false

// Day tracking
var int lastDay = na

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

inSession() => 
    not enableSession or not na(time(timeframe.period, sessionStart, sessionTimezone))

// ═══════════════════════════════════════════════════════════════════════════════
//                              FVG DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Bearish FVG: 1st candle low > 3rd candle high (gap down)
isBearishFVG() =>
    low[2] > high[0]

// Bullish FVG: 1st candle high < 3rd candle low (gap up)
isBullishFVG() =>
    high[2] < low[0]

// Get FVG level (where limit order should be placed)
getBearishFVGLevel() =>
    if isBearishFVG()
        low[0]  // Low of 3rd candle
    else
        na

getBullishFVGLevel() =>
    if isBullishFVG()
        high[0]  // High of 3rd candle
    else
        na

// ═══════════════════════════════════════════════════════════════════════════════
//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initializeSMTConfigs() =>
    configs = array.new<SMTConfig>()
    array.push(configs, SMTConfig.new(SMT_S1_BEARISH, true, true, true, false))
    array.push(configs, SMTConfig.new(SMT_S1_BULLISH, true, false, false, false))
    array.push(configs, SMTConfig.new(SMT_S2_BEARISH, false, true, true, false))
    array.push(configs, SMTConfig.new(SMT_S2_BULLISH, false, false, false, false))
    array.push(configs, SMTConfig.new(SMT_S1_INV_BEARISH, true, true, true, true))
    array.push(configs, SMTConfig.new(SMT_S1_INV_BULLISH, true, false, false, true))
    array.push(configs, SMTConfig.new(SMT_S2_INV_BEARISH, false, true, true, true))
    array.push(configs, SMTConfig.new(SMT_S2_INV_BULLISH, false, false, false, true))
    configs

initializeCycleManagers() =>
    managers = array.new<CycleManager>()
    
    // 90-minute cycle
    config90 = CycleConfig.new(90, "90m", enable90min)
    cycle90 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config90, cycle90, array.new<CycleData>()))
    
    // 30-minute cycle
    config30 = CycleConfig.new(30, "30m", enable30min)
    cycle30 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config30, cycle30, array.new<CycleData>()))
    
    managers

if barstate.isfirst
    smtConfigs := initializeSMTConfigs()
    cycleManagers := initializeCycleManagers()

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

startNewCycle(cycle) =>
    cycle.startTime := time
    cycle.startBar := bar_index
    cycle.mainHigh := high
    cycle.mainLow := low
    cycle.mainHighBar := bar_index
    cycle.mainLowBar := bar_index
    cycle.mainHighTime := time
    cycle.mainLowTime := time
    cycle.s1High := s1_high
    cycle.s1Low := s1_low
    cycle.s1HighBar := bar_index
    cycle.s1LowBar := bar_index
    cycle.s1HighTime := time
    cycle.s1LowTime := time
    cycle.s2High := s2_high
    cycle.s2Low := s2_low
    cycle.s2HighBar := bar_index
    cycle.s2LowBar := bar_index
    cycle.s2HighTime := time
    cycle.s2LowTime := time
    cycle.active := true

updateCycle(cycle) =>
    if cycle.active
        if high > cycle.mainHigh
            cycle.mainHigh := high
            cycle.mainHighBar := bar_index
            cycle.mainHighTime := time
        if low < cycle.mainLow
            cycle.mainLow := low
            cycle.mainLowBar := bar_index
            cycle.mainLowTime := time
        
        if enableSymbol1 and not na(s1_high)
            if s1_high > cycle.s1High
                cycle.s1High := s1_high
                cycle.s1HighBar := bar_index
                cycle.s1HighTime := time
            if s1_low < cycle.s1Low
                cycle.s1Low := s1_low
                cycle.s1LowBar := bar_index
                cycle.s1LowTime := time
        
        if enableSymbol2 and not na(s2_high)
            if s2_high > cycle.s2High
                cycle.s2High := s2_high
                cycle.s2HighBar := bar_index
                cycle.s2HighTime := time
            if s2_low < cycle.s2Low
                cycle.s2Low := s2_low
                cycle.s2LowBar := bar_index
                cycle.s2LowTime := time

completeCycle(manager) =>
    savedCycle = CycleData.new(manager.current.startTime, manager.current.startBar, 
         manager.current.mainHigh, manager.current.mainLow, manager.current.mainHighBar, 
         manager.current.mainLowBar, manager.current.mainHighTime, manager.current.mainLowTime, 
         manager.current.s1High, manager.current.s1Low, manager.current.s1HighBar, 
         manager.current.s1LowBar, manager.current.s1HighTime, manager.current.s1LowTime, 
         manager.current.s2High, manager.current.s2Low, manager.current.s2HighBar, 
         manager.current.s2LowBar, manager.current.s2HighTime, manager.current.s2LowTime, true)
    array.push(manager.history, savedCycle)
    startNewCycle(manager.current)

shouldCompleteCycle(cycle, durationMs) =>
    cycle.active and not na(cycle.startTime) and (time - cycle.startTime >= durationMs)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

detectSMT(mainCurr, mainPrev, compCurr, compPrev, isBearish, isInverse) =>
    if na(mainCurr) or na(mainPrev) or na(compCurr) or na(compPrev)
        false
    else
        if isInverse
            isBearish ? (compCurr > compPrev and mainCurr < mainPrev) : (compCurr < compPrev and mainCurr > mainPrev)
        else
            isBearish ? (mainCurr > mainPrev and compCurr < compPrev) : (mainCurr < mainPrev and compCurr > compPrev)

getComparisonValues(cycle, prevCycle, config) =>
    mainCurr = config.isHigh ? cycle.mainHigh : cycle.mainLow
    mainPrev = config.isHigh ? prevCycle.mainHigh : prevCycle.mainLow
    compCurr = config.isSymbol1 ? (config.isHigh ? cycle.s1High : cycle.s1Low) : (config.isHigh ? cycle.s2High : cycle.s2Low)
    compPrev = config.isSymbol1 ? (config.isHigh ? prevCycle.s1High : prevCycle.s1Low) : (config.isHigh ? prevCycle.s2High : prevCycle.s2Low)
    [mainCurr, mainPrev, compCurr, compPrev]

shouldCheckSMTType(config) =>
    symbolEnabled = config.isSymbol1 ? enableSymbol1 : enableSymbol2
    inverseCheck = useInverseSMT or not config.isInverse
    symbolEnabled and inverseCheck

// Check if current trade is invalidated
isTradeInvalidated() =>
    if na(currentTrade) or strategy.position_size == 0
        false
    else
        config = array.get(smtConfigs, currentTrade.smtTypeId)
        currentMain = config.isHigh ? high : low
        currentComp = config.isSymbol1 ? (config.isHigh ? s1_high : s1_low) : (config.isHigh ? s2_high : s2_low)
        
        if na(currentComp) or na(currentMain)
            false
        else
            if config.isInverse
                if config.isBearish
                    currentComp < currentTrade.compPrice or currentMain > currentTrade.mainPrice
                else
                    currentComp > currentTrade.compPrice or currentMain < currentTrade.mainPrice
            else
                if config.isBearish
                    currentComp > currentTrade.compPrice
                else
                    currentComp < currentTrade.compPrice

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

processSMT(manager) =>
    cycle = manager.current
    history = manager.history
    
    bool bullishSignal = false
    bool bearishSignal = false
    int signalType = na
    float signalMainPrice = na
    float signalCompPrice = na
    
    if cycle.active and array.size(history) > 0
        for i = 0 to array.size(history) - 1
            prevCycle = array.get(history, i)
            
            for j = 0 to array.size(smtConfigs) - 1
                config = array.get(smtConfigs, j)
                
                if shouldCheckSMTType(config)
                    [mainCurr, mainPrev, compCurr, compPrev] = getComparisonValues(cycle, prevCycle, config)
                    
                    if detectSMT(mainCurr, mainPrev, compCurr, compPrev, config.isBearish, config.isInverse)
                        if config.isBearish and not bearishSignal
                            bearishSignal := true
                            signalType := config.typeId
                            signalMainPrice := mainCurr
                            signalCompPrice := compCurr
                        else if not config.isBearish and not bullishSignal
                            bullishSignal := true
                            signalType := config.typeId
                            signalMainPrice := mainCurr
                            signalCompPrice := compCurr
    
    [bullishSignal, bearishSignal, signalType, signalMainPrice, signalCompPrice]

cleanupOldCycles(history) =>
    if array.size(history) > 3
        for i = array.size(history) - 4 to 0
            array.remove(history, i)

// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

// Day change detection
currentDay = dayofmonth(time)
if currentDay != lastDay and not na(lastDay)
    for i = 0 to array.size(cycleManagers) - 1
        manager = array.get(cycleManagers, i)
        array.clear(manager.history)
        manager.current.active := false
    currentTrade := na
    pendingFVG := na
    limitOrderPlaced := false

lastDay := currentDay

// Check for invalidation
if exitOnInvalidation and isTradeInvalidated()
    if strategy.position_size > 0
        strategy.close("Long", comment="SMT Invalidated")
    else if strategy.position_size < 0
        strategy.close("Short", comment="SMT Invalidated")
    currentTrade := na

// Process cycles and detect SMT
var bool newBullishSMT = false
var bool newBearishSMT = false
var int detectedSMTType = na
var float detectedMainPrice = na
var float detectedCompPrice = na

if inSession()
    newBullishSMT := false
    newBearishSMT := false
    
    for i = 0 to array.size(cycleManagers) - 1
        manager = array.get(cycleManagers, i)
        
        if not manager.config.enabled
            continue
        
        if not manager.current.active
            startNewCycle(manager.current)
        
        cycleDuration = manager.config.durationMinutes * MS_PER_MINUTE
        if shouldCompleteCycle(manager.current, cycleDuration)
            completeCycle(manager)
        else
            updateCycle(manager.current)
        
        [bullish, bearish, smtType, mainPrice, compPrice] = processSMT(manager)
        
        if bullish and not newBullishSMT
            newBullishSMT := true
            detectedSMTType := smtType
            detectedMainPrice := mainPrice
            detectedCompPrice := compPrice
        
        if bearish and not newBearishSMT
            newBearishSMT := true
            detectedSMTType := smtType
            detectedMainPrice := mainPrice
            detectedCompPrice := compPrice
        
        cleanupOldCycles(manager.history)

// FVG Processing - Check for FVG after SMT detection
if not na(pendingFVG) and pendingFVG.waitingForFVG and not pendingFVG.fvgFound
    // Check if we've waited too long
    if bar_index - pendingFVG.smtBar > maxBarsForFVG
        if not na(pendingFVG.smtToFvgLine)
            line.delete(pendingFVG.smtToFvgLine)
        pendingFVG := na  // Cancel waiting
        limitOrderPlaced := false
    else
        // Check for FVG formation
        if pendingFVG.isBearish and isBearishFVG()
            fvgLevel = getBearishFVGLevel()
            if not na(fvgLevel)
                pendingFVG.fvgLevel := fvgLevel
                pendingFVG.fvgFound := true
                pendingFVG.fvgBar := bar_index
                
                // Draw line from SMT to FVG
                if not na(pendingFVG.smtToFvgLine)
                    line.set_x2(pendingFVG.smtToFvgLine, bar_index)
                    line.set_y2(pendingFVG.smtToFvgLine, fvgLevel)
                    line.set_color(pendingFVG.smtToFvgLine, color.red)
                
                if showLabels
                    label.new(bar_index, high, "FVG ENTRY\n" + str.tostring(fvgLevel, format.mintick), 
                         style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
                     
        else if not pendingFVG.isBearish and isBullishFVG()
            fvgLevel = getBullishFVGLevel()
            if not na(fvgLevel)
                pendingFVG.fvgLevel := fvgLevel
                pendingFVG.fvgFound := true
                pendingFVG.fvgBar := bar_index
                
                // Draw line from SMT to FVG
                if not na(pendingFVG.smtToFvgLine)
                    line.set_x2(pendingFVG.smtToFvgLine, bar_index)
                    line.set_y2(pendingFVG.smtToFvgLine, fvgLevel)
                    line.set_color(pendingFVG.smtToFvgLine, color.green)
                
                if showLabels
                    label.new(bar_index, low, "FVG ENTRY\n" + str.tostring(fvgLevel, format.mintick), 
                         style=label.style_label_up, color=color.orange, textcolor=color.white, size=size.small)

// Entry logic - Only on NEW SMT signals (not repeated on every bar)
longCondition = newBullishSMT and strategy.position_size == 0 and na(pendingFVG)
if onlyTradeNewSMT and not na(lastSMTBar)
    longCondition := longCondition and (bar_index - lastSMTBar) > 5

shortCondition = newBearishSMT and strategy.position_size == 0 and na(pendingFVG)
if onlyTradeNewSMT and not na(lastSMTBar)
    shortCondition := shortCondition and (bar_index - lastSMTBar) > 5

// Prevent re-entry while waiting for FVG or in position
if not na(pendingFVG) or strategy.position_size != 0
    longCondition := false
    shortCondition := false

// Handle opposite signals
if cancelFVGOnOpposite
    if newBearishSMT and not na(pendingFVG) and not pendingFVG.isBearish
        strategy.cancel_all()
        pendingFVG := na
        limitOrderPlaced := false
    if newBullishSMT and not na(pendingFVG) and pendingFVG.isBearish
        strategy.cancel_all()
        pendingFVG := na
        limitOrderPlaced := false

// Entry execution
if useFVGEntry
    // Start waiting for FVG after SMT
    if longCondition
        smtPrice = close
        // Create initial line (will be updated when FVG found)
        waitLine = showSMTToFVGLines ? line.new(bar_index, smtPrice, bar_index + 1, smtPrice, 
             color=color.new(color.green, 30), width=2, style=line.style_dashed) : na
        pendingFVG := FVGInfo.new(true, false, bar_index, na, false, na, smtPrice, waitLine)
        lastSMTBar := bar_index
        if showLabels
            label.new(bar_index, low, "LONG\nSMT\nWait FVG", style=label.style_label_up, 
                 color=color.green, textcolor=color.white, size=size.small)
    
    if shortCondition
        smtPrice = close
        // Create initial line (will be updated when FVG found)
        waitLine = showSMTToFVGLines ? line.new(bar_index, smtPrice, bar_index + 1, smtPrice, 
             color=color.new(color.red, 30), width=2, style=line.style_dashed) : na
        pendingFVG := FVGInfo.new(true, true, bar_index, na, false, na, smtPrice, waitLine)
        lastSMTBar := bar_index
        if showLabels
            label.new(bar_index, high, "SHORT\nSMT\nWait FVG", style=label.style_label_down, 
                 color=color.red, textcolor=color.white, size=size.small)
    
    // Place limit order when FVG found (only once)
    if not na(pendingFVG) and pendingFVG.fvgFound and strategy.position_size == 0 and not limitOrderPlaced
        if pendingFVG.isBearish
            strategy.entry("Short", strategy.short, limit=pendingFVG.fvgLevel)
            limitOrderPlaced := true
            currentTrade := TradeInfo.new(detectedSMTType, bar_index, pendingFVG.fvgLevel, detectedMainPrice, 
                 detectedCompPrice, true, useInverseSMT, true, true)
        else
            strategy.entry("Long", strategy.long, limit=pendingFVG.fvgLevel)
            limitOrderPlaced := true
            currentTrade := TradeInfo.new(detectedSMTType, bar_index, pendingFVG.fvgLevel, detectedMainPrice, 
                 detectedCompPrice, false, useInverseSMT, true, false)
    
    // Update waiting line if still waiting for FVG
    if not na(pendingFVG) and pendingFVG.waitingForFVG and not pendingFVG.fvgFound
        if not na(pendingFVG.smtToFvgLine)
            line.set_x2(pendingFVG.smtToFvgLine, bar_index)
    
    // Clear FVG once position is entered
    if strategy.position_size != 0 and not na(pendingFVG)
        if not na(pendingFVG.smtToFvgLine)
            line.delete(pendingFVG.smtToFvgLine)
        pendingFVG := na
        limitOrderPlaced := false
else
    // Direct entry without FVG (original logic)
    if longCondition
        strategy.entry("Long", strategy.long)
        currentTrade := TradeInfo.new(detectedSMTType, bar_index, close, detectedMainPrice, 
             detectedCompPrice, false, useInverseSMT, true, false)
        lastSMTBar := bar_index
        if showLabels
            label.new(bar_index, low, "LONG\nSMT", style=label.style_label_up, 
                 color=color.green, textcolor=color.white, size=size.small)

    if shortCondition
        strategy.entry("Short", strategy.short)
        currentTrade := TradeInfo.new(detectedSMTType, bar_index, close, detectedMainPrice, 
             detectedCompPrice, true, useInverseSMT, true, true)
        lastSMTBar := bar_index
        if showLabels
            label.new(bar_index, high, "SHORT\nSMT", style=label.style_label_down, 
                 color=color.red, textcolor=color.white, size=size.small)

// Exit management and entry line drawing
var line entryLine = na
var line stopLine = na
var line tpLine = na

if strategy.position_size > 0
    // Draw entry and exit lines for long position
    if showEntryLines
        if na(entryLine)
            entryLine := line.new(bar_index - 1, strategy.position_avg_price, bar_index + 20, strategy.position_avg_price, 
                 color=color.new(color.blue, 0), width=2, style=line.style_solid, extend=extend.right)
            if showLabels
                label.new(bar_index, strategy.position_avg_price, "ENTRY: " + str.tostring(strategy.position_avg_price, format.mintick), 
                     style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
        else
            line.set_x2(entryLine, bar_index + 20)
    
    stopLoss = strategy.position_avg_price * (1 - stopLossPercent / 100)
    takeProfit = strategy.position_avg_price * (1 + takeProfitPercent / 100)
    
    // Draw stop loss line
    if useStopLoss and showEntryLines
        if na(stopLine)
            stopLine := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, 
                 color=color.new(color.red, 30), width=1, style=line.style_dashed, extend=extend.right)
        else
            line.set_x1(stopLine, bar_index)
            line.set_x2(stopLine, bar_index + 20)
            line.set_y1(stopLine, stopLoss)
            line.set_y2(stopLine, stopLoss)
    
    // Draw take profit line
    if useTakeProfit and showEntryLines
        if na(tpLine)
            tpLine := line.new(bar_index, takeProfit, bar_index + 20, takeProfit, 
                 color=color.new(color.green, 30), width=1, style=line.style_dashed, extend=extend.right)
        else
            line.set_x1(tpLine, bar_index)
            line.set_x2(tpLine, bar_index + 20)
            line.set_y1(tpLine, takeProfit)
            line.set_y2(tpLine, takeProfit)
    
    if useStopLoss
        strategy.exit("Exit Long", "Long", stop=stopLoss, limit=useTakeProfit ? takeProfit : na)
    else if useTakeProfit
        strategy.exit("Exit Long", "Long", limit=takeProfit)

if strategy.position_size < 0
    // Draw entry and exit lines for short position
    if showEntryLines
        if na(entryLine)
            entryLine := line.new(bar_index - 1, strategy.position_avg_price, bar_index + 20, strategy.position_avg_price, 
                 color=color.new(color.blue, 0), width=2, style=line.style_solid, extend=extend.right)
            if showLabels
                label.new(bar_index, strategy.position_avg_price, "ENTRY: " + str.tostring(strategy.position_avg_price, format.mintick), 
                     style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
        else
            line.set_x2(entryLine, bar_index + 20)
    
    stopLoss = strategy.position_avg_price * (1 + stopLossPercent / 100)
    takeProfit = strategy.position_avg_price * (1 - takeProfitPercent / 100)
    
    // Draw stop loss line
    if useStopLoss and showEntryLines
        if na(stopLine)
            stopLine := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, 
                 color=color.new(color.red, 30), width=1, style=line.style_dashed, extend=extend.right)
        else
            line.set_x1(stopLine, bar_index)
            line.set_x2(stopLine, bar_index + 20)
            line.set_y1(stopLine, stopLoss)
            line.set_y2(stopLine, stopLoss)
    
    // Draw take profit line
    if useTakeProfit and showEntryLines
        if na(tpLine)
            tpLine := line.new(bar_index, takeProfit, bar_index + 20, takeProfit, 
                 color=color.new(color.green, 30), width=1, style=line.style_dashed, extend=extend.right)
        else
            line.set_x1(tpLine, bar_index)
            line.set_x2(tpLine, bar_index + 20)
            line.set_y1(tpLine, takeProfit)
            line.set_y2(tpLine, takeProfit)
    
    if useStopLoss
        strategy.exit("Exit Short", "Short", stop=stopLoss, limit=useTakeProfit ? takeProfit : na)
    else if useTakeProfit
        strategy.exit("Exit Short", "Short", limit=takeProfit)

// Clear lines when position is closed
if strategy.position_size == 0
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(stopLine)
        line.delete(stopLine)
        stopLine := na
    if not na(tpLine)
        line.delete(tpLine)
        tpLine := na
    // Reset flag so new trades can be taken
    limitOrderPlaced := false

// Visualization
// SMT signal shapes removed - use entry labels instead

// Draw FVG boxes
var box currentFVGBox = na
if showFVGBoxes and not na(pendingFVG) and pendingFVG.fvgFound
    if na(currentFVGBox)
        if pendingFVG.isBearish
            // Bearish FVG box (gap between low[2] and high[0])
            currentFVGBox := box.new(pendingFVG.fvgBar - 2, low[2], bar_index + 10, high[0], 
                 border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 90), 
                 border_width=1, extend=extend.right)
        else
            // Bullish FVG box (gap between high[2] and low[0])
            currentFVGBox := box.new(pendingFVG.fvgBar - 2, high[2], bar_index + 10, low[0], 
                 border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 90), 
                 border_width=1, extend=extend.right)
    else
        box.set_right(currentFVGBox, bar_index + 10)

// Clear FVG box when position entered or FVG cancelled
if (strategy.position_size != 0 or na(pendingFVG) or not showFVGBoxes) and not na(currentFVGBox)
    box.delete(currentFVGBox)
    currentFVGBox := na

// Stats table
var table statsTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), 
     frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(statsTable, 0, 0, "Position", text_color=color.white)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(statsTable, 1, 0, posText, text_color=posColor)
    
    table.cell(statsTable, 0, 1, "Net P/L", text_color=color.white)
    table.cell(statsTable, 1, 1, str.tostring(strategy.netprofit, "#.##"), 
         text_color=strategy.netprofit > 0 ? color.green : color.red)
    
    table.cell(statsTable, 0, 2, "Win Rate", text_color=color.white)
    winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
    table.cell(statsTable, 1, 2, str.tostring(winRate, "#.##") + "%", text_color=color.white)
    
    table.cell(statsTable, 0, 3, "Trades", text_color=color.white)
    table.cell(statsTable, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white)
    
    table.cell(statsTable, 0, 4, "Session", text_color=color.white)
    sessionStatus = inSession() ? "ACTIVE" : "CLOSED"
    table.cell(statsTable, 1, 4, sessionStatus, text_color=inSession() ? color.green : color.orange)

// Note: For alerts, use TradingView's "Create Alert" button with "strategy.order.filled" condition
// This allows alerts when Long or Short orders are executed
