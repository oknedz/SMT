//@version=6
indicator("SMT V-2.0", "SMT Detector [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Comparison Symbols
enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("ES1!", "", confirm=false, group="Comparison Symbols", inline="sym2")

// Cycle Settings
enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes")

// Session Filter
enableSession = input.bool(true, "Enable Session Filter", group="Session Filter")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter")

// Display Settings
maxTotalLines = input.int(4, "Max Total SMT Lines", minval=1, maxval=20, group="Display")

// ═══════════════════════════════════════════════════════════════════════════════
//                              CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// SMT Type IDs
const int SMT_S1_BEARISH = 0
const int SMT_S1_BULLISH = 1
const int SMT_S2_BEARISH = 2
const int SMT_S2_BULLISH = 3
const int SMT_S1_INV_BEARISH = 4
const int SMT_S1_INV_BULLISH = 5
const int SMT_S2_INV_BEARISH = 6
const int SMT_S2_INV_BULLISH = 7

const int MS_PER_MINUTE = 60000

// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Cycle data tracking
type CycleData
    int startTime
    int startBar
    float mainHigh
    float mainLow
    int mainHighBar
    int mainLowBar
    int mainHighTime
    int mainLowTime
    float s1High
    float s1Low
    int s1HighBar
    int s1LowBar
    int s1HighTime
    int s1LowTime
    float s2High
    float s2Low
    int s2HighBar
    int s2LowBar
    int s2HighTime
    int s2LowTime
    bool active

// Cycle configuration
type CycleConfig
    int durationMinutes
    string label
    bool enabled

// Cycle manager - combines config, current cycle, and history
type CycleManager
    CycleConfig config
    CycleData current
    array<CycleData> history

// SMT type configuration
type SMTConfig
    int typeId
    bool isSymbol1
    bool isHigh
    bool isBearish
    bool isInverse

// Line metadata for tracking drawn SMT lines
type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    float length
    int smtTypeId
    float mainPrice
    float compPrice

// Cached symbol data
type SymbolData
    float high
    float low
    bool enabled
    string abbr

// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE
// ═══════════════════════════════════════════════════════════════════════════════

// Security data
// Using empty string "" for timeframe to get comparison symbol's native timeframe
// This ensures proper data alignment for different market sessions (crypto vs indices)
[s1_high, s1_low, s1_close] = request.security(symbol1, "", [high, low, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, "", [high, low, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)

// Cycle managers array
var array<CycleManager> cycleManagers = array.new<CycleManager>()

// SMT configurations (initialized once)
var array<SMTConfig> smtConfigs = array.new<SMTConfig>()

// Global line tracking
var array<LineMetadata> globalLineHistory = array.new<LineMetadata>()

// Cached symbol data
var SymbolData symbolData1 = na
var SymbolData symbolData2 = na

// Day tracking
var int lastDay = na

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getSymbolAbbr(sym) =>
    parts = str.split(sym, ":")
    symbolPart = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    cleanSymbol = str.replace_all(str.replace_all(symbolPart, "1!", ""), "USDT", "")
    str.substring(cleanSymbol, 0, math.min(str.length(cleanSymbol), 6))

inSession() => 
    not enableSession or not na(time(timeframe.period, sessionStart, sessionTimezone))

calcLineLength(bar1, price1, bar2, price2) =>
    barDiff = math.abs(bar2 - bar1)
    priceDiff = math.abs(price2 - price1)
    math.sqrt(barDiff * barDiff + priceDiff * priceDiff)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initializeSMTConfigs() =>
    configs = array.new<SMTConfig>()
    array.push(configs, SMTConfig.new(SMT_S1_BEARISH, true, true, true, false))
    array.push(configs, SMTConfig.new(SMT_S1_BULLISH, true, false, false, false))
    array.push(configs, SMTConfig.new(SMT_S2_BEARISH, false, true, true, false))
    array.push(configs, SMTConfig.new(SMT_S2_BULLISH, false, false, false, false))
    array.push(configs, SMTConfig.new(SMT_S1_INV_BEARISH, true, true, true, true))
    array.push(configs, SMTConfig.new(SMT_S1_INV_BULLISH, true, false, false, true))
    array.push(configs, SMTConfig.new(SMT_S2_INV_BEARISH, false, true, true, true))
    array.push(configs, SMTConfig.new(SMT_S2_INV_BULLISH, false, false, false, true))
    configs

initializeCycleManagers() =>
    managers = array.new<CycleManager>()
    
    // 90-minute cycle
    config90 = CycleConfig.new(90, "90", enable90min)
    cycle90 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config90, cycle90, array.new<CycleData>()))
    
    // 30-minute cycle
    config30 = CycleConfig.new(30, "30", enable30min)
    cycle30 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config30, cycle30, array.new<CycleData>()))
    
    // 10-minute cycle
    config10 = CycleConfig.new(10, "10", enable10min)
    cycle10 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config10, cycle10, array.new<CycleData>()))
    
    // 3-minute cycle
    config3 = CycleConfig.new(3, "3", enable3min)
    cycle3 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
    array.push(managers, CycleManager.new(config3, cycle3, array.new<CycleData>()))
    
    managers

// Initialize once
if barstate.isfirst
    smtConfigs := initializeSMTConfigs()
    cycleManagers := initializeCycleManagers()

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

startNewCycle(cycle) =>
    cycle.startTime := time
    cycle.startBar := bar_index
    cycle.mainHigh := high
    cycle.mainLow := low
    cycle.mainHighBar := bar_index
    cycle.mainLowBar := bar_index
    cycle.mainHighTime := time
    cycle.mainLowTime := time
    cycle.s1High := s1_high
    cycle.s1Low := s1_low
    cycle.s1HighBar := bar_index
    cycle.s1LowBar := bar_index
    cycle.s1HighTime := time
    cycle.s1LowTime := time
    cycle.s2High := s2_high
    cycle.s2Low := s2_low
    cycle.s2HighBar := bar_index
    cycle.s2LowBar := bar_index
    cycle.s2HighTime := time
    cycle.s2LowTime := time
    cycle.active := true

updateCycle(cycle) =>
    if cycle.active
        if high > cycle.mainHigh
            cycle.mainHigh := high
            cycle.mainHighBar := bar_index
            cycle.mainHighTime := time
        if low < cycle.mainLow
            cycle.mainLow := low
            cycle.mainLowBar := bar_index
            cycle.mainLowTime := time
        
        if enableSymbol1 and not na(s1_high)
            if s1_high > cycle.s1High
                cycle.s1High := s1_high
                cycle.s1HighBar := bar_index
                cycle.s1HighTime := time
            if s1_low < cycle.s1Low
                cycle.s1Low := s1_low
                cycle.s1LowBar := bar_index
                cycle.s1LowTime := time
        
        if enableSymbol2 and not na(s2_high)
            if s2_high > cycle.s2High
                cycle.s2High := s2_high
                cycle.s2HighBar := bar_index
                cycle.s2HighTime := time
            if s2_low < cycle.s2Low
                cycle.s2Low := s2_low
                cycle.s2LowBar := bar_index
                cycle.s2LowTime := time

completeCycle(manager) =>
    savedCycle = CycleData.new(manager.current.startTime, manager.current.startBar, manager.current.mainHigh, manager.current.mainLow, manager.current.mainHighBar, manager.current.mainLowBar, manager.current.mainHighTime, manager.current.mainLowTime, manager.current.s1High, manager.current.s1Low, manager.current.s1HighBar, manager.current.s1LowBar, manager.current.s1HighTime, manager.current.s1LowTime, manager.current.s2High, manager.current.s2Low, manager.current.s2HighBar, manager.current.s2LowBar, manager.current.s2HighTime, manager.current.s2LowTime, true)
    array.push(manager.history, savedCycle)
    startNewCycle(manager.current)

shouldCompleteCycle(cycle, durationMs) =>
    if not cycle.active or na(cycle.startTime)
        false
    else
        // Calculate elapsed time only counting bars (works for both 24/7 and gapped markets)
        elapsedBars = bar_index - cycle.startBar
        
        // Calculate how many bars we expect in the duration based on current timeframe
        timeframeSeconds = timeframe.in_seconds(timeframe.period)
        durationSeconds = durationMs / 1000
        expectedBars = math.floor(durationSeconds / timeframeSeconds)
        
        // Complete cycle if we've had enough bars OR enough wallclock time has passed
        // This ensures it works for both continuous markets (crypto) and gapped markets (indices)
        elapsedBars >= expectedBars or (time - cycle.startTime >= durationMs)

requiresSpecialTimeframe(manager) =>
    manager.config.durationMinutes == 3

meetsSpecialTimeframeRequirement() =>
    timeframe.in_seconds(timeframe.period) <= 60

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

detectSMT(mainCurr, mainPrev, compCurr, compPrev, isBearish, isInverse) =>
    if na(mainCurr) or na(mainPrev) or na(compCurr) or na(compPrev)
        false
    else
        if isInverse
            isBearish ? (compCurr > compPrev and mainCurr < mainPrev) : (compCurr < compPrev and mainCurr > mainPrev)
        else
            isBearish ? (mainCurr > mainPrev and compCurr < compPrev) : (mainCurr < mainPrev and compCurr > compPrev)

getComparisonValues(cycle, prevCycle, config) =>
    mainCurr = config.isHigh ? cycle.mainHigh : cycle.mainLow
    mainPrev = config.isHigh ? prevCycle.mainHigh : prevCycle.mainLow
    compCurr = config.isSymbol1 ? (config.isHigh ? cycle.s1High : cycle.s1Low) : (config.isHigh ? cycle.s2High : cycle.s2Low)
    compPrev = config.isSymbol1 ? (config.isHigh ? prevCycle.s1High : prevCycle.s1Low) : (config.isHigh ? prevCycle.s2High : prevCycle.s2Low)
    [mainCurr, mainPrev, compCurr, compPrev]

shouldCheckSMTType(config) =>
    config.isSymbol1 ? enableSymbol1 : enableSymbol2

// Check if SMT is invalidated by new price movement
isSmtInvalidated(metadata, config, currentMain) =>
    if config.isSymbol1 and not enableSymbol1
        false
    else if not config.isSymbol1 and not enableSymbol2
        false
    else
        // Get current comparison symbol values
        currentComp = config.isSymbol1 ? (config.isHigh ? s1_high : s1_low) : (config.isHigh ? s2_high : s2_low)
        
        if na(currentComp) or na(currentMain)
            false
        else
            // Check if divergence is broken
            if config.isInverse
                // Inverse SMT: Main was opposite to Comp
                if config.isBearish
                    // Original: Comp made HH, Main made LH
                    // Invalidated if: Comp makes LH OR Main makes HH (both moving same direction)
                    currentComp < metadata.compPrice or currentMain > metadata.mainPrice
                else
                    // Original: Comp made LL, Main made HL
                    // Invalidated if: Comp makes HL OR Main makes LL (both moving same direction)
                    currentComp > metadata.compPrice or currentMain < metadata.mainPrice
            else
                // Normal SMT: Main and Comp diverged
                if config.isBearish
                    // Original: Main made HH, Comp made LH (divergence)
                    // Invalidated if: Comp also makes HH (no more divergence)
                    currentComp > metadata.compPrice
                else
                    // Original: Main made LL, Comp made HL (divergence)
                    // Invalidated if: Comp also makes LL (no more divergence)
                    currentComp < metadata.compPrice

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

checkAllSMTTypes(cycle, prevCycle, results) =>
    foundAny = false
    
    for i = 0 to array.size(smtConfigs) - 1
        config = array.get(smtConfigs, i)
        
        if shouldCheckSMTType(config) and na(array.get(results, i))
            [mainCurr, mainPrev, compCurr, compPrev] = getComparisonValues(cycle, prevCycle, config)
            
            if detectSMT(mainCurr, mainPrev, compCurr, compPrev, config.isBearish, config.isInverse)
                array.set(results, i, prevCycle)
                foundAny := true
    
    foundAny

drawSMT(mainBar, mainTime, mainPrice, compBar, compTime, compPrice, labelText, isBearish, smtTypeId, currentCompPrice) =>
    if na(mainBar) or na(compBar) or na(mainTime) or na(compTime)
        [na, na, false]
    else
        newLength = calcLineLength(mainBar, mainPrice, compBar, compPrice)
        
        // Check for existing line in same direction
        int indexToRemove = -1
        bool shouldAdd = true
        
        if array.size(globalLineHistory) > 0
            for i = 0 to array.size(globalLineHistory) - 1
                metadata = array.get(globalLineHistory, i)
                if metadata.isBearish == isBearish
                    if metadata.length < newLength
                        indexToRemove := i
                    else
                        shouldAdd := false
        
        line newLine = na
        label newLabel = na
        bool isNewSMT = false
        
        if shouldAdd
            // Remove shorter line
            if indexToRemove >= 0
                oldMetadata = array.remove(globalLineHistory, indexToRemove)
                line.delete(oldMetadata.lineObj)
                label.delete(oldMetadata.labelObj)
            
            // Create new line and label using time-based coordinates
            newLine := line.new(mainTime, mainPrice, compTime, compPrice, xloc=xloc.bar_time, color=color.black, width=1, style=line.style_solid)
            
            labelTime = mainTime > compTime ? mainTime : compTime
            labelPrice = mainTime > compTime ? mainPrice : compPrice
            textYloc = isBearish ? yloc.abovebar : yloc.belowbar
            
            newLabel := label.new(labelTime, labelPrice, labelText, xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small, yloc=textYloc)
            
            // Add to history with tracking info
            metadata = LineMetadata.new(newLine, newLabel, isBearish, newLength, smtTypeId, mainPrice, currentCompPrice)
            array.push(globalLineHistory, metadata)
            
            // Remove oldest if exceeds limit
            while array.size(globalLineHistory) > maxTotalLines
                oldMetadata = array.shift(globalLineHistory)
                line.delete(oldMetadata.lineObj)
                label.delete(oldMetadata.labelObj)
            
            isNewSMT := true
        
        [newLine, newLabel, isNewSMT]

drawSMTResults(cycle, results, cycleLabel) =>
    bool anyNewSMT = false
    
    for i = 0 to array.size(results) - 1
        smtCycle = array.get(results, i)
        
        if not na(smtCycle)
            config = array.get(smtConfigs, i)
            
            mainBar = config.isHigh ? smtCycle.mainHighBar : smtCycle.mainLowBar
            mainTime = config.isHigh ? smtCycle.mainHighTime : smtCycle.mainLowTime
            mainPrice = config.isHigh ? smtCycle.mainHigh : smtCycle.mainLow
            currBar = config.isHigh ? cycle.mainHighBar : cycle.mainLowBar
            currTime = config.isHigh ? cycle.mainHighTime : cycle.mainLowTime
            currPrice = config.isHigh ? cycle.mainHigh : cycle.mainLow
            
            symbolAbbr = config.isSymbol1 ? symbolData1.abbr : symbolData2.abbr
            labelText = "SMT-" + symbolAbbr + " " + cycleLabel
            
            // Get current comparison price for tracking
            currentCompPrice = config.isSymbol1 ? (config.isHigh ? cycle.s1High : cycle.s1Low) : (config.isHigh ? cycle.s2High : cycle.s2Low)
            
            [newLine, newLabel, isNewSMT] = drawSMT(mainBar, mainTime, mainPrice, currBar, currTime, currPrice, labelText, config.isBearish, config.typeId, currentCompPrice)
            
            if isNewSMT
                anyNewSMT := true
    
    anyNewSMT

checkAndRemoveInvalidatedSMTs() =>
    if array.size(globalLineHistory) > 0
        linesToRemove = array.new<int>()
        
        for i = 0 to array.size(globalLineHistory) - 1
            metadata = array.get(globalLineHistory, i)
            config = array.get(smtConfigs, metadata.smtTypeId)
            
            // Get current main symbol price
            currentMain = config.isHigh ? high : low
            
            if isSmtInvalidated(metadata, config, currentMain)
                array.push(linesToRemove, i)
        
        // Remove invalidated lines from end to start to maintain indices
        if array.size(linesToRemove) > 0
            for i = array.size(linesToRemove) - 1 to 0
                idx = array.get(linesToRemove, i)
                oldMetadata = array.remove(globalLineHistory, idx)
                line.delete(oldMetadata.lineObj)
                label.delete(oldMetadata.labelObj)

cleanupOldCycles(history) =>
    if array.size(history) > 3
        cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(history) - 4
            array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(history, array.get(cyclesToRemove, i))

processSMT(manager) =>
    cycle = manager.current
    history = manager.history
    
    if not cycle.active or array.size(history) == 0
        na
    else
        results = array.new<CycleData>(8, na)
        
        // Check each previous cycle for SMT
        for i = 0 to array.size(history) - 1
            prevCycle = array.get(history, i)
            checkAllSMTTypes(cycle, prevCycle, results)
        
        // Draw detected SMTs
        drawSMTResults(cycle, results, manager.config.label)
        
        // Cleanup old cycles
        cleanupOldCycles(history)

// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

// Update cached symbol data
if barstate.isnew
    symbolData1 := SymbolData.new(s1_high, s1_low, enableSymbol1, getSymbolAbbr(symbol1))
    symbolData2 := SymbolData.new(s2_high, s2_low, enableSymbol2, getSymbolAbbr(symbol2))

// Day change detection and cleanup
currentDay = dayofmonth(time)
if currentDay != lastDay and not na(lastDay)
    // Clear all history
    for i = 0 to array.size(cycleManagers) - 1
        manager = array.get(cycleManagers, i)
        array.clear(manager.history)
        manager.current.active := false
    
    // Clear all drawings
    while array.size(globalLineHistory) > 0
        metadata = array.shift(globalLineHistory)
        line.delete(metadata.lineObj)
        label.delete(metadata.labelObj)

lastDay := currentDay

// Check and remove invalidated SMT lines on every bar
checkAndRemoveInvalidatedSMTs()

// Process all cycles
if inSession()
    for i = 0 to array.size(cycleManagers) - 1
        manager = array.get(cycleManagers, i)
        
        if not manager.config.enabled
            continue
        
        // Check special timeframe requirement for 3-min cycle
        if requiresSpecialTimeframe(manager) and not meetsSpecialTimeframeRequirement()
            continue
        
        // Start new cycle if needed
        if not manager.current.active
            startNewCycle(manager.current)
        
        // Check if cycle should complete
        cycleDuration = manager.config.durationMinutes * MS_PER_MINUTE
        if shouldCompleteCycle(manager.current, cycleDuration)
            completeCycle(manager)
        else
            updateCycle(manager.current)
        
        // Process SMT detection
        processSMT(manager)
