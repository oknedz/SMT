//@version=6
indicator("SMT V-3.0", "SMT Detector [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS & CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("ES1!", "", confirm=false, group="Comparison Symbols", inline="sym2")

pivotLeft = input.int(5, "Pivot Left Bars", minval=1, maxval=20, group="Pivot Settings")
pivotRight = input.int(5, "Pivot Right Bars", minval=1, maxval=20, group="Pivot Settings")

enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes")

enableSession = input.bool(true, "Enable Session Filter", group="Session Filter")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter")

maxTotalLines = input.int(4, "Max Total SMT Lines", minval=1, maxval=20, group="Display")

// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type PivotPoint
    float price
    int barIndex
    int time
    bool confirmed

type CycleData
    int startTime
    int startBar
    PivotPoint mainPivotHigh
    PivotPoint mainPivotLow
    PivotPoint s1PivotHigh
    PivotPoint s1PivotLow
    PivotPoint s2PivotHigh
    PivotPoint s2PivotLow
    bool active

type CycleManager
    int duration
    string label
    bool enabled
    CycleData current
    array<CycleData> history

type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    float length
    int smtTypeId
    float mainPrice
    float compPrice
    string symbols
    int cycleBar
    string cycleLabel

// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE
// ═══════════════════════════════════════════════════════════════════════════════

[s1_high, s1_low, s1_close] = request.security(symbol1, "", [high, low, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, "", [high, low, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)

var array<CycleManager> managers = array.new<CycleManager>()
var array<LineMetadata> lines = array.new<LineMetadata>()
var int lastDay = na
var string s1Abbr = ""
var string s2Abbr = ""

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getAbbr(sym) =>
    parts = str.split(sym, ":")
    ticker = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    
    // Remove common suffixes
    clean = str.replace_all(str.replace_all(str.replace_all(ticker, "USDT", ""), ".P", ""), "USD", "")
    
    // Check if it ends with 1! (futures like ES1!, NQ1!)
    if str.contains(clean, "1!")
        clean := str.replace_all(clean, "1!", "")
        // For indices ending in 1!, take first 2-3 chars (ES, NQ, YM, etc)
        str.substring(clean, 0, math.min(str.length(clean), 2))
    else
        // For other symbols (MESZ2024, BTCUSDT, etc), take first 4 chars
        str.substring(clean, 0, math.min(str.length(clean), 4))

inSession() => 
    not enableSession or not na(time(timeframe.period, sessionStart, sessionTimezone))

calcLen(bar1, price1, bar2, price2) =>
    barDiff = math.abs(bar2 - bar1)
    priceDiff = math.abs(price2 - price1)
    math.sqrt(barDiff * barDiff + priceDiff * priceDiff)

createPivot(float price, int barIdx, int t) =>
    PivotPoint.new(price, barIdx, t, false)

// ═══════════════════════════════════════════════════════════════════════════════
//                              PIVOT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

detectPivotHigh(src, left, right, offset) =>
    if bar_index < left + right + offset
        [na, na, na]
    else
        pivotBar = bar_index - right - offset
        pivotPrice = src[right + offset]
        isPivot = true
        
        // Check left side
        for i = 1 to left
            if src[right + offset + i] > pivotPrice
                isPivot := false
                break
        
        // Check right side
        if isPivot
            for i = 0 to right - 1
                if src[i + offset] > pivotPrice
                    isPivot := false
                    break
        
        [isPivot ? pivotPrice : na, isPivot ? pivotBar : na, isPivot ? time[right + offset] : na]

detectPivotLow(src, left, right, offset) =>
    if bar_index < left + right + offset
        [na, na, na]
    else
        pivotBar = bar_index - right - offset
        pivotPrice = src[right + offset]
        isPivot = true
        
        // Check left side
        for i = 1 to left
            if src[right + offset + i] < pivotPrice
                isPivot := false
                break
        
        // Check right side
        if isPivot
            for i = 0 to right - 1
                if src[i + offset] < pivotPrice
                    isPivot := false
                    break
        
        [isPivot ? pivotPrice : na, isPivot ? pivotBar : na, isPivot ? time[right + offset] : na]

// ═══════════════════════════════════════════════════════════════════════════════
//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initCycleData() =>
    CycleData.new(na, na, createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), false)

if barstate.isfirst
    array.push(managers, CycleManager.new(90, "90", enable90min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(30, "30", enable30min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(10, "10", enable10min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(3, "3", enable3min, initCycleData(), array.new<CycleData>()))
    s1Abbr := getAbbr(symbol1)
    s2Abbr := getAbbr(symbol2)

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

startCycle(c) =>
    c.startTime := time
    c.startBar := bar_index
    c.mainPivotHigh := createPivot(na, na, na)
    c.mainPivotLow := createPivot(na, na, na)
    c.s1PivotHigh := createPivot(na, na, na)
    c.s1PivotLow := createPivot(na, na, na)
    c.s2PivotHigh := createPivot(na, na, na)
    c.s2PivotLow := createPivot(na, na, na)
    c.active := true

// Detect all pivots on every bar (called outside conditional blocks for consistency)
[gPhMain, gPhBarMain, gPhTimeMain] = detectPivotHigh(high, pivotLeft, pivotRight, 0)
[gPlMain, gPlBarMain, gPlTimeMain] = detectPivotLow(low, pivotLeft, pivotRight, 0)
[gPhS1, gPhBarS1, gPhTimeS1] = detectPivotHigh(s1_high, pivotLeft, pivotRight, 0)
[gPlS1, gPlBarS1, gPlTimeS1] = detectPivotLow(s1_low, pivotLeft, pivotRight, 0)
[gPhS2, gPhBarS2, gPhTimeS2] = detectPivotHigh(s2_high, pivotLeft, pivotRight, 0)
[gPlS2, gPlBarS2, gPlTimeS2] = detectPivotLow(s2_low, pivotLeft, pivotRight, 0)

updateCyclePivots(c) =>
    if c.active
        // Update main symbol pivots
        if not na(gPhMain) and gPhBarMain >= c.startBar
            if na(c.mainPivotHigh.price) or gPhMain > c.mainPivotHigh.price
                c.mainPivotHigh.price := gPhMain
                c.mainPivotHigh.barIndex := gPhBarMain
                c.mainPivotHigh.time := gPhTimeMain
                c.mainPivotHigh.confirmed := true
        
        if not na(gPlMain) and gPlBarMain >= c.startBar
            if na(c.mainPivotLow.price) or gPlMain < c.mainPivotLow.price
                c.mainPivotLow.price := gPlMain
                c.mainPivotLow.barIndex := gPlBarMain
                c.mainPivotLow.time := gPlTimeMain
                c.mainPivotLow.confirmed := true
        
        // Update Symbol 1 pivots
        if enableSymbol1
            if not na(gPhS1) and gPhBarS1 >= c.startBar
                if na(c.s1PivotHigh.price) or gPhS1 > c.s1PivotHigh.price
                    c.s1PivotHigh.price := gPhS1
                    c.s1PivotHigh.barIndex := gPhBarS1
                    c.s1PivotHigh.time := gPhTimeS1
                    c.s1PivotHigh.confirmed := true
            
            if not na(gPlS1) and gPlBarS1 >= c.startBar
                if na(c.s1PivotLow.price) or gPlS1 < c.s1PivotLow.price
                    c.s1PivotLow.price := gPlS1
                    c.s1PivotLow.barIndex := gPlBarS1
                    c.s1PivotLow.time := gPlTimeS1
                    c.s1PivotLow.confirmed := true
        
        // Update Symbol 2 pivots
        if enableSymbol2
            if not na(gPhS2) and gPhBarS2 >= c.startBar
                if na(c.s2PivotHigh.price) or gPhS2 > c.s2PivotHigh.price
                    c.s2PivotHigh.price := gPhS2
                    c.s2PivotHigh.barIndex := gPhBarS2
                    c.s2PivotHigh.time := gPhTimeS2
                    c.s2PivotHigh.confirmed := true
            
            if not na(gPlS2) and gPlBarS2 >= c.startBar
                if na(c.s2PivotLow.price) or gPlS2 < c.s2PivotLow.price
                    c.s2PivotLow.price := gPlS2
                    c.s2PivotLow.barIndex := gPlBarS2
                    c.s2PivotLow.time := gPlTimeS2
                    c.s2PivotLow.confirmed := true

completeCycle(m) =>
    savedCycle = CycleData.new(m.current.startTime, m.current.startBar, m.current.mainPivotHigh, m.current.mainPivotLow, m.current.s1PivotHigh, m.current.s1PivotLow, m.current.s2PivotHigh, m.current.s2PivotLow, true)
    array.push(m.history, savedCycle)
    startCycle(m.current)

shouldComplete(c, durMin) =>
    if not c.active or na(c.startTime)
        false
    else
        elapsedBars = bar_index - c.startBar
        expectedBars = math.floor((durMin * 60000 / 1000) / timeframe.in_seconds(timeframe.period))
        elapsedBars >= expectedBars or (time - c.startTime >= durMin * 60000)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION & DRAWING
// ═══════════════════════════════════════════════════════════════════════════════

detectSMT(mCurr, mPrev, cCurr, cPrev, isBearish, isInverse) =>
    if na(mCurr) or na(mPrev) or na(cCurr) or na(cPrev)
        false
    else
        if isInverse
            isBearish ? (cCurr > cPrev and mCurr < mPrev) : (cCurr < cPrev and mCurr > mPrev)
        else
            isBearish ? (mCurr > mPrev and cCurr < cPrev) : (mCurr < mPrev and cCurr > cPrev)

isInvalidated(meta, isS1, isHigh, bearish, inverse, currMain, currComp) =>
    if na(currComp) or na(currMain)
        false
    else
        if inverse
            bearish ? (currComp < meta.compPrice or currMain > meta.mainPrice) : (currComp > meta.compPrice or currMain < meta.mainPrice)
        else
            bearish ? currComp > meta.compPrice : currComp < meta.compPrice

drawSMT(bar1, time1, price1, bar2, time2, price2, symbolStr, cycleLabel, bearish, typeId, compPrice) =>
    if na(bar1) or na(bar2) or na(time1) or na(time2)
        false
    else
        newLen = calcLen(bar1, price1, bar2, price2)
        idxRemove = -1
        shouldAdd = true
        mergeIdx = -1
        
        if array.size(lines) > 0
            for i = 0 to array.size(lines) - 1
                m = array.get(lines, i)
                // Check if this is same cycle, same direction, and similar location (within 3 bars)
                if m.isBearish == bearish and m.cycleLabel == cycleLabel and math.abs(m.cycleBar - bar2) <= 3
                    // Merge symbols instead of replacing
                    mergeIdx := i
                    shouldAdd := false
                    break
                else if m.isBearish == bearish
                    if m.length < newLen
                        idxRemove := i
                    else
                        shouldAdd := false
        
        isNew = false
        if mergeIdx >= 0
            // Merge with existing SMT
            existing = array.get(lines, mergeIdx)
            if str.contains(existing.symbols, symbolStr) == false
                newSymbols = existing.symbols + " + " + symbolStr
                label.set_text(existing.labelObj, "SMT-" + newSymbols + " " + cycleLabel)
                existing.symbols := newSymbols
            isNew := false
        else if shouldAdd
            if idxRemove >= 0
                old = array.remove(lines, idxRemove)
                line.delete(old.lineObj)
                label.delete(old.labelObj)
            
            l = line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=color.black, width=1, style=line.style_solid)
            labTime = time1 > time2 ? time1 : time2
            labPrice = time1 > time2 ? price1 : price2
            txt = "SMT-" + symbolStr + " " + cycleLabel
            lab = label.new(labTime, labPrice, txt, xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small, yloc=bearish ? yloc.abovebar : yloc.belowbar)
            
            array.push(lines, LineMetadata.new(l, lab, bearish, newLen, typeId, price1, compPrice, symbolStr, bar2, cycleLabel))
            
            while array.size(lines) > maxTotalLines
                old = array.shift(lines)
                line.delete(old.lineObj)
                label.delete(old.labelObj)
            
            isNew := true
        isNew

checkInvalidation() =>
    if array.size(lines) > 0
        toRemove = array.new<int>()
        for i = 0 to array.size(lines) - 1
            m = array.get(lines, i)
            isS1 = m.smtTypeId == 0 or m.smtTypeId == 1 or m.smtTypeId == 4 or m.smtTypeId == 5
            isHigh = m.smtTypeId == 0 or m.smtTypeId == 2 or m.smtTypeId == 4 or m.smtTypeId == 6
            inverse = m.smtTypeId >= 4
            enabled = isS1 ? enableSymbol1 : enableSymbol2
            
            if enabled
                // Use global pivot values that are already calculated
                currMain = isHigh ? gPhMain : gPlMain
                currComp = isS1 ? (isHigh ? gPhS1 : gPlS1) : (isHigh ? gPhS2 : gPlS2)
                
                if not na(currMain) and not na(currComp)
                    if isInvalidated(m, isS1, isHigh, m.isBearish, inverse, currMain, currComp)
                        array.push(toRemove, i)
        
        if array.size(toRemove) > 0
            for i = array.size(toRemove) - 1 to 0
                old = array.remove(lines, array.get(toRemove, i))
                line.delete(old.lineObj)
                label.delete(old.labelObj)

processSMT(m) =>
    if not m.current.active or array.size(m.history) == 0
        na
    else
        curr = m.current
        
        for i = 0 to array.size(m.history) - 1
            prev = array.get(m.history, i)
            
            // Check all 8 SMT types: S1/S2 x High/Low x Bearish/Bullish x Normal/Inverse
            for j = 0 to 7
                isS1 = j == 0 or j == 1 or j == 4 or j == 5
                isHigh = j == 0 or j == 2 or j == 4 or j == 6
                bearish = j == 0 or j == 2 or j == 4 or j == 6
                inverse = j >= 4
                
                if (isS1 ? enableSymbol1 : enableSymbol2)
                    // Get pivot values
                    currPivot = isHigh ? curr.mainPivotHigh : curr.mainPivotLow
                    prevPivot = isHigh ? prev.mainPivotHigh : prev.mainPivotLow
                    currCompPivot = isS1 ? (isHigh ? curr.s1PivotHigh : curr.s1PivotLow) : (isHigh ? curr.s2PivotHigh : curr.s2PivotLow)
                    prevCompPivot = isS1 ? (isHigh ? prev.s1PivotHigh : prev.s1PivotLow) : (isHigh ? prev.s2PivotHigh : prev.s2PivotLow)
                    
                    // Check if pivots are confirmed
                    if currPivot.confirmed and prevPivot.confirmed and currCompPivot.confirmed and prevCompPivot.confirmed
                        if detectSMT(currPivot.price, prevPivot.price, currCompPivot.price, prevCompPivot.price, bearish, inverse)
                            symbolStr = isS1 ? s1Abbr : s2Abbr
                            drawSMT(prevPivot.barIndex, prevPivot.time, prevPivot.price, currPivot.barIndex, currPivot.time, currPivot.price, symbolStr, m.label, bearish, j, currCompPivot.price)
        
        // Cleanup old cycles
        while array.size(m.history) > 3
            array.remove(m.history, 0)

// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

currentDay = dayofmonth(time)
if currentDay != lastDay and not na(lastDay)
    for i = 0 to array.size(managers) - 1
        m = array.get(managers, i)
        array.clear(m.history)
        m.current.active := false
    while array.size(lines) > 0
        old = array.shift(lines)
        line.delete(old.lineObj)
        label.delete(old.labelObj)

lastDay := currentDay

checkInvalidation()

if inSession()
    for i = 0 to array.size(managers) - 1
        m = array.get(managers, i)
        
        if not m.enabled or (m.duration == 3 and timeframe.in_seconds(timeframe.period) > 60)
            continue
        
        if not m.current.active
            startCycle(m.current)
        
        if shouldComplete(m.current, m.duration)
            completeCycle(m)
        else
            updateCyclePivots(m.current)
        
        processSMT(m)
