//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SMT V-3.0 - SMT Divergence Detector
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Description:
//      Advanced SMT divergence detector that tracks and
//      compares price action across multiple correlated symbols in real-time.
//      Identifies divergences between main chart and comparison symbols across
//      multiple time cycles (90min, 30min, 10min & 3min) to spot potential reversal points.
//
//  Key Features:
//      • Real-time cycle high/low tracking with dynamic line updates
//      • Multi-symbol comparison (up to 2 additional symbols)
//      • 4 independent time cycles (90min, 30min, 10min, 3min)
//      • 8 SMT detection types (Normal & Inverse for Bullish/Bearish)
//      • Combined symbol labels when multiple SMTs align
//      • Session-based filtering with timezone support
//      • Automatic invalidation of broken SMT patterns
//      • Smart symbol abbreviation for clean chart display
//
//  Use Cases:
//      • Identify divergences between correlated futures (ES, NQ, BTC, EUR, JPY, GBP, etc)
//      • Spot institutional order flow differences
//      • Find high-probability reversal zones
//      • Confirm trend strength across multiple timeframes
//      • Detect smart money vs retail money positioning
//
//  Version: 3.0
//  Author: StoneFace / StoneFace_Trading
//  Release Date: Nov. 18. 2025
//  
//  © 2025. Stoneface. All rights reserved.
//  This source code is protected. Unauthorized distribution or modification
//  is strictly prohibited.
//
// ═══════════════════════════════════════════════════════════════════════════════

indicator("SMT V-3.0 - SMT Detector", 
     shorttitle="SMT V-3.0", 
     overlay=true, 
     max_lines_count=500, 
     max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS & SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
//
//  COMPARISON SYMBOLS:
//      Select up to 2 symbols to compare against your main chart. 
//      Best results with correlated assets (e.g., ES vs NQ, BTC vs ETH).
//      Use continuous contracts (ES1!, NQ1!) or specific contract months.
//
//  CYCLE TIMEFRAMES:
//      Enable cycles based on your trading timeframe:
//      • 90-min: Swing trading, higher timeframe confirmation
//      • 30-min: Intraday trends, session-based setups
//      • 10-min: Scalping entries, precise timing
//      • 3-min: Ultra-short-term, quick reversals (1-min chart recommended)
//
//  SESSION FILTER:
//      Limit detection to specific trading sessions (e.g., NYSE hours).
//      Helps avoid low-volume periods and reduces false signals.
//
//  DISPLAY:
//      Max Total SMT Lines controls chart clutter. Higher values show more
//      historical SMTs but may make chart harder to read.
//
// ═══════════════════════════════════════════════════════════════════════════════

enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("ES1!", "", confirm=false, group="Comparison Symbols", inline="sym2")

enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes")

enableSession = input.bool(true, "Enable Session Filter", group="Session Filter")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter")

// ═══════════════════════════════════════════════════════════════════════════════
//                            SESSION SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
enableSessionSMT = input.bool(false, "Enable Session SMT Detection", group="Session SMT")
showAsiaSession = input.bool(true, "Show Asia Session SMTs", group="Session SMT", inline="asia")
asiaColor = input.color(color.yellow, "", group="Session SMT", inline="asia")
showLondonSession = input.bool(true, "Show London Session SMTs", group="Session SMT", inline="london") 
londonColor = input.color(color.blue, "", group="Session SMT", inline="london")
showNYSession = input.bool(true, "Show NY Session SMTs", group="Session SMT", inline="ny")
nyColor = input.color(color.green, "", group="Session SMT", inline="ny")
showNYPMSession = input.bool(true, "Show NY PM Session SMTs", group="Session SMT", inline="nypm")
nypmColor = input.color(color.purple, "", group="Session SMT", inline="nypm")
maxSessionSMTs = input.int(3, "Max Session SMTs per Session", minval=1, maxval=10, group="Session SMT")

maxTotalLines = input.int(4, "Max Total SMT Lines", minval=1, maxval=20, group="Display")

// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type PivotPoint
    float price
    int barIndex
    int time
    bool confirmed

type CycleData
    int startTime
    int startBar
    PivotPoint mainPivotHigh
    PivotPoint mainPivotLow
    PivotPoint s1PivotHigh
    PivotPoint s1PivotLow
    PivotPoint s2PivotHigh
    PivotPoint s2PivotLow
    bool active

type CycleManager
    int duration
    string label
    bool enabled
    CycleData current
    array<CycleData> history

type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    float length
    int smtTypeId
    float mainPrice
    float compPrice
    string symbols
    string cycleLabel
    int historyCycleStart
    bool isForCurrentCycle

type SessionData
    string name
    string sessionTime
    string timezone
    color sessionColor
    bool enabled
    PivotPoint mainHigh
    PivotPoint mainLow
    PivotPoint s1High
    PivotPoint s1Low
    PivotPoint s2High
    PivotPoint s2Low
    bool active
    int startTime
    array<LineMetadata> smtLines

// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE
// ═══════════════════════════════════════════════════════════════════════════════

// FIXED: Enhanced request.security for better contract compatibility
// Use gaps_on for monthly contracts that may have trading gaps
// Add explicit na handling for different contract types
[s1_high_raw, s1_low_raw, s1_close_raw] = request.security(symbol1, timeframe.period, [high, low, close], barmerge.gaps_on, barmerge.lookahead_off)
[s2_high_raw, s2_low_raw, s2_close_raw] = request.security(symbol2, timeframe.period, [high, low, close], barmerge.gaps_on, barmerge.lookahead_off)

// Handle NA values better - use last known values when data is missing
var float s1_high_last = na
var float s1_low_last = na
var float s2_high_last = na
var float s2_low_last = na

s1_high = na(s1_high_raw) ? s1_high_last : s1_high_raw
s1_low = na(s1_low_raw) ? s1_low_last : s1_low_raw
s1_close = na(s1_close_raw) ? nz(s1_close_raw, close) : s1_close_raw
s2_high = na(s2_high_raw) ? s2_high_last : s2_high_raw
s2_low = na(s2_low_raw) ? s2_low_last : s2_low_raw
s2_close = na(s2_close_raw) ? nz(s2_close_raw, close) : s2_close_raw

// Update last known values
if not na(s1_high_raw)
    s1_high_last := s1_high_raw
if not na(s1_low_raw)
    s1_low_last := s1_low_raw
if not na(s2_high_raw)
    s2_high_last := s2_high_raw
if not na(s2_low_raw)
    s2_low_last := s2_low_raw

var array<CycleManager> managers = array.new<CycleManager>()
var array<LineMetadata> lines = array.new<LineMetadata>()
var array<SessionData> sessions = array.new<SessionData>()
var int lastDay = na
var string s1Abbr = ""
var string s2Abbr = ""
var string currentActiveSession = ""

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getAbbr(sym) =>
    parts = str.split(sym, ":")
    ticker = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    
    // Remove common suffixes
    clean = str.replace_all(str.replace_all(str.replace_all(ticker, "USDT", ""), ".P", ""), "USD", "")
    
    // Check if it ends with 1! (futures like ES1!, NQ1!)
    if str.contains(clean, "1!")
        clean := str.replace_all(clean, "1!", "")
        // For indices ending in 1!, take first 2-3 chars (ES, NQ, YM, etc)
        str.substring(clean, 0, math.min(str.length(clean), 2))
    else
        // For other symbols (MESZ2024, BTCUSDT, etc), take first 4 chars
        str.substring(clean, 0, math.min(str.length(clean), 4))

// FIXED: Better session handling for different contract types
inSession() => 
    if not enableSession
        true
    else
        // Check if we're in session for the main chart
        mainInSession = not na(time(timeframe.period, sessionStart, sessionTimezone))
        // For monthly contracts, be more lenient with session times
        // as they may have different session structures
        isMonthlyContract = str.contains(syminfo.ticker, "Z") or str.contains(syminfo.ticker, "H") or str.contains(syminfo.ticker, "M") or str.contains(syminfo.ticker, "U")
        
        if isMonthlyContract
            // For monthly contracts, allow broader session window
            extendedSession = not na(time(timeframe.period, "0000-2359", sessionTimezone))
            mainInSession or extendedSession
        else
            mainInSession

calcLen(bar1, price1, bar2, price2) =>
    barDiff = math.abs(bar2 - bar1)
    priceDiff = math.abs(price2 - price1)
    math.sqrt(barDiff * barDiff + priceDiff * priceDiff)

createPivot(float price, int barIdx, int t) =>
    PivotPoint.new(price, barIdx, t, true)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initCycleData() =>
    CycleData.new(na, na, createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), false)

initSessionData(name, sessionTime, timezone, sessionColor, enabled) =>
    SessionData.new(name, sessionTime, timezone, sessionColor, enabled, createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), false, na, array.new<LineMetadata>())

if barstate.isfirst
    array.push(managers, CycleManager.new(90, "90", enable90min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(30, "30", enable30min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(10, "10", enable10min, initCycleData(), array.new<CycleData>()))
    array.push(managers, CycleManager.new(3, "3", enable3min, initCycleData(), array.new<CycleData>()))
    
    // Initialize session data based on all-time-cycles.md - NY Time sessions
    // Each session contains 3x 90-minute cycles for session-to-session SMT analysis
    array.push(sessions, initSessionData("ASIA", "1800-0230", "America/New_York", asiaColor, showAsiaSession))          // 8.5 hours - Asia overnight session  
    array.push(sessions, initSessionData("LONDON", "0230-0700", "America/New_York", londonColor, showLondonSession))    // 4.5 hours - 3x 90min cycles (02:30-04:00, 04:00-05:30, 05:30-07:00)
    array.push(sessions, initSessionData("NY-AM", "0700-1130", "America/New_York", nyColor, showNYSession))             // 4.5 hours - 3x 90min cycles (07:00-08:30, 08:30-10:00, 10:00-11:30)
    array.push(sessions, initSessionData("NY-PM", "1130-1600", "America/New_York", nypmColor, showNYPMSession))         // 4.5 hours - 3x 90min cycles (11:30-13:00, 13:00-14:30, 14:30-16:00)
    
    s1Abbr := getAbbr(symbol1)
    s2Abbr := getAbbr(symbol2)

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

startCycle(c) =>
    c.startTime := time
    c.startBar := bar_index
    c.mainPivotHigh := createPivot(na, na, na)
    c.mainPivotLow := createPivot(na, na, na)
    c.s1PivotHigh := createPivot(na, na, na)
    c.s1PivotLow := createPivot(na, na, na)
    c.s2PivotHigh := createPivot(na, na, na)
    c.s2PivotLow := createPivot(na, na, na)
    c.active := true

updateCyclePivots(c) =>
    if c.active
        // Track highest high in cycle
        if high > c.mainPivotHigh.price or na(c.mainPivotHigh.price)
            c.mainPivotHigh.price := high
            c.mainPivotHigh.barIndex := bar_index
            c.mainPivotHigh.time := time
            c.mainPivotHigh.confirmed := true
        
        // Track lowest low in cycle
        if low < c.mainPivotLow.price or na(c.mainPivotLow.price)
            c.mainPivotLow.price := low
            c.mainPivotLow.barIndex := bar_index
            c.mainPivotLow.time := time
            c.mainPivotLow.confirmed := true
        
        // Track Symbol 1 extremes - FIXED: Better NA handling
        if enableSymbol1 and not na(s1_high) and not na(s1_low)
            // Only update if we have valid price data
            if s1_high > 0 and (s1_high > c.s1PivotHigh.price or na(c.s1PivotHigh.price))
                c.s1PivotHigh.price := s1_high
                c.s1PivotHigh.barIndex := bar_index
                c.s1PivotHigh.time := time
                c.s1PivotHigh.confirmed := true
            
            if s1_low > 0 and (s1_low < c.s1PivotLow.price or na(c.s1PivotLow.price))
                c.s1PivotLow.price := s1_low
                c.s1PivotLow.barIndex := bar_index
                c.s1PivotLow.time := time
                c.s1PivotLow.confirmed := true
        
        // Track Symbol 2 extremes - FIXED: Better NA handling
        if enableSymbol2 and not na(s2_high) and not na(s2_low)
            // Only update if we have valid price data
            if s2_high > 0 and (s2_high > c.s2PivotHigh.price or na(c.s2PivotHigh.price))
                c.s2PivotHigh.price := s2_high
                c.s2PivotHigh.barIndex := bar_index
                c.s2PivotHigh.time := time
                c.s2PivotHigh.confirmed := true
            
            if s2_low > 0 and (s2_low < c.s2PivotLow.price or na(c.s2PivotLow.price))
                c.s2PivotLow.price := s2_low
                c.s2PivotLow.barIndex := bar_index
                c.s2PivotLow.time := time
                c.s2PivotLow.confirmed := true
        

completeCycle(m) =>
    // Create deep copies of pivot points
    mainHighCopy = createPivot(m.current.mainPivotHigh.price, m.current.mainPivotHigh.barIndex, m.current.mainPivotHigh.time)
    mainLowCopy = createPivot(m.current.mainPivotLow.price, m.current.mainPivotLow.barIndex, m.current.mainPivotLow.time)
    s1HighCopy = createPivot(m.current.s1PivotHigh.price, m.current.s1PivotHigh.barIndex, m.current.s1PivotHigh.time)
    s1LowCopy = createPivot(m.current.s1PivotLow.price, m.current.s1PivotLow.barIndex, m.current.s1PivotLow.time)
    s2HighCopy = createPivot(m.current.s2PivotHigh.price, m.current.s2PivotHigh.barIndex, m.current.s2PivotHigh.time)
    s2LowCopy = createPivot(m.current.s2PivotLow.price, m.current.s2PivotLow.barIndex, m.current.s2PivotLow.time)
    savedCycle = CycleData.new(m.current.startTime, m.current.startBar, mainHighCopy, mainLowCopy, s1HighCopy, s1LowCopy, s2HighCopy, s2LowCopy, true)
    array.push(m.history, savedCycle)
    startCycle(m.current)

shouldComplete(c, durMin) =>
    if not c.active or na(c.startTime)
        false
    else
        // FIXED: Use pure time-based calculation instead of bar-based calculation
        // This ensures consistent cycle timing across different contract types
        // (continuous vs monthly contracts) that may have different session structures
        elapsedTime = time - c.startTime
        targetDuration = durMin * 60000  // Convert minutes to milliseconds
        elapsedTime >= targetDuration

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION & DRAWING
// ═══════════════════════════════════════════════════════════════════════════════

detectSMT(mCurr, mPrev, cCurr, cPrev, isBearish, isInverse) =>
    if na(mCurr) or na(mPrev) or na(cCurr) or na(cPrev)
        false
    else
        if isInverse
            isBearish ? (cCurr > cPrev and mCurr < mPrev) : (cCurr < cPrev and mCurr > mPrev)
        else
            isBearish ? (mCurr > mPrev and cCurr < cPrev) : (mCurr < mPrev and cCurr > cPrev)

isInvalidated(meta, isS1, isHigh, bearish, inverse, currMain, currComp) =>
    if na(currComp) or na(currMain)
        false
    else
        if inverse
            bearish ? (currComp < meta.compPrice or currMain > meta.mainPrice) : (currComp > meta.compPrice or currMain < meta.mainPrice)
        else
            bearish ? currComp > meta.compPrice : currComp < meta.compPrice

drawSMT(bar1, time1, price1, bar2, time2, price2, symbolStr, cycleLabel, bearish, typeId, compPrice) =>
    if na(bar1) or na(bar2) or na(time1) or na(time2)
        false
    else
        newLen = calcLen(bar1, price1, bar2, price2)
        idxRemove = -1
        shouldAdd = true
        mergeIdx = -1
        
        lineColor = color.black
        textColor = color.black
        
        if array.size(lines) > 0
            for i = 0 to array.size(lines) - 1
                m = array.get(lines, i)
                // Check if this is same cycle, same direction, and for current cycle
                if m.isBearish == bearish and m.cycleLabel == cycleLabel and m.isForCurrentCycle
                    // Merge symbols instead of replacing
                    mergeIdx := i
                    shouldAdd := false
                    break
        
        isNew = false
        if mergeIdx >= 0
            // Merge with existing SMT
            existing = array.get(lines, mergeIdx)
            
            // Always update if line is longer/better (even if symbol already exists)
            if newLen > existing.length
                // Redraw the line with better coordinates
                line.delete(existing.lineObj)
                existing.lineObj := line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1, style=line.style_solid)
                existing.length := newLen
                existing.mainPrice := price1
                existing.compPrice := compPrice
                // Update label position
                labTime = time1 > time2 ? time1 : time2
                labPrice = time1 > time2 ? price1 : price2
                label.set_xy(existing.labelObj, labTime, labPrice)
            
            // Add symbol if not already present
            if str.contains(existing.symbols, symbolStr) == false
                newSymbols = existing.symbols + " + " + symbolStr
                label.set_text(existing.labelObj, "SMT-" + newSymbols + " " + cycleLabel)
                existing.symbols := newSymbols
            
            isNew := false
        else if shouldAdd
            // No need to remove old lines here based on length anymore.
            // Just add the new one and let the FIFO limit handle cleanup.
            
            l = line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1, style=line.style_solid)
            labTime = time1 > time2 ? time1 : time2
            labPrice = time1 > time2 ? price1 : price2
            txt = "SMT-" + symbolStr + " " + cycleLabel
            lab = label.new(labTime, labPrice, txt, xloc=xloc.bar_time, style=label.style_none, color=textColor, textcolor=textColor, size=size.small, yloc=bearish ? yloc.abovebar : yloc.belowbar)
            
            array.push(lines, LineMetadata.new(l, lab, bearish, newLen, typeId, price1, compPrice, symbolStr, cycleLabel, bar2, true))
            
            while array.size(lines) > maxTotalLines
                old = array.shift(lines)
                line.delete(old.lineObj)
                label.delete(old.labelObj)
            
            isNew := true
        isNew

checkInvalidation() =>
    if array.size(lines) > 0
        toRemove = array.new<int>()
        for i = 0 to array.size(lines) - 1
            m = array.get(lines, i)
            isS1 = m.smtTypeId == 0 or m.smtTypeId == 1 or m.smtTypeId == 4 or m.smtTypeId == 5
            isHigh = m.smtTypeId == 0 or m.smtTypeId == 2 or m.smtTypeId == 4 or m.smtTypeId == 6
            inverse = m.smtTypeId >= 4
            enabled = isS1 ? enableSymbol1 : enableSymbol2
            
            if enabled
                currMain = isHigh ? high : low
                currComp = isS1 ? (isHigh ? s1_high : s1_low) : (isHigh ? s2_high : s2_low)
                
                if not na(currMain) and not na(currComp)
                    if isInvalidated(m, isS1, isHigh, m.isBearish, inverse, currMain, currComp)
                        array.push(toRemove, i)
        
        if array.size(toRemove) > 0
            for i = array.size(toRemove) - 1 to 0
                old = array.remove(lines, array.get(toRemove, i))
                line.delete(old.lineObj)
                label.delete(old.labelObj)

updateExistingLines(m) =>
    curr = m.current
    if array.size(lines) > 0 and curr.active
        for i = 0 to array.size(lines) - 1
            meta = array.get(lines, i)
            // Check if this line is for current active cycle of this manager
            // historyCycleStart should match the bar where current cycle started
            if meta.isForCurrentCycle and meta.cycleLabel == m.label and meta.historyCycleStart >= curr.startBar
                isS1 = meta.smtTypeId == 0 or meta.smtTypeId == 1 or meta.smtTypeId == 4 or meta.smtTypeId == 5
                isHigh = meta.smtTypeId == 0 or meta.smtTypeId == 2 or meta.smtTypeId == 4 or meta.smtTypeId == 6
                
                // Get current pivot (the end point of the line)
                currPivot = isHigh ? curr.mainPivotHigh : curr.mainPivotLow
                
                if not na(currPivot.price)
                    // Update the line endpoint to current cycle's extreme
                    line.set_xy2(meta.lineObj, currPivot.time, currPivot.price)
                    // Get line coordinates
                    x1 = line.get_x1(meta.lineObj)
                    y1 = line.get_y1(meta.lineObj)
                    // Update label position to the later point
                    labTime = x1 > currPivot.time ? x1 : currPivot.time
                    labPrice = x1 > currPivot.time ? y1 : currPivot.price
                    label.set_xy(meta.labelObj, labTime, labPrice)

processSMT(m) =>
    // Only process when we have history
    if array.size(m.history) == 0
        na
    else
        curr = m.current
        // Only check most recent completed cycle (index 0 is oldest after cleanup)
        latestIdx = array.size(m.history) - 1
        prev = array.get(m.history, latestIdx)
        
        // Pre-fetch all pivots once
        currMainHigh = curr.mainPivotHigh
        currMainLow = curr.mainPivotLow
        prevMainHigh = prev.mainPivotHigh
        prevMainLow = prev.mainPivotLow
        currS1High = curr.s1PivotHigh
        currS1Low = curr.s1PivotLow
        prevS1High = prev.s1PivotHigh
        prevS1Low = prev.s1PivotLow
        currS2High = curr.s2PivotHigh
        currS2Low = curr.s2PivotLow
        prevS2High = prev.s2PivotHigh
        prevS2Low = prev.s2PivotLow
        
        // Check Symbol 1 SMTs (only if enabled)
        if enableSymbol1
            // Bearish High Normal
            if not na(currMainHigh.price) and not na(prevMainHigh.price) and not na(currS1High.price) and not na(prevS1High.price)
                if currMainHigh.price > prevMainHigh.price and currS1High.price < prevS1High.price
                    drawSMT(prevMainHigh.barIndex, prevMainHigh.time, prevMainHigh.price, currMainHigh.barIndex, currMainHigh.time, currMainHigh.price, s1Abbr, m.label, true, 0, currS1High.price)
            
            // Bullish Low Normal
            if not na(currMainLow.price) and not na(prevMainLow.price) and not na(currS1Low.price) and not na(prevS1Low.price)
                if currMainLow.price < prevMainLow.price and currS1Low.price > prevS1Low.price
                    drawSMT(prevMainLow.barIndex, prevMainLow.time, prevMainLow.price, currMainLow.barIndex, currMainLow.time, currMainLow.price, s1Abbr, m.label, false, 1, currS1Low.price)
            
            // Bearish High Inverse
            if not na(currMainHigh.price) and not na(prevMainHigh.price) and not na(currS1High.price) and not na(prevS1High.price)
                if currS1High.price > prevS1High.price and currMainHigh.price < prevMainHigh.price
                    drawSMT(prevMainHigh.barIndex, prevMainHigh.time, prevMainHigh.price, currMainHigh.barIndex, currMainHigh.time, currMainHigh.price, s1Abbr, m.label, true, 4, currS1High.price)
            
            // Bullish Low Inverse
            if not na(currMainLow.price) and not na(prevMainLow.price) and not na(currS1Low.price) and not na(prevS1Low.price)
                if currS1Low.price < prevS1Low.price and currMainLow.price > prevMainLow.price
                    drawSMT(prevMainLow.barIndex, prevMainLow.time, prevMainLow.price, currMainLow.barIndex, currMainLow.time, currMainLow.price, s1Abbr, m.label, false, 5, currS1Low.price)
        
        // Check Symbol 2 SMTs (only if enabled)
        if enableSymbol2
            // Bearish High Normal
            if not na(currMainHigh.price) and not na(prevMainHigh.price) and not na(currS2High.price) and not na(prevS2High.price)
                if currMainHigh.price > prevMainHigh.price and currS2High.price < prevS2High.price
                    drawSMT(prevMainHigh.barIndex, prevMainHigh.time, prevMainHigh.price, currMainHigh.barIndex, currMainHigh.time, currMainHigh.price, s2Abbr, m.label, true, 2, currS2High.price)
            
            // Bullish Low Normal
            if not na(currMainLow.price) and not na(prevMainLow.price) and not na(currS2Low.price) and not na(prevS2Low.price)
                if currMainLow.price < prevMainLow.price and currS2Low.price > prevS2Low.price
                    drawSMT(prevMainLow.barIndex, prevMainLow.time, prevMainLow.price, currMainLow.barIndex, currMainLow.time, currMainLow.price, s2Abbr, m.label, false, 3, currS2Low.price)
            
            // Bearish High Inverse
            if not na(currMainHigh.price) and not na(prevMainHigh.price) and not na(currS2High.price) and not na(prevS2High.price)
                if currS2High.price > prevS2High.price and currMainHigh.price < prevMainHigh.price
                    drawSMT(prevMainHigh.barIndex, prevMainHigh.time, prevMainHigh.price, currMainHigh.barIndex, currMainHigh.time, currMainHigh.price, s2Abbr, m.label, true, 6, currS2High.price)
            
            // Bullish Low Inverse
            if not na(currMainLow.price) and not na(prevMainLow.price) and not na(currS2Low.price) and not na(prevS2Low.price)
                if currS2Low.price < prevS2Low.price and currMainLow.price > prevMainLow.price
                    drawSMT(prevMainLow.barIndex, prevMainLow.time, prevMainLow.price, currMainLow.barIndex, currMainLow.time, currMainLow.price, s2Abbr, m.label, false, 7, currS2Low.price)
        
        // Cleanup old cycles
        while array.size(m.history) > 3
            array.remove(m.history, 0)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SESSION SMT FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

isInSession(sessionTime, timezone) =>
    not na(time(timeframe.period, sessionTime, timezone))

startSession(sessionData) =>
    sessionData.startTime := time
    sessionData.mainHigh := createPivot(na, na, na)
    sessionData.mainLow := createPivot(na, na, na)
    sessionData.s1High := createPivot(na, na, na)
    sessionData.s1Low := createPivot(na, na, na)
    sessionData.s2High := createPivot(na, na, na)
    sessionData.s2Low := createPivot(na, na, na)
    sessionData.active := true

updateSessionPivots(sessionData) =>
    if sessionData.active
        // Track main chart extremes
        if high > sessionData.mainHigh.price or na(sessionData.mainHigh.price)
            sessionData.mainHigh.price := high
            sessionData.mainHigh.barIndex := bar_index
            sessionData.mainHigh.time := time
            sessionData.mainHigh.confirmed := true
        
        if low < sessionData.mainLow.price or na(sessionData.mainLow.price)
            sessionData.mainLow.price := low
            sessionData.mainLow.barIndex := bar_index
            sessionData.mainLow.time := time
            sessionData.mainLow.confirmed := true
        
        // Track Symbol 1 extremes
        if enableSymbol1 and not na(s1_high) and not na(s1_low)
            if s1_high > 0 and (s1_high > sessionData.s1High.price or na(sessionData.s1High.price))
                sessionData.s1High.price := s1_high
                sessionData.s1High.barIndex := bar_index
                sessionData.s1High.time := time
                sessionData.s1High.confirmed := true
            
            if s1_low > 0 and (s1_low < sessionData.s1Low.price or na(sessionData.s1Low.price))
                sessionData.s1Low.price := s1_low
                sessionData.s1Low.barIndex := bar_index
                sessionData.s1Low.time := time
                sessionData.s1Low.confirmed := true
        
        // Track Symbol 2 extremes
        if enableSymbol2 and not na(s2_high) and not na(s2_low)
            if s2_high > 0 and (s2_high > sessionData.s2High.price or na(sessionData.s2High.price))
                sessionData.s2High.price := s2_high
                sessionData.s2High.barIndex := bar_index
                sessionData.s2High.time := time
                sessionData.s2High.confirmed := true
            
            if s2_low > 0 and (s2_low < sessionData.s2Low.price or na(sessionData.s2Low.price))
                sessionData.s2Low.price := s2_low
                sessionData.s2Low.barIndex := bar_index
                sessionData.s2Low.time := time
                sessionData.s2Low.confirmed := true

processSessionSMT(sessionData) =>
    // Only process if we have valid pivots
    if not na(sessionData.mainHigh.price) and not na(sessionData.mainLow.price)
        // Check Symbol 1 SMTs
        if enableSymbol1 and not na(sessionData.s1High.price) and not na(sessionData.s1Low.price)
            // Get previous session data (simplified - using last known values)
            var float prevMainHigh = na
            var float prevMainLow = na
            var float prevS1High = na
            var float prevS1Low = na
            
            if not na(prevMainHigh) and not na(prevS1High)
                // Bearish SMT: Main higher high, S1 lower high
                if sessionData.mainHigh.price > prevMainHigh and sessionData.s1High.price < prevS1High
                    drawSMT(sessionData.mainHigh.barIndex, sessionData.mainHigh.time, sessionData.mainHigh.price, sessionData.s1High.barIndex, sessionData.s1High.time, sessionData.s1High.price, "SMT-" + sessionData.name + "-" + s1Abbr, sessionData.name, true, 999, sessionData.s1High.price)
                
                // Bearish Inverse SMT: S1 higher high, Main lower high  
                if sessionData.s1High.price > prevS1High and sessionData.mainHigh.price < prevMainHigh
                    drawSMT(sessionData.mainHigh.barIndex, sessionData.mainHigh.time, sessionData.mainHigh.price, sessionData.s1High.barIndex, sessionData.s1High.time, sessionData.s1High.price, "SMT-" + sessionData.name + "-" + s1Abbr + "-INV", sessionData.name, true, 998, sessionData.s1High.price)
            
            if not na(prevMainLow) and not na(prevS1Low)
                // Bullish SMT: Main lower low, S1 higher low
                if sessionData.mainLow.price < prevMainLow and sessionData.s1Low.price > prevS1Low
                    drawSMT(sessionData.mainLow.barIndex, sessionData.mainLow.time, sessionData.mainLow.price, sessionData.s1Low.barIndex, sessionData.s1Low.time, sessionData.s1Low.price, "SMT-" + sessionData.name + "-" + s1Abbr, sessionData.name, false, 997, sessionData.s1Low.price)
                
                // Bullish Inverse SMT: S1 lower low, Main higher low
                if sessionData.s1Low.price < prevS1Low and sessionData.mainLow.price > prevMainLow
                    drawSMT(sessionData.mainLow.barIndex, sessionData.mainLow.time, sessionData.mainLow.price, sessionData.s1Low.barIndex, sessionData.s1Low.time, sessionData.s1Low.price, "SMT-" + sessionData.name + "-" + s1Abbr + "-INV", sessionData.name, false, 996, sessionData.s1Low.price)
            
            // Update previous values for next session
            prevMainHigh := sessionData.mainHigh.price
            prevMainLow := sessionData.mainLow.price
            prevS1High := sessionData.s1High.price
            prevS1Low := sessionData.s1Low.price
        
        // Similar logic for Symbol 2
        if enableSymbol2 and not na(sessionData.s2High.price) and not na(sessionData.s2Low.price)
            var float prevMainHigh2 = na
            var float prevMainLow2 = na
            var float prevS2High = na
            var float prevS2Low = na
            
            if not na(prevMainHigh2) and not na(prevS2High)
                if sessionData.mainHigh.price > prevMainHigh2 and sessionData.s2High.price < prevS2High
                    drawSMT(sessionData.mainHigh.barIndex, sessionData.mainHigh.time, sessionData.mainHigh.price, sessionData.s2High.barIndex, sessionData.s2High.time, sessionData.s2High.price, "SMT-" + sessionData.name + "-" + s2Abbr, sessionData.name, true, 995, sessionData.s2High.price)
                
                if sessionData.s2High.price > prevS2High and sessionData.mainHigh.price < prevMainHigh2
                    drawSMT(sessionData.mainHigh.barIndex, sessionData.mainHigh.time, sessionData.mainHigh.price, sessionData.s2High.barIndex, sessionData.s2High.time, sessionData.s2High.price, "SMT-" + sessionData.name + "-" + s2Abbr + "-INV", sessionData.name, true, 994, sessionData.s2High.price)
            
            if not na(prevMainLow2) and not na(prevS2Low)
                if sessionData.mainLow.price < prevMainLow2 and sessionData.s2Low.price > prevS2Low
                    drawSMT(sessionData.mainLow.barIndex, sessionData.mainLow.time, sessionData.mainLow.price, sessionData.s2Low.barIndex, sessionData.s2Low.time, sessionData.s2Low.price, "SMT-" + sessionData.name + "-" + s2Abbr, sessionData.name, false, 993, sessionData.s2Low.price)
                
                if sessionData.s2Low.price < prevS2Low and sessionData.mainLow.price > prevMainLow2
                    drawSMT(sessionData.mainLow.barIndex, sessionData.mainLow.time, sessionData.mainLow.price, sessionData.s2Low.barIndex, sessionData.s2Low.time, sessionData.s2Low.price, "SMT-" + sessionData.name + "-" + s2Abbr + "-INV", sessionData.name, false, 992, sessionData.s2Low.price)
            
            prevMainHigh2 := sessionData.mainHigh.price
            prevMainLow2 := sessionData.mainLow.price
            prevS2High := sessionData.s2High.price
            prevS2Low := sessionData.s2Low.price

endSession(sessionData) =>
    sessionData.active := false
    // Process session SMTs here before ending
    processSessionSMT(sessionData)



// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════
//
//  EXECUTION FLOW:
//      1. Track daily reset - Clear all SMTs at day change
//      2. Check invalidation - Remove SMTs broken by new price action
//      3. Session filter - Only process during active trading session
//      4. Cycle management - Start, update, or complete cycles
//      5. SMT detection - Compare current vs previous cycles
//      6. Real-time updates - Move line endpoints as extremes change
//
//  SMT DETECTION LOGIC:
//      Bearish SMT (Normal): Main makes higher high, Comparison makes lower high
//      Bullish SMT (Normal): Main makes lower low, Comparison makes higher low
//      Bearish SMT (Inverse): Comparison makes higher high, Main makes lower high
//      Bullish SMT (Inverse): Comparison makes lower low, Main makes higher low
//
//  LINE DISPLAY:
//      • Black lines connect previous cycle extreme to current cycle extreme
//      • Labels show: "SMT-[Symbol(s)] [Cycle]"
//      • Combined labels (e.g., "SMT-BTC+ES 90") indicate multiple SMTs aligned
//      • Lines update in real-time as current cycle's high/low changes
//      • Lines are automatically removed if pattern is invalidated
//
// ═══════════════════════════════════════════════════════════════════════════════

currentDay = dayofmonth(time)
if currentDay != lastDay and not na(lastDay)
    for i = 0 to array.size(managers) - 1
        m = array.get(managers, i)
        array.clear(m.history)
        m.current.active := false
    while array.size(lines) > 0
        old = array.shift(lines)
        line.delete(old.lineObj)
        label.delete(old.labelObj)

lastDay := currentDay

checkInvalidation()

if inSession()
    for i = 0 to array.size(managers) - 1
        m = array.get(managers, i)
        
        if not m.enabled or (m.duration == 3 and timeframe.in_seconds(timeframe.period) > 60)
            continue
        
        if not m.current.active
            startCycle(m.current)
        
        updateCyclePivots(m.current)
        
        cycleCompleted = shouldComplete(m.current, m.duration)
        
        if cycleCompleted
            completeCycle(m)
        
        // Always process SMT to detect/update in real-time
        processSMT(m)
        updateExistingLines(m)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SESSION SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

// Process session SMTs if enabled
if enableSessionSMT
    // Check each session
    for i = 0 to array.size(sessions) - 1
        currentSession = array.get(sessions, i)
        if currentSession.enabled
            inCurrentSession = isInSession(currentSession.sessionTime, currentSession.timezone)
            
            // Session transition logic
            if inCurrentSession and not currentSession.active
                // Starting new session
                startSession(currentSession)
                currentActiveSession := currentSession.name
            else if not inCurrentSession and currentSession.active
                // Ending current session
                endSession(currentSession)
                currentActiveSession := ""
            else if currentSession.active
                // Update ongoing session
                updateSessionPivots(currentSession)
