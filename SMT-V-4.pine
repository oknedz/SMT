//@version=6
indicator("SMT V4 - 90min Only", overlay=true, max_lines_count=100, max_labels_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

symbol1 = input.symbol("CME_MINI:MESZ2025", "Symbol 1")
s1Abbr = input.string("ES", "Symbol 1 Abbreviation")

symbol2 = input.symbol("CBOT_MINI:MYMZ2025", "Symbol 2")
s2Abbr = input.string("YM", "Symbol 2 Abbreviation")

// ═══════════════════════════════════════════════════════════════════════════════
//                              VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════

// Track ALL completed 90min cycles for the day
var array<float> completed90Highs = array.new<float>()
var array<int> completed90HighTimes = array.new<int>()
var array<float> completed90Lows = array.new<float>()
var array<int> completed90LowTimes = array.new<int>()
var array<float> completed90S1Highs = array.new<float>()
var array<float> completed90S1Lows = array.new<float>()
var array<float> completed90S2Highs = array.new<float>()
var array<float> completed90S2Lows = array.new<float>()

// Track current 90min cycle
var float curr90High = na
var int curr90HighTime = na
var float curr90Low = na
var int curr90LowTime = na
var float curr90S1High = na
var float curr90S1Low = na
var float curr90S2High = na
var float curr90S2Low = na

var int last90CycleNumber = na
var int currentDay = na

// SMT lines
var line s1BearLine = na
var label s1BearLabel = na
var line s1BullLine = na
var label s1BullLabel = na
var line s2BearLine = na
var label s2BearLabel = na
var line s2BullLine = na
var label s2BullLabel = na

// ═══════════════════════════════════════════════════════════════════════════════
//                              SESSION-BASED 90MIN CYCLE CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

// Session starts at 2:30 AM NY time Always!
sessionStartHour = 2
sessionStartMinute = 30

// Get current NY time
currentHourNY = hour(time, "America/New_York")
currentMinuteNY = minute(time, "America/New_York")

// Calculate minutes since session start (2:30 AM)
minutesSinceSessionStart = (currentHourNY - sessionStartHour) * 60 + (currentMinuteNY - sessionStartMinute)

// Ensure positive (if before 2:30, add 24 hours)
if minutesSinceSessionStart < 0
    minutesSinceSessionStart += 24 * 60

// Calculate which 90min cycle we're in (0, 1, 2, 3...)
cycle90Number = math.floor(minutesSinceSessionStart / 90)

// Fetch comparison symbols HTF data (we still need their highs/lows)
[s1_90H, s1_90L] = request.security(symbol1, "90", [high, low], lookahead=barmerge.lookahead_off)
[s2_90H, s2_90L] = request.security(symbol2, "90", [high, low], lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Daily reset at midnight NY time
int todayDay = dayofmonth(time, "America/New_York")
if todayDay != currentDay
    currentDay := todayDay
    // Clear all completed cycles
    array.clear(completed90Highs)
    array.clear(completed90HighTimes)
    array.clear(completed90Lows)
    array.clear(completed90LowTimes)
    array.clear(completed90S1Highs)
    array.clear(completed90S1Lows)
    array.clear(completed90S2Highs)
    array.clear(completed90S2Lows)
    // Reset current
    curr90High := na
    curr90HighTime := na
    curr90Low := na
    curr90LowTime := na
    curr90S1High := na
    curr90S1Low := na
    curr90S2High := na
    curr90S2Low := na
    last90CycleNumber := na

// Detect 90min cycle change (when cycle number changes)
bool htf90Changed = not na(last90CycleNumber) and cycle90Number != last90CycleNumber

// Debug
plotchar(htf90Changed, "90min Changed", "▼", location.top, color.red)
bgcolor(cycle90Number % 2 == 0 ? color.new(color.blue, 95) : na, title="90min Cycles")

// When 90min bar changes, add current to completed arrays and reset current
if htf90Changed
    // Add completed cycle to arrays
    if not na(curr90High)
        array.push(completed90Highs, curr90High)
        array.push(completed90HighTimes, curr90HighTime)
    if not na(curr90Low)
        array.push(completed90Lows, curr90Low)
        array.push(completed90LowTimes, curr90LowTime)
    if not na(curr90S1High)
        array.push(completed90S1Highs, curr90S1High)
    if not na(curr90S1Low)
        array.push(completed90S1Lows, curr90S1Low)
    if not na(curr90S2High)
        array.push(completed90S2Highs, curr90S2High)
    if not na(curr90S2Low)
        array.push(completed90S2Lows, curr90S2Low)
    
    // Reset current cycle
    curr90High := na
    curr90HighTime := na
    curr90Low := na
    curr90LowTime := na
    curr90S1High := na
    curr90S1Low := na
    curr90S2High := na
    curr90S2Low := na

// Update current 90min cycle with chart's actual high/low (always, no HTF check needed)
if na(curr90High) or high > curr90High
    curr90High := high
    curr90HighTime := time

if na(curr90Low) or low < curr90Low
    curr90Low := low
    curr90LowTime := time

// Update comparison symbols (HTF values)
if not na(s1_90H) and (na(curr90S1High) or s1_90H > curr90S1High)
    curr90S1High := s1_90H
if not na(s1_90L) and (na(curr90S1Low) or s1_90L < curr90S1Low)
    curr90S1Low := s1_90L

if not na(s2_90H) and (na(curr90S2High) or s2_90H > curr90S2High)
    curr90S2High := s2_90H
if not na(s2_90L) and (na(curr90S2Low) or s2_90L < curr90S2Low)
    curr90S2Low := s2_90L

// Update last cycle number
last90CycleNumber := cycle90Number

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Only detect if we have completed cycles and current cycle data
// CRITICAL: Only detect if at least one 90min bar has completed (arrays not empty)
if array.size(completed90Highs) > 0 and array.size(completed90Lows) > 0 and not na(curr90High) and not na(curr90Low)
    // Get the most recent completed cycle
    prevHigh = array.get(completed90Highs, array.size(completed90Highs) - 1)
    prevHighTime = array.get(completed90HighTimes, array.size(completed90HighTimes) - 1)
    prevLow = array.get(completed90Lows, array.size(completed90Lows) - 1)
    prevLowTime = array.get(completed90LowTimes, array.size(completed90LowTimes) - 1)
    
    // Symbol 1 - Bearish SMT (highs diverge)
    if array.size(completed90S1Highs) > 0 and not na(curr90S1High)
        prevS1High = array.get(completed90S1Highs, array.size(completed90S1Highs) - 1)
        mainHH = curr90High > prevHigh
        s1HH = curr90S1High > prevS1High
        
        if mainHH != s1HH  // Divergence
            if na(s1BearLine)
                s1BearLine := line.new(prevHighTime, prevHigh, curr90HighTime, curr90High, xloc=xloc.bar_time, color=color.black, width=1)
                s1BearLabel := label.new(curr90HighTime, curr90High, "SMT-" + s1Abbr + " 90min", xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small)
            else
                line.set_xy1(s1BearLine, prevHighTime, prevHigh)
                line.set_xy2(s1BearLine, curr90HighTime, curr90High)
                label.set_xy(s1BearLabel, curr90HighTime, curr90High)
    
    // Symbol 1 - Bullish SMT (lows diverge)
    if array.size(completed90S1Lows) > 0 and not na(curr90S1Low)
        prevS1Low = array.get(completed90S1Lows, array.size(completed90S1Lows) - 1)
        mainLL = curr90Low < prevLow
        s1LL = curr90S1Low < prevS1Low
        
        if mainLL != s1LL  // Divergence
            if na(s1BullLine)
                s1BullLine := line.new(prevLowTime, prevLow, curr90LowTime, curr90Low, xloc=xloc.bar_time, color=color.black, width=1)
                s1BullLabel := label.new(curr90LowTime, curr90Low, "SMT-" + s1Abbr + " 90min", xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small)
            else
                line.set_xy1(s1BullLine, prevLowTime, prevLow)
                line.set_xy2(s1BullLine, curr90LowTime, curr90Low)
                label.set_xy(s1BullLabel, curr90LowTime, curr90Low)
    
    // Symbol 2 - Bearish SMT
    if array.size(completed90S2Highs) > 0 and not na(curr90S2High)
        prevS2High = array.get(completed90S2Highs, array.size(completed90S2Highs) - 1)
        mainHH = curr90High > prevHigh
        s2HH = curr90S2High > prevS2High
        
        if mainHH != s2HH
            if na(s2BearLine)
                s2BearLine := line.new(prevHighTime, prevHigh, curr90HighTime, curr90High, xloc=xloc.bar_time, color=color.black, width=1)
                s2BearLabel := label.new(curr90HighTime, curr90High, "SMT-" + s2Abbr + " 90min", xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small)
            else
                line.set_xy1(s2BearLine, prevHighTime, prevHigh)
                line.set_xy2(s2BearLine, curr90HighTime, curr90High)
                label.set_xy(s2BearLabel, curr90HighTime, curr90High)
    
    // Symbol 2 - Bullish SMT
    if array.size(completed90S2Lows) > 0 and not na(curr90S2Low)
        prevS2Low = array.get(completed90S2Lows, array.size(completed90S2Lows) - 1)
        mainLL = curr90Low < prevLow
        s2LL = curr90S2Low < prevS2Low
        
        if mainLL != s2LL
            if na(s2BullLine)
                s2BullLine := line.new(prevLowTime, prevLow, curr90LowTime, curr90Low, xloc=xloc.bar_time, color=color.black, width=1)
                s2BullLabel := label.new(curr90LowTime, curr90Low, "SMT-" + s2Abbr + " 90min", xloc=xloc.bar_time, style=label.style_none, color=color.black, textcolor=color.black, size=size.small)
            else
                line.set_xy1(s2BullLine, prevLowTime, prevLow)
                line.set_xy2(s2BullLine, curr90LowTime, curr90Low)
                label.set_xy(s2BullLabel, curr90LowTime, curr90Low)
