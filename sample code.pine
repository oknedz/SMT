// Display warning only for invalid timeframes
if barstate.islast and show_warning
    var label warning_label = na
    if not na(warning_label)
        label.delete(warning_label)
    
    warning_label := label.new(x=bar_index + 5, y=close, text="⚠️ Timeframe too high for Time Cycles\nUse 4H or lower timeframes", color=color.new(color.red, 30), textcolor=color.white, style=label.style_label_left, size=size.small)