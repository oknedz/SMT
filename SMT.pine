//@version=6
indicator("SMT Cycle Divergence", "SMT", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

// Cycle Settings
enable90min = input.bool(true, "Enable 90-min Cycle", group="Cycle Settings")
enable30min = input.bool(true, "Enable 30-min Cycle", group="Cycle Settings")
enable10min = input.bool(true, "Enable 10-min Cycle", group="Cycle Settings")

// Session Settings
enableSession = input.bool(true, "Enable Session Filter", group="Session Settings")
sessionStart = input.session("0230-1600", "Session Time", group="Session Settings")
sessionTimezone = input.string("America/New_York", "Timezone", group="Session Settings")

// Comparison Symbols
symbol1 = input.string("MEXC:BTCUSDT.P", "Symbol 1", group="Comparison Symbols")
enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols")
symbol2 = input.string("ES1!", "Symbol 2", group="Comparison Symbols")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols")

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Get symbol abbreviation for labels
getSymbolAbbr(sym) =>
    parts = str.split(sym, ":")
    symbolPart = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    // Remove numbers and special chars for cleaner label
    cleanSymbol = str.replace_all(symbolPart, "1!", "")
    cleanSymbol := str.replace_all(cleanSymbol, "USDT", "")
    str.substring(cleanSymbol, 0, math.min(str.length(cleanSymbol), 6))

// Check if current bar is within session
inSession() =>
    if not enableSession
        true
    else
        not na(time(timeframe.period, sessionStart, sessionTimezone))

// Get cycle duration in milliseconds
getCycleDuration(cycleMinutes) =>
    cycleMinutes * 60 * 1000

// ═══════════════════════════════════════════════════════════════════════════════
//                           DATA FETCHING
// ═══════════════════════════════════════════════════════════════════════════════

// Fetch Symbol 1 data
[s1_high, s1_low, s1_close] = request.security(symbol1, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)

// Fetch Symbol 2 data
[s2_high, s2_low, s2_close] = request.security(symbol2, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════════
//                           CYCLE TRACKING TYPE
// ═══════════════════════════════════════════════════════════════════════════════

type CycleData
    int startTime
    int startBar
    float mainHigh
    float mainLow
    int mainHighBar
    int mainLowBar
    float s1High
    float s1Low
    int s1HighBar
    int s1LowBar
    float s2High
    float s2Low
    int s2HighBar
    int s2LowBar
    bool active

// ═══════════════════════════════════════════════════════════════════════════════
//                           CYCLE DETECTION & TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

// Initialize current cycle data storage
var cycle90 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle30 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle10 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)

// Track arrays of previous cycles for the current day
var array<CycleData> prevCycles90 = array.new<CycleData>()
var array<CycleData> prevCycles30 = array.new<CycleData>()
var array<CycleData> prevCycles10 = array.new<CycleData>()

// Track current day for resetting arrays
var int currentDay = na

// Track active SMT line IDs for updating (prevents multiple lines for same divergence)
var line activeLine90_s1_bull = na
var line activeLine90_s1_bear = na
var line activeLine90_s2_bull = na
var line activeLine90_s2_bear = na
var line activeLine30_s1_bull = na
var line activeLine30_s1_bear = na
var line activeLine30_s2_bull = na
var line activeLine30_s2_bear = na
var line activeLine10_s1_bull = na
var line activeLine10_s1_bear = na
var line activeLine10_s2_bull = na
var line activeLine10_s2_bear = na

// Track active SMT label IDs for updating
var label activeLabel90_s1_bull = na
var label activeLabel90_s1_bear = na
var label activeLabel90_s2_bull = na
var label activeLabel90_s2_bear = na
var label activeLabel30_s1_bull = na
var label activeLabel30_s1_bear = na
var label activeLabel30_s2_bull = na
var label activeLabel30_s2_bear = na
var label activeLabel10_s1_bull = na
var label activeLabel10_s1_bear = na
var label activeLabel10_s2_bull = na
var label activeLabel10_s2_bear = na

// Function to start new cycle
startNewCycle(cycleData) =>
    cycleData.startTime := time
    cycleData.startBar := bar_index
    cycleData.mainHigh := high
    cycleData.mainLow := low
    cycleData.mainHighBar := bar_index
    cycleData.mainLowBar := bar_index
    cycleData.s1High := s1_high
    cycleData.s1Low := s1_low
    cycleData.s1HighBar := bar_index
    cycleData.s1LowBar := bar_index
    cycleData.s2High := s2_high
    cycleData.s2Low := s2_low
    cycleData.s2HighBar := bar_index
    cycleData.s2LowBar := bar_index
    cycleData.active := true

// Function to update cycle with current bar data
updateCycle(cycleData) =>
    if cycleData.active
        // Update main chart high/low
        if high > cycleData.mainHigh
            cycleData.mainHigh := high
            cycleData.mainHighBar := bar_index
        if low < cycleData.mainLow
            cycleData.mainLow := low
            cycleData.mainLowBar := bar_index
        
        // Update Symbol 1 high/low
        if enableSymbol1 and not na(s1_high)
            if s1_high > cycleData.s1High
                cycleData.s1High := s1_high
                cycleData.s1HighBar := bar_index
            if s1_low < cycleData.s1Low
                cycleData.s1Low := s1_low
                cycleData.s1LowBar := bar_index
        
        // Update Symbol 2 high/low
        if enableSymbol2 and not na(s2_high)
            if s2_high > cycleData.s2High
                cycleData.s2High := s2_high
                cycleData.s2HighBar := bar_index
            if s2_low < cycleData.s2Low
                cycleData.s2Low := s2_low
                cycleData.s2LowBar := bar_index

// Function to save cycle to array and start new cycle
completeCycle(cycleData, prevCyclesArray) =>
    // Create a copy of current cycle data to store in array
    savedCycle = CycleData.new()
    savedCycle.startTime := cycleData.startTime
    savedCycle.startBar := cycleData.startBar
    savedCycle.mainHigh := cycleData.mainHigh
    savedCycle.mainLow := cycleData.mainLow
    savedCycle.mainHighBar := cycleData.mainHighBar
    savedCycle.mainLowBar := cycleData.mainLowBar
    savedCycle.s1High := cycleData.s1High
    savedCycle.s1Low := cycleData.s1Low
    savedCycle.s1HighBar := cycleData.s1HighBar
    savedCycle.s1LowBar := cycleData.s1LowBar
    savedCycle.s2High := cycleData.s2High
    savedCycle.s2Low := cycleData.s2Low
    savedCycle.s2HighBar := cycleData.s2HighBar
    savedCycle.s2LowBar := cycleData.s2LowBar
    savedCycle.active := true
    
    // Add to array of previous cycles
    array.push(prevCyclesArray, savedCycle)
    
    // Start new cycle
    startNewCycle(cycleData)

// Function to check if cycle should complete
shouldCompleteCycle(cycleData, cycleDuration) =>
    cycleData.active and not na(cycleData.startTime) and (time - cycleData.startTime >= cycleDuration)

// ═══════════════════════════════════════════════════════════════════════════════
//                           CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// Check if new day started - reset arrays
newDay = dayofmonth(time) != dayofmonth(time[1])
if newDay and not na(time[1])
    array.clear(prevCycles90)
    array.clear(prevCycles30)
    array.clear(prevCycles10)
    currentDay := dayofmonth(time)

if inSession()
    // Initialize cycles on first bar in session
    if not cycle90.active and enable90min
        startNewCycle(cycle90)
    if not cycle30.active and enable30min
        startNewCycle(cycle30)
    if not cycle10.active and enable10min
        startNewCycle(cycle10)
    
    // Check and complete 90-min cycle
    if enable90min and shouldCompleteCycle(cycle90, getCycleDuration(90))
        completeCycle(cycle90, prevCycles90)
    else if enable90min
        updateCycle(cycle90)
    
    // Check and complete 30-min cycle
    if enable30min and shouldCompleteCycle(cycle30, getCycleDuration(30))
        completeCycle(cycle30, prevCycles30)
    else if enable30min
        updateCycle(cycle30)
    
    // Check and complete 10-min cycle
    if enable10min and shouldCompleteCycle(cycle10, getCycleDuration(10))
        completeCycle(cycle10, prevCycles10)
    else if enable10min
        updateCycle(cycle10)

// ═══════════════════════════════════════════════════════════════════════════════
//                           SMT DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Function to detect bearish SMT (higher highs divergence)
detectBearishSMT(mainCurrentHigh, mainPrevHigh, compCurrentHigh, compPrevHigh) =>
    not na(mainCurrentHigh) and not na(mainPrevHigh) and not na(compCurrentHigh) and not na(compPrevHigh) and
     mainCurrentHigh > mainPrevHigh and compCurrentHigh < compPrevHigh

// Function to detect bullish SMT (lower lows divergence)
detectBullishSMT(mainCurrentLow, mainPrevLow, compCurrentLow, compPrevLow) =>
    not na(mainCurrentLow) and not na(mainPrevLow) and not na(compCurrentLow) and not na(compPrevLow) and
     mainCurrentLow < mainPrevLow and compCurrentLow > compPrevLow

// Function to check if bearish SMT has ended (symbols became correlated)
bearishSMTEnded(mainCurrentHigh, mainPrevHigh, compCurrentHigh, compPrevHigh) =>
    not na(mainCurrentHigh) and not na(mainPrevHigh) and not na(compCurrentHigh) and not na(compPrevHigh) and
     mainCurrentHigh > mainPrevHigh and compCurrentHigh >= compPrevHigh

// Function to check if bullish SMT has ended (symbols became correlated)
bullishSMTEnded(mainCurrentLow, mainPrevLow, compCurrentLow, compPrevLow) =>
    not na(mainCurrentLow) and not na(mainPrevLow) and not na(compCurrentLow) and not na(compPrevLow) and
     mainCurrentLow < mainPrevLow and compCurrentLow <= compPrevLow

// Function to draw or update SMT line and label
drawOrUpdateSMT(mainBar, mainPrice, compBar, compPrice, labelText, isBullish, activeLine, activeLabel) =>
    line newLine = na
    label newLabel = na
    
    if not na(mainBar) and not na(compBar)
        // Delete previous line and label if they exist
        if not na(activeLine)
            line.delete(activeLine)
        if not na(activeLabel)
            label.delete(activeLabel)
        
        // Draw new line connecting the divergent pivots
        newLine := line.new(mainBar, mainPrice, compBar, compPrice, color=color.black, width=1, style=line.style_solid)
        
        // Add label at the most recent pivot
        labelBar = math.max(mainBar, compBar)
        labelPrice = mainBar > compBar ? mainPrice : compPrice
        newLabel := label.new(labelBar, labelPrice, labelText, 
                 style=label.style_none, 
                 color=color.black, 
                 textcolor=color.black, 
                 size=size.small,
                 yloc=yloc.price,
                 xloc=xloc.bar_index)
    
    [newLine, newLabel]

// ═══════════════════════════════════════════════════════════════════════════════
//                           SMT DETECTION - 90 MIN
// ═══════════════════════════════════════════════════════════════════════════════

if enable90min and cycle90.active and array.size(prevCycles90) > 0
    
    // Track the longest (oldest) SMT divergence for each type
    int s1_bear_oldestIdx = -1
    int s1_bull_oldestIdx = -1
    int s2_bear_oldestIdx = -1
    int s2_bull_oldestIdx = -1
    
    // Loop through all previous cycles from today to find the LONGEST active SMT
    for i = 0 to array.size(prevCycles90) - 1
        prevCycle = array.get(prevCycles90, i)
        
        // Check Symbol 1 - Bearish SMT (highs) - find oldest
        if enableSymbol1 and s1_bear_oldestIdx == -1
            if detectBearishSMT(cycle90.mainHigh, prevCycle.mainHigh, cycle90.s1High, prevCycle.s1High)
                s1_bear_oldestIdx := i
        
        // Check Symbol 1 - Bullish SMT (lows) - find oldest
        if enableSymbol1 and s1_bull_oldestIdx == -1
            if detectBullishSMT(cycle90.mainLow, prevCycle.mainLow, cycle90.s1Low, prevCycle.s1Low)
                s1_bull_oldestIdx := i
        
        // Check Symbol 2 - Bearish SMT (highs) - find oldest
        if enableSymbol2 and s2_bear_oldestIdx == -1
            if detectBearishSMT(cycle90.mainHigh, prevCycle.mainHigh, cycle90.s2High, prevCycle.s2High)
                s2_bear_oldestIdx := i
        
        // Check Symbol 2 - Bullish SMT (lows) - find oldest
        if enableSymbol2 and s2_bull_oldestIdx == -1
            if detectBullishSMT(cycle90.mainLow, prevCycle.mainLow, cycle90.s2Low, prevCycle.s2Low)
                s2_bull_oldestIdx := i
    
    // Draw/update lines for the longest SMT divergences found
    if enableSymbol1 and s1_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles90, s1_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 90"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle90.mainHighBar, cycle90.mainHigh, labelText, false, activeLine90_s1_bear, activeLabel90_s1_bear)
        activeLine90_s1_bear := newLine
        activeLabel90_s1_bear := newLabel
    else if enableSymbol1 and not na(activeLine90_s1_bear)
        // No SMT found, clear the line
        line.delete(activeLine90_s1_bear)
        label.delete(activeLabel90_s1_bear)
        activeLine90_s1_bear := na
        activeLabel90_s1_bear := na
    
    if enableSymbol1 and s1_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles90, s1_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 90"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle90.mainLowBar, cycle90.mainLow, labelText, true, activeLine90_s1_bull, activeLabel90_s1_bull)
        activeLine90_s1_bull := newLine
        activeLabel90_s1_bull := newLabel
    else if enableSymbol1 and not na(activeLine90_s1_bull)
        line.delete(activeLine90_s1_bull)
        label.delete(activeLabel90_s1_bull)
        activeLine90_s1_bull := na
        activeLabel90_s1_bull := na
    
    if enableSymbol2 and s2_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles90, s2_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 90"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle90.mainHighBar, cycle90.mainHigh, labelText, false, activeLine90_s2_bear, activeLabel90_s2_bear)
        activeLine90_s2_bear := newLine
        activeLabel90_s2_bear := newLabel
    else if enableSymbol2 and not na(activeLine90_s2_bear)
        line.delete(activeLine90_s2_bear)
        label.delete(activeLabel90_s2_bear)
        activeLine90_s2_bear := na
        activeLabel90_s2_bear := na
    
    if enableSymbol2 and s2_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles90, s2_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 90"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle90.mainLowBar, cycle90.mainLow, labelText, true, activeLine90_s2_bull, activeLabel90_s2_bull)
        activeLine90_s2_bull := newLine
        activeLabel90_s2_bull := newLabel
    else if enableSymbol2 and not na(activeLine90_s2_bull)
        line.delete(activeLine90_s2_bull)
        label.delete(activeLabel90_s2_bull)
        activeLine90_s2_bull := na
        activeLabel90_s2_bull := na

// ═══════════════════════════════════════════════════════════════════════════════
//                           SMT DETECTION - 30 MIN
// ═══════════════════════════════════════════════════════════════════════════════

if enable30min and cycle30.active and array.size(prevCycles30) > 0
    
    // Track the longest (oldest) SMT divergence for each type
    int s1_bear_oldestIdx = -1
    int s1_bull_oldestIdx = -1
    int s2_bear_oldestIdx = -1
    int s2_bull_oldestIdx = -1
    
    // Loop through all previous cycles from today to find the LONGEST active SMT
    for i = 0 to array.size(prevCycles30) - 1
        prevCycle = array.get(prevCycles30, i)
        
        // Check Symbol 1 - Bearish SMT (highs) - find oldest
        if enableSymbol1 and s1_bear_oldestIdx == -1
            if detectBearishSMT(cycle30.mainHigh, prevCycle.mainHigh, cycle30.s1High, prevCycle.s1High)
                s1_bear_oldestIdx := i
        
        // Check Symbol 1 - Bullish SMT (lows) - find oldest
        if enableSymbol1 and s1_bull_oldestIdx == -1
            if detectBullishSMT(cycle30.mainLow, prevCycle.mainLow, cycle30.s1Low, prevCycle.s1Low)
                s1_bull_oldestIdx := i
        
        // Check Symbol 2 - Bearish SMT (highs) - find oldest
        if enableSymbol2 and s2_bear_oldestIdx == -1
            if detectBearishSMT(cycle30.mainHigh, prevCycle.mainHigh, cycle30.s2High, prevCycle.s2High)
                s2_bear_oldestIdx := i
        
        // Check Symbol 2 - Bullish SMT (lows) - find oldest
        if enableSymbol2 and s2_bull_oldestIdx == -1
            if detectBullishSMT(cycle30.mainLow, prevCycle.mainLow, cycle30.s2Low, prevCycle.s2Low)
                s2_bull_oldestIdx := i
    
    // Draw/update lines for the longest SMT divergences found
    if enableSymbol1 and s1_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles30, s1_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 30"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle30.mainHighBar, cycle30.mainHigh, labelText, false, activeLine30_s1_bear, activeLabel30_s1_bear)
        activeLine30_s1_bear := newLine
        activeLabel30_s1_bear := newLabel
    else if enableSymbol1 and not na(activeLine30_s1_bear)
        line.delete(activeLine30_s1_bear)
        label.delete(activeLabel30_s1_bear)
        activeLine30_s1_bear := na
        activeLabel30_s1_bear := na
    
    if enableSymbol1 and s1_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles30, s1_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 30"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle30.mainLowBar, cycle30.mainLow, labelText, true, activeLine30_s1_bull, activeLabel30_s1_bull)
        activeLine30_s1_bull := newLine
        activeLabel30_s1_bull := newLabel
    else if enableSymbol1 and not na(activeLine30_s1_bull)
        line.delete(activeLine30_s1_bull)
        label.delete(activeLabel30_s1_bull)
        activeLine30_s1_bull := na
        activeLabel30_s1_bull := na
    
    if enableSymbol2 and s2_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles30, s2_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 30"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle30.mainHighBar, cycle30.mainHigh, labelText, false, activeLine30_s2_bear, activeLabel30_s2_bear)
        activeLine30_s2_bear := newLine
        activeLabel30_s2_bear := newLabel
    else if enableSymbol2 and not na(activeLine30_s2_bear)
        line.delete(activeLine30_s2_bear)
        label.delete(activeLabel30_s2_bear)
        activeLine30_s2_bear := na
        activeLabel30_s2_bear := na
    
    if enableSymbol2 and s2_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles30, s2_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 30"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle30.mainLowBar, cycle30.mainLow, labelText, true, activeLine30_s2_bull, activeLabel30_s2_bull)
        activeLine30_s2_bull := newLine
        activeLabel30_s2_bull := newLabel
    else if enableSymbol2 and not na(activeLine30_s2_bull)
        line.delete(activeLine30_s2_bull)
        label.delete(activeLabel30_s2_bull)
        activeLine30_s2_bull := na
        activeLabel30_s2_bull := na

// ═══════════════════════════════════════════════════════════════════════════════
//                           SMT DETECTION - 10 MIN
// ═══════════════════════════════════════════════════════════════════════════════

if enable10min and cycle10.active and array.size(prevCycles10) > 0
    
    // Track the longest (oldest) SMT divergence for each type
    int s1_bear_oldestIdx = -1
    int s1_bull_oldestIdx = -1
    int s2_bear_oldestIdx = -1
    int s2_bull_oldestIdx = -1
    
    // Loop through all previous cycles from today to find the LONGEST active SMT
    for i = 0 to array.size(prevCycles10) - 1
        prevCycle = array.get(prevCycles10, i)
        
        // Check Symbol 1 - Bearish SMT (highs) - find oldest
        if enableSymbol1 and s1_bear_oldestIdx == -1
            if detectBearishSMT(cycle10.mainHigh, prevCycle.mainHigh, cycle10.s1High, prevCycle.s1High)
                s1_bear_oldestIdx := i
        
        // Check Symbol 1 - Bullish SMT (lows) - find oldest
        if enableSymbol1 and s1_bull_oldestIdx == -1
            if detectBullishSMT(cycle10.mainLow, prevCycle.mainLow, cycle10.s1Low, prevCycle.s1Low)
                s1_bull_oldestIdx := i
        
        // Check Symbol 2 - Bearish SMT (highs) - find oldest
        if enableSymbol2 and s2_bear_oldestIdx == -1
            if detectBearishSMT(cycle10.mainHigh, prevCycle.mainHigh, cycle10.s2High, prevCycle.s2High)
                s2_bear_oldestIdx := i
        
        // Check Symbol 2 - Bullish SMT (lows) - find oldest
        if enableSymbol2 and s2_bull_oldestIdx == -1
            if detectBullishSMT(cycle10.mainLow, prevCycle.mainLow, cycle10.s2Low, prevCycle.s2Low)
                s2_bull_oldestIdx := i
    
    // Draw/update lines for the longest SMT divergences found
    if enableSymbol1 and s1_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles10, s1_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 10"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle10.mainHighBar, cycle10.mainHigh, labelText, false, activeLine10_s1_bear, activeLabel10_s1_bear)
        activeLine10_s1_bear := newLine
        activeLabel10_s1_bear := newLabel
    else if enableSymbol1 and not na(activeLine10_s1_bear)
        line.delete(activeLine10_s1_bear)
        label.delete(activeLabel10_s1_bear)
        activeLine10_s1_bear := na
        activeLabel10_s1_bear := na
    
    if enableSymbol1 and s1_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles10, s1_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol1) + " 10"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle10.mainLowBar, cycle10.mainLow, labelText, true, activeLine10_s1_bull, activeLabel10_s1_bull)
        activeLine10_s1_bull := newLine
        activeLabel10_s1_bull := newLabel
    else if enableSymbol1 and not na(activeLine10_s1_bull)
        line.delete(activeLine10_s1_bull)
        label.delete(activeLabel10_s1_bull)
        activeLine10_s1_bull := na
        activeLabel10_s1_bull := na
    
    if enableSymbol2 and s2_bear_oldestIdx >= 0
        prevCycle = array.get(prevCycles10, s2_bear_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 10"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainHighBar, prevCycle.mainHigh, cycle10.mainHighBar, cycle10.mainHigh, labelText, false, activeLine10_s2_bear, activeLabel10_s2_bear)
        activeLine10_s2_bear := newLine
        activeLabel10_s2_bear := newLabel
    else if enableSymbol2 and not na(activeLine10_s2_bear)
        line.delete(activeLine10_s2_bear)
        label.delete(activeLabel10_s2_bear)
        activeLine10_s2_bear := na
        activeLabel10_s2_bear := na
    
    if enableSymbol2 and s2_bull_oldestIdx >= 0
        prevCycle = array.get(prevCycles10, s2_bull_oldestIdx)
        labelText = "SMT-" + getSymbolAbbr(symbol2) + " 10"
        [newLine, newLabel] = drawOrUpdateSMT(prevCycle.mainLowBar, prevCycle.mainLow, cycle10.mainLowBar, cycle10.mainLow, labelText, true, activeLine10_s2_bull, activeLabel10_s2_bull)
        activeLine10_s2_bull := newLine
        activeLabel10_s2_bull := newLabel
    else if enableSymbol2 and not na(activeLine10_s2_bull)
        line.delete(activeLine10_s2_bull)
        label.delete(activeLabel10_s2_bull)
        activeLine10_s2_bull := na
        activeLabel10_s2_bull := na

