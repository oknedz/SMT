//@version=6
indicator("SMT V-1.01", "SMT Detector [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Comparison Symbols
enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("ES1!", "", confirm=false, group="Comparison Symbols", inline="sym2")

// Cycle Settings
enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 90-minute cycle detection")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 30-minute cycle detection")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 10-minute cycle detection")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 3-minute cycle detection (only works on 1-minute or lower timeframes)")

// Session Filter
enableSession = input.bool(true, "Enable Session Filter", group="Session Filter", tooltip="Only detect SMT during specified session times")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter", tooltip="Trading session hours")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter", tooltip="Timezone for session filter")

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
getSymbolAbbr(sym) =>
    parts = str.split(sym, ":")
    symbolPart = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    cleanSymbol = str.replace_all(str.replace_all(symbolPart, "1!", ""), "USDT", "")
    str.substring(cleanSymbol, 0, math.min(str.length(cleanSymbol), 6))

inSession() => not enableSession or not na(time(timeframe.period, sessionStart, sessionTimezone))

getCycleDuration(cycleMinutes) => cycleMinutes * 60 * 1000

// ═══════════════════════════════════════════════════════════════════════════════
//                              DATA FETCHING
// ═══════════════════════════════════════════════════════════════════════════════
[s1_high, s1_low, s1_close] = request.security(symbol1, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE TYPE
// ═══════════════════════════════════════════════════════════════════════════════
type CycleData
    int startTime
    int startBar
    float mainHigh
    float mainLow
    int mainHighBar
    int mainLowBar
    float s1High
    float s1Low
    int s1HighBar
    int s1LowBar
    float s2High
    float s2Low
    int s2HighBar
    int s2LowBar
    bool active

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
var cycle90 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle30 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle10 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle3 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)

var array<CycleData> prevCycles90 = array.new<CycleData>()
var array<CycleData> prevCycles30 = array.new<CycleData>()
var array<CycleData> prevCycles10 = array.new<CycleData>()
var array<CycleData> prevCycles3 = array.new<CycleData>()

var int currentDay = na

// Active line/label tracking arrays - storing multiple SMT lines per type
// Type 0: S1 Bearish, 1: S1 Bullish, 2: S2 Bearish, 3: S2 Bullish, 4: S1 Inv Bearish, 5: S1 Inv Bullish, 6: S2 Inv Bearish, 7: S2 Inv Bullish
var array<line> lineHistory90_0 = array.new<line>(0)
var array<label> labelHistory90_0 = array.new<label>(0)
var array<line> lineHistory90_1 = array.new<line>(0)
var array<label> labelHistory90_1 = array.new<label>(0)
var array<line> lineHistory90_2 = array.new<line>(0)
var array<label> labelHistory90_2 = array.new<label>(0)
var array<line> lineHistory90_3 = array.new<line>(0)
var array<label> labelHistory90_3 = array.new<label>(0)
var array<line> lineHistory90_4 = array.new<line>(0)
var array<label> labelHistory90_4 = array.new<label>(0)
var array<line> lineHistory90_5 = array.new<line>(0)
var array<label> labelHistory90_5 = array.new<label>(0)
var array<line> lineHistory90_6 = array.new<line>(0)
var array<label> labelHistory90_6 = array.new<label>(0)
var array<line> lineHistory90_7 = array.new<line>(0)
var array<label> labelHistory90_7 = array.new<label>(0)

var array<line> lineHistory30_0 = array.new<line>(0)
var array<label> labelHistory30_0 = array.new<label>(0)
var array<line> lineHistory30_1 = array.new<line>(0)
var array<label> labelHistory30_1 = array.new<label>(0)
var array<line> lineHistory30_2 = array.new<line>(0)
var array<label> labelHistory30_2 = array.new<label>(0)
var array<line> lineHistory30_3 = array.new<line>(0)
var array<label> labelHistory30_3 = array.new<label>(0)
var array<line> lineHistory30_4 = array.new<line>(0)
var array<label> labelHistory30_4 = array.new<label>(0)
var array<line> lineHistory30_5 = array.new<line>(0)
var array<label> labelHistory30_5 = array.new<label>(0)
var array<line> lineHistory30_6 = array.new<line>(0)
var array<label> labelHistory30_6 = array.new<label>(0)
var array<line> lineHistory30_7 = array.new<line>(0)
var array<label> labelHistory30_7 = array.new<label>(0)

var array<line> lineHistory10_0 = array.new<line>(0)
var array<label> labelHistory10_0 = array.new<label>(0)
var array<line> lineHistory10_1 = array.new<line>(0)
var array<label> labelHistory10_1 = array.new<label>(0)
var array<line> lineHistory10_2 = array.new<line>(0)
var array<label> labelHistory10_2 = array.new<label>(0)
var array<line> lineHistory10_3 = array.new<line>(0)
var array<label> labelHistory10_3 = array.new<label>(0)
var array<line> lineHistory10_4 = array.new<line>(0)
var array<label> labelHistory10_4 = array.new<label>(0)
var array<line> lineHistory10_5 = array.new<line>(0)
var array<label> labelHistory10_5 = array.new<label>(0)
var array<line> lineHistory10_6 = array.new<line>(0)
var array<label> labelHistory10_6 = array.new<label>(0)
var array<line> lineHistory10_7 = array.new<line>(0)
var array<label> labelHistory10_7 = array.new<label>(0)

var array<line> lineHistory3_0 = array.new<line>(0)
var array<label> labelHistory3_0 = array.new<label>(0)
var array<line> lineHistory3_1 = array.new<line>(0)
var array<label> labelHistory3_1 = array.new<label>(0)
var array<line> lineHistory3_2 = array.new<line>(0)
var array<label> labelHistory3_2 = array.new<label>(0)
var array<line> lineHistory3_3 = array.new<line>(0)
var array<label> labelHistory3_3 = array.new<label>(0)
var array<line> lineHistory3_4 = array.new<line>(0)
var array<label> labelHistory3_4 = array.new<label>(0)
var array<line> lineHistory3_5 = array.new<line>(0)
var array<label> labelHistory3_5 = array.new<label>(0)
var array<line> lineHistory3_6 = array.new<line>(0)
var array<label> labelHistory3_6 = array.new<label>(0)
var array<line> lineHistory3_7 = array.new<line>(0)
var array<label> labelHistory3_7 = array.new<label>(0)

int MAX_LINES_PER_TYPE = 4

// ═══════════════════════════════════════════════════════════════════════════════
//                              CORE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
startNewCycle(cycleData) =>
    cycleData.startTime := time
    cycleData.startBar := bar_index
    cycleData.mainHigh := high
    cycleData.mainLow := low
    cycleData.mainHighBar := bar_index
    cycleData.mainLowBar := bar_index
    cycleData.s1High := s1_high
    cycleData.s1Low := s1_low
    cycleData.s1HighBar := bar_index
    cycleData.s1LowBar := bar_index
    cycleData.s2High := s2_high
    cycleData.s2Low := s2_low
    cycleData.s2HighBar := bar_index
    cycleData.s2LowBar := bar_index
    cycleData.active := true

updateCycle(cycleData) =>
    if cycleData.active
        if high > cycleData.mainHigh
            cycleData.mainHigh := high
            cycleData.mainHighBar := bar_index
        if low < cycleData.mainLow
            cycleData.mainLow := low
            cycleData.mainLowBar := bar_index
        if enableSymbol1 and not na(s1_high)
            if s1_high > cycleData.s1High
                cycleData.s1High := s1_high
                cycleData.s1HighBar := bar_index
            if s1_low < cycleData.s1Low
                cycleData.s1Low := s1_low
                cycleData.s1LowBar := bar_index
        if enableSymbol2 and not na(s2_high)
            if s2_high > cycleData.s2High
                cycleData.s2High := s2_high
                cycleData.s2HighBar := bar_index
            if s2_low < cycleData.s2Low
                cycleData.s2Low := s2_low
                cycleData.s2LowBar := bar_index

completeCycle(cycleData, prevCyclesArray) =>
    savedCycle = CycleData.new(cycleData.startTime, cycleData.startBar, cycleData.mainHigh, cycleData.mainLow, cycleData.mainHighBar, cycleData.mainLowBar, cycleData.s1High, cycleData.s1Low, cycleData.s1HighBar, cycleData.s1LowBar, cycleData.s2High, cycleData.s2Low, cycleData.s2HighBar, cycleData.s2LowBar, true)
    array.push(prevCyclesArray, savedCycle)
    startNewCycle(cycleData)

shouldCompleteCycle(cycleData, cycleDuration) => cycleData.active and not na(cycleData.startTime) and (time - cycleData.startTime >= cycleDuration)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
detectBearishSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and mainCurr > mainPrev and compCurr < compPrev

detectBullishSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and mainCurr < mainPrev and compCurr > compPrev

detectBearishInverseSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and compCurr > compPrev and mainCurr < mainPrev

detectBullishInverseSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and compCurr < compPrev and mainCurr > mainPrev

drawOrUpdateSMT(mainBar, mainPrice, compBar, compPrice, labelText, lineArray, labelArray, isBearish) =>
    line newLine = na
    label newLabel = na
    if not na(mainBar) and not na(compBar)
        newLine := line.new(mainBar, mainPrice, compBar, compPrice, color=color.black, width=1, style=line.style_solid)
        
        // Position label on the right side of the line (rightmost bar)
        labelBar = math.max(mainBar, compBar)
        labelPrice = mainBar > compBar ? mainPrice : compPrice
        
        // Position text above price for bearish, below price for bullish
        textYloc = isBearish ? yloc.abovebar : yloc.belowbar
        
        newLabel := label.new(labelBar, labelPrice, labelText, style=label.style_none, color=color.black, textcolor=color.black, size=size.small, yloc=textYloc, xloc=xloc.bar_index)
        
        // Add to history
        array.push(lineArray, newLine)
        array.push(labelArray, newLabel)
        
        // Remove oldest if exceeds limit
        if array.size(lineArray) > MAX_LINES_PER_TYPE
            oldLine = array.shift(lineArray)
            oldLabel = array.shift(labelArray)
            if not na(oldLine)
                line.delete(oldLine)
            if not na(oldLabel)
                label.delete(oldLabel)
    [newLine, newLabel]

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════
newDay = dayofmonth(time) != dayofmonth(time[1])
if newDay and not na(time[1])
    array.clear(prevCycles90)
    array.clear(prevCycles30)
    array.clear(prevCycles10)
    array.clear(prevCycles3)
    
    // Reset active cycles to prevent cross-day comparisons
    cycle90.active := false
    cycle30.active := false
    cycle10.active := false
    cycle3.active := false
    
    // Clear all line and label history for 90-min cycle
    while array.size(lineHistory90_0) > 0
        line.delete(array.shift(lineHistory90_0))
        label.delete(array.shift(labelHistory90_0))
    while array.size(lineHistory90_1) > 0
        line.delete(array.shift(lineHistory90_1))
        label.delete(array.shift(labelHistory90_1))
    while array.size(lineHistory90_2) > 0
        line.delete(array.shift(lineHistory90_2))
        label.delete(array.shift(labelHistory90_2))
    while array.size(lineHistory90_3) > 0
        line.delete(array.shift(lineHistory90_3))
        label.delete(array.shift(labelHistory90_3))
    while array.size(lineHistory90_4) > 0
        line.delete(array.shift(lineHistory90_4))
        label.delete(array.shift(labelHistory90_4))
    while array.size(lineHistory90_5) > 0
        line.delete(array.shift(lineHistory90_5))
        label.delete(array.shift(labelHistory90_5))
    while array.size(lineHistory90_6) > 0
        line.delete(array.shift(lineHistory90_6))
        label.delete(array.shift(labelHistory90_6))
    while array.size(lineHistory90_7) > 0
        line.delete(array.shift(lineHistory90_7))
        label.delete(array.shift(labelHistory90_7))
    
    // Clear all line and label history for 30-min cycle
    while array.size(lineHistory30_0) > 0
        line.delete(array.shift(lineHistory30_0))
        label.delete(array.shift(labelHistory30_0))
    while array.size(lineHistory30_1) > 0
        line.delete(array.shift(lineHistory30_1))
        label.delete(array.shift(labelHistory30_1))
    while array.size(lineHistory30_2) > 0
        line.delete(array.shift(lineHistory30_2))
        label.delete(array.shift(labelHistory30_2))
    while array.size(lineHistory30_3) > 0
        line.delete(array.shift(lineHistory30_3))
        label.delete(array.shift(labelHistory30_3))
    while array.size(lineHistory30_4) > 0
        line.delete(array.shift(lineHistory30_4))
        label.delete(array.shift(labelHistory30_4))
    while array.size(lineHistory30_5) > 0
        line.delete(array.shift(lineHistory30_5))
        label.delete(array.shift(labelHistory30_5))
    while array.size(lineHistory30_6) > 0
        line.delete(array.shift(lineHistory30_6))
        label.delete(array.shift(labelHistory30_6))
    while array.size(lineHistory30_7) > 0
        line.delete(array.shift(lineHistory30_7))
        label.delete(array.shift(labelHistory30_7))
    
    // Clear all line and label history for 10-min cycle
    while array.size(lineHistory10_0) > 0
        line.delete(array.shift(lineHistory10_0))
        label.delete(array.shift(labelHistory10_0))
    while array.size(lineHistory10_1) > 0
        line.delete(array.shift(lineHistory10_1))
        label.delete(array.shift(labelHistory10_1))
    while array.size(lineHistory10_2) > 0
        line.delete(array.shift(lineHistory10_2))
        label.delete(array.shift(labelHistory10_2))
    while array.size(lineHistory10_3) > 0
        line.delete(array.shift(lineHistory10_3))
        label.delete(array.shift(labelHistory10_3))
    while array.size(lineHistory10_4) > 0
        line.delete(array.shift(lineHistory10_4))
        label.delete(array.shift(labelHistory10_4))
    while array.size(lineHistory10_5) > 0
        line.delete(array.shift(lineHistory10_5))
        label.delete(array.shift(labelHistory10_5))
    while array.size(lineHistory10_6) > 0
        line.delete(array.shift(lineHistory10_6))
        label.delete(array.shift(labelHistory10_6))
    while array.size(lineHistory10_7) > 0
        line.delete(array.shift(lineHistory10_7))
        label.delete(array.shift(labelHistory10_7))
    
    // Clear all line and label history for 3-min cycle
    while array.size(lineHistory3_0) > 0
        line.delete(array.shift(lineHistory3_0))
        label.delete(array.shift(labelHistory3_0))
    while array.size(lineHistory3_1) > 0
        line.delete(array.shift(lineHistory3_1))
        label.delete(array.shift(labelHistory3_1))
    while array.size(lineHistory3_2) > 0
        line.delete(array.shift(lineHistory3_2))
        label.delete(array.shift(labelHistory3_2))
    while array.size(lineHistory3_3) > 0
        line.delete(array.shift(lineHistory3_3))
        label.delete(array.shift(labelHistory3_3))
    while array.size(lineHistory3_4) > 0
        line.delete(array.shift(lineHistory3_4))
        label.delete(array.shift(labelHistory3_4))
    while array.size(lineHistory3_5) > 0
        line.delete(array.shift(lineHistory3_5))
        label.delete(array.shift(labelHistory3_5))
    while array.size(lineHistory3_6) > 0
        line.delete(array.shift(lineHistory3_6))
        label.delete(array.shift(labelHistory3_6))
    while array.size(lineHistory3_7) > 0
        line.delete(array.shift(lineHistory3_7))
        label.delete(array.shift(labelHistory3_7))
    
    currentDay := dayofmonth(time)

// Check if on 1-minute or lower timeframe for 3-minute cycle
isValidTimeframeFor3Min = timeframe.in_seconds(timeframe.period) <= 60

if inSession()
    if not cycle90.active and enable90min
        startNewCycle(cycle90)
    if not cycle30.active and enable30min
        startNewCycle(cycle30)
    if not cycle10.active and enable10min
        startNewCycle(cycle10)
    if not cycle3.active and enable3min and isValidTimeframeFor3Min
        startNewCycle(cycle3)
    
    if enable90min and shouldCompleteCycle(cycle90, getCycleDuration(90))
        completeCycle(cycle90, prevCycles90)
    else if enable90min
        updateCycle(cycle90)
    
    if enable30min and shouldCompleteCycle(cycle30, getCycleDuration(30))
        completeCycle(cycle30, prevCycles30)
    else if enable30min
        updateCycle(cycle30)
    
    if enable10min and shouldCompleteCycle(cycle10, getCycleDuration(10))
        completeCycle(cycle10, prevCycles10)
    else if enable10min
        updateCycle(cycle10)
    
    if enable3min and isValidTimeframeFor3Min and shouldCompleteCycle(cycle3, getCycleDuration(3))
        completeCycle(cycle3, prevCycles3)
    else if enable3min and isValidTimeframeFor3Min
        updateCycle(cycle3)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════
processSMT90(cycle, prevCycles, timeLabel) =>
    alertTriggered = false
    alertMessage = ""
    
    if cycle.active and array.size(prevCycles) > 0
        CycleData[] smtCycles = array.new<CycleData>(8, na)
        array<int> cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(prevCycles) - 1
            prevCycle = array.get(prevCycles, i)
            bool cycleHasSMT = false
            
            // Check all SMT types for Symbol 1
            if enableSymbol1
                if na(array.get(smtCycles, 0)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 0, prevCycle)
                    cycleHasSMT := true
                    alertTriggered := true
                    alertMessage := "Bearish SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 1)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 1, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 4)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 4, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 5)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 5, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 90-min - " + getSymbolAbbr(symbol1)
            
            // Check all SMT types for Symbol 2
            if enableSymbol2
                if na(array.get(smtCycles, 2)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 2, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 3)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 3, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 6)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 6, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 7)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 7, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 90-min - " + getSymbolAbbr(symbol2)
            
            if not cycleHasSMT and array.size(prevCycles) > 3 and i < array.size(prevCycles) - 3
                array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(prevCycles, array.get(cyclesToRemove, i))
        
        // Draw/update all SMT types
        string[] labels = array.from("SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2))
        bool[] isEnabled = array.from(enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2, enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2)
        
        for idx = 0 to 7
            smtCycle = array.get(smtCycles, idx)
            if array.get(isEnabled, idx) and not na(smtCycle)
                isHigh = idx == 0 or idx == 2 or idx == 4 or idx == 6
