//@version=6
indicator("SMT V-1.01", "SMT Detector [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Comparison Symbols
enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="sym1")
symbol1 = input.symbol("MEXC:BTCUSDT.P", "", confirm=false, group="Comparison Symbols", inline="sym1")
enableSymbol2 = input.bool(false, "Enable Symbol 2", group="Comparison Symbols", inline="sym2")
symbol2 = input.symbol("ES1!", "", confirm=false, group="Comparison Symbols", inline="sym2")

// Cycle Settings
enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 90-minute cycle detection")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 30-minute cycle detection")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 10-minute cycle detection")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes", tooltip="Enable 3-minute cycle detection (only works on 1-minute or lower timeframes)")

// Session Filter
enableSession = input.bool(true, "Enable Session Filter", group="Session Filter", tooltip="Only detect SMT during specified session times")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter", tooltip="Trading session hours")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter", tooltip="Timezone for session filter")

// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
getSymbolAbbr(sym) =>
    parts = str.split(sym, ":")
    symbolPart = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    cleanSymbol = str.replace_all(str.replace_all(symbolPart, "1!", ""), "USDT", "")
    str.substring(cleanSymbol, 0, math.min(str.length(cleanSymbol), 6))

inSession() => not enableSession or not na(time(timeframe.period, sessionStart, sessionTimezone))

getCycleDuration(cycleMinutes) => cycleMinutes * 60 * 1000

// ═══════════════════════════════════════════════════════════════════════════════
//                              DATA FETCHING
// ═══════════════════════════════════════════════════════════════════════════════
[s1_high, s1_low, s1_close] = request.security(symbol1, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)
[s2_high, s2_low, s2_close] = request.security(symbol2, timeframe.period, [high, low, close], lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE TYPE
// ═══════════════════════════════════════════════════════════════════════════════
type CycleData
    int startTime
    int startBar
    float mainHigh
    float mainLow
    int mainHighBar
    int mainLowBar
    float s1High
    float s1Low
    int s1HighBar
    int s1LowBar
    float s2High
    float s2Low
    int s2HighBar
    int s2LowBar
    bool active

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
var cycle90 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle30 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle10 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)
var cycle3 = CycleData.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false)

var array<CycleData> prevCycles90 = array.new<CycleData>()
var array<CycleData> prevCycles30 = array.new<CycleData>()
var array<CycleData> prevCycles10 = array.new<CycleData>()
var array<CycleData> prevCycles3 = array.new<CycleData>()

var int currentDay = na

// Type to track line metadata
type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    float length

// Global line/label tracking - all SMT lines across all cycles
var array<LineMetadata> globalLineHistory = array.new<LineMetadata>(0)

int MAX_TOTAL_LINES = 4

// ═══════════════════════════════════════════════════════════════════════════════
//                              CORE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
startNewCycle(cycleData) =>
    cycleData.startTime := time
    cycleData.startBar := bar_index
    cycleData.mainHigh := high
    cycleData.mainLow := low
    cycleData.mainHighBar := bar_index
    cycleData.mainLowBar := bar_index
    cycleData.s1High := s1_high
    cycleData.s1Low := s1_low
    cycleData.s1HighBar := bar_index
    cycleData.s1LowBar := bar_index
    cycleData.s2High := s2_high
    cycleData.s2Low := s2_low
    cycleData.s2HighBar := bar_index
    cycleData.s2LowBar := bar_index
    cycleData.active := true

updateCycle(cycleData) =>
    if cycleData.active
        if high > cycleData.mainHigh
            cycleData.mainHigh := high
            cycleData.mainHighBar := bar_index
        if low < cycleData.mainLow
            cycleData.mainLow := low
            cycleData.mainLowBar := bar_index
        if enableSymbol1 and not na(s1_high)
            if s1_high > cycleData.s1High
                cycleData.s1High := s1_high
                cycleData.s1HighBar := bar_index
            if s1_low < cycleData.s1Low
                cycleData.s1Low := s1_low
                cycleData.s1LowBar := bar_index
        if enableSymbol2 and not na(s2_high)
            if s2_high > cycleData.s2High
                cycleData.s2High := s2_high
                cycleData.s2HighBar := bar_index
            if s2_low < cycleData.s2Low
                cycleData.s2Low := s2_low
                cycleData.s2LowBar := bar_index

completeCycle(cycleData, prevCyclesArray) =>
    savedCycle = CycleData.new(cycleData.startTime, cycleData.startBar, cycleData.mainHigh, cycleData.mainLow, cycleData.mainHighBar, cycleData.mainLowBar, cycleData.s1High, cycleData.s1Low, cycleData.s1HighBar, cycleData.s1LowBar, cycleData.s2High, cycleData.s2Low, cycleData.s2HighBar, cycleData.s2LowBar, true)
    array.push(prevCyclesArray, savedCycle)
    startNewCycle(cycleData)

shouldCompleteCycle(cycleData, cycleDuration) => cycleData.active and not na(cycleData.startTime) and (time - cycleData.startTime >= cycleDuration)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
detectBearishSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and mainCurr > mainPrev and compCurr < compPrev

detectBullishSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and mainCurr < mainPrev and compCurr > compPrev

detectBearishInverseSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and compCurr > compPrev and mainCurr < mainPrev

detectBullishInverseSMT(mainCurr, mainPrev, compCurr, compPrev) =>
    not na(mainCurr) and not na(mainPrev) and not na(compCurr) and not na(compPrev) and compCurr < compPrev and mainCurr > mainPrev

drawOrUpdateSMT(mainBar, mainPrice, compBar, compPrice, labelText, isBearish) =>
    line newLine = na
    label newLabel = na
    if not na(mainBar) and not na(compBar)
        // Calculate line length (Euclidean distance)
        barDiff = math.abs(compBar - mainBar)
        priceDiff = math.abs(compPrice - mainPrice)
        newLength = math.sqrt(barDiff * barDiff + priceDiff * priceDiff)
        
        // Check if there's an existing line in the same direction
        int indexToRemove = -1
        bool shouldAddLine = true
        if array.size(globalLineHistory) > 0
            for i = 0 to array.size(globalLineHistory) - 1
                metadata = array.get(globalLineHistory, i)
                if metadata.isBearish == isBearish
                    // Found a line in same direction, compare lengths
                    if metadata.length < newLength
                        // Existing line is shorter, mark for removal
                        indexToRemove := i
                    else
                        // Existing line is longer, don't add new line
                        shouldAddLine := false
        
        if shouldAddLine
            // Remove the shorter line if found
            if indexToRemove >= 0
                oldMetadata = array.remove(globalLineHistory, indexToRemove)
                line.delete(oldMetadata.lineObj)
                label.delete(oldMetadata.labelObj)
            
            // Create new line and label
            newLine := line.new(mainBar, mainPrice, compBar, compPrice, color=color.black, width=1, style=line.style_solid)
            
            // Position label on the right side of the line (rightmost bar)
            labelBar = math.max(mainBar, compBar)
            labelPrice = mainBar > compBar ? mainPrice : compPrice
            
            // Position text above price for bearish, below price for bullish
            textYloc = isBearish ? yloc.abovebar : yloc.belowbar
            
            newLabel := label.new(labelBar, labelPrice, labelText, style=label.style_none, color=color.black, textcolor=color.black, size=size.small, yloc=textYloc, xloc=xloc.bar_index)
            
            // Create metadata and add to global history
            metadata = LineMetadata.new(newLine, newLabel, isBearish, newLength)
            array.push(globalLineHistory, metadata)
            
            // Remove oldest if exceeds global limit
            if array.size(globalLineHistory) > MAX_TOTAL_LINES
                oldMetadata = array.shift(globalLineHistory)
                if not na(oldMetadata.lineObj)
                    line.delete(oldMetadata.lineObj)
                if not na(oldMetadata.labelObj)
                    label.delete(oldMetadata.labelObj)
    [newLine, newLabel]

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════
newDay = dayofmonth(time) != dayofmonth(time[1])
if newDay and not na(time[1])
    array.clear(prevCycles90)
    array.clear(prevCycles30)
    array.clear(prevCycles10)
    array.clear(prevCycles3)
    
    // Reset active cycles to prevent cross-day comparisons
    cycle90.active := false
    cycle30.active := false
    cycle10.active := false
    cycle3.active := false
    
    // Clear all global line and label history
    while array.size(globalLineHistory) > 0
        metadata = array.shift(globalLineHistory)
        line.delete(metadata.lineObj)
        label.delete(metadata.labelObj)
    
    currentDay := dayofmonth(time)

// Check if on 1-minute or lower timeframe for 3-minute cycle
isValidTimeframeFor3Min = timeframe.in_seconds(timeframe.period) <= 60

if inSession()
    if not cycle90.active and enable90min
        startNewCycle(cycle90)
    if not cycle30.active and enable30min
        startNewCycle(cycle30)
    if not cycle10.active and enable10min
        startNewCycle(cycle10)
    if not cycle3.active and enable3min and isValidTimeframeFor3Min
        startNewCycle(cycle3)
    
    if enable90min and shouldCompleteCycle(cycle90, getCycleDuration(90))
        completeCycle(cycle90, prevCycles90)
    else if enable90min
        updateCycle(cycle90)
    
    if enable30min and shouldCompleteCycle(cycle30, getCycleDuration(30))
        completeCycle(cycle30, prevCycles30)
    else if enable30min
        updateCycle(cycle30)
    
    if enable10min and shouldCompleteCycle(cycle10, getCycleDuration(10))
        completeCycle(cycle10, prevCycles10)
    else if enable10min
        updateCycle(cycle10)
    
    if enable3min and isValidTimeframeFor3Min and shouldCompleteCycle(cycle3, getCycleDuration(3))
        completeCycle(cycle3, prevCycles3)
    else if enable3min and isValidTimeframeFor3Min
        updateCycle(cycle3)

// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════
processSMT90(cycle, prevCycles, timeLabel) =>
    alertTriggered = false
    alertMessage = ""
    
    if cycle.active and array.size(prevCycles) > 0
        CycleData[] smtCycles = array.new<CycleData>(8, na)
        array<int> cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(prevCycles) - 1
            prevCycle = array.get(prevCycles, i)
            bool cycleHasSMT = false
            
            // Check all SMT types for Symbol 1
            if enableSymbol1
                if na(array.get(smtCycles, 0)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 0, prevCycle)
                    cycleHasSMT := true
                    alertTriggered := true
                    alertMessage := "Bearish SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 1)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 1, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 4)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 4, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 90-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 5)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 5, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 90-min - " + getSymbolAbbr(symbol1)
            
            // Check all SMT types for Symbol 2
            if enableSymbol2
                if na(array.get(smtCycles, 2)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 2, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 3)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 3, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 6)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 6, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 90-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 7)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 7, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 90-min - " + getSymbolAbbr(symbol2)
            
            if not cycleHasSMT and array.size(prevCycles) > 3 and i < array.size(prevCycles) - 3
                array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(prevCycles, array.get(cyclesToRemove, i))
        
        // Draw/update all SMT types
        string[] labels = array.from("SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2))
        bool[] isEnabled = array.from(enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2, enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2)
        
        for idx = 0 to 7
            smtCycle = array.get(smtCycles, idx)
            if array.get(isEnabled, idx) and not na(smtCycle)
                isHigh = idx == 0 or idx == 2 or idx == 4 or idx == 6
                isBearish = idx == 0 or idx == 2 or idx == 4 or idx == 6
                mainBar = isHigh ? smtCycle.mainHighBar : smtCycle.mainLowBar
                mainPrice = isHigh ? smtCycle.mainHigh : smtCycle.mainLow
                currBar = isHigh ? cycle.mainHighBar : cycle.mainLowBar
                currPrice = isHigh ? cycle.mainHigh : cycle.mainLow
                drawOrUpdateSMT(mainBar, mainPrice, currBar, currPrice, array.get(labels, idx) + " " + timeLabel, isBearish)
    
    // Trigger alert if SMT detected
    if alertTriggered
        alert(alertMessage, alert.freq_once_per_bar)
    
    alertTriggered

processSMT90(cycle90, prevCycles90, "90")

processSMT30(cycle, prevCycles, timeLabel) =>
    alertTriggered = false
    alertMessage = ""
    
    if cycle.active and array.size(prevCycles) > 0
        CycleData[] smtCycles = array.new<CycleData>(8, na)
        array<int> cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(prevCycles) - 1
            prevCycle = array.get(prevCycles, i)
            bool cycleHasSMT = false
            
            if enableSymbol1
                if na(array.get(smtCycles, 0)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 0, prevCycle)
                    cycleHasSMT := true
                    alertTriggered := true
                    alertMessage := "Bearish SMT 30-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 1)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 1, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 30-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 4)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 4, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 30-min - " + getSymbolAbbr(symbol1)
                if na(array.get(smtCycles, 5)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 5, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 30-min - " + getSymbolAbbr(symbol1)
            
            if enableSymbol2
                if na(array.get(smtCycles, 2)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 2, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish SMT 30-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 3)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 3, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish SMT 30-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 6)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 6, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bearish Inverse SMT 30-min - " + getSymbolAbbr(symbol2)
                if na(array.get(smtCycles, 7)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 7, prevCycle)
                    cycleHasSMT := true
                    if not alertTriggered
                        alertTriggered := true
                        alertMessage := "Bullish Inverse SMT 30-min - " + getSymbolAbbr(symbol2)
            
            if not cycleHasSMT and array.size(prevCycles) > 3 and i < array.size(prevCycles) - 3
                array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(prevCycles, array.get(cyclesToRemove, i))
        
        string[] labels = array.from("SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2))
        bool[] isEnabled = array.from(enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2, enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2)
        
        for idx = 0 to 7
            smtCycle = array.get(smtCycles, idx)
            if array.get(isEnabled, idx) and not na(smtCycle)
                isHigh = idx == 0 or idx == 2 or idx == 4 or idx == 6
                isBearish = idx == 0 or idx == 2 or idx == 4 or idx == 6
                mainBar = isHigh ? smtCycle.mainHighBar : smtCycle.mainLowBar
                mainPrice = isHigh ? smtCycle.mainHigh : smtCycle.mainLow
                currBar = isHigh ? cycle.mainHighBar : cycle.mainLowBar
                currPrice = isHigh ? cycle.mainHigh : cycle.mainLow
                drawOrUpdateSMT(mainBar, mainPrice, currBar, currPrice, array.get(labels, idx) + " " + timeLabel, isBearish)
    
    // Trigger alert if SMT detected
    if alertTriggered
        alert(alertMessage, alert.freq_once_per_bar)
    
    alertTriggered

processSMT30(cycle30, prevCycles30, "30")

processSMT10(cycle, prevCycles, timeLabel) =>
    if cycle.active and array.size(prevCycles) > 0
        CycleData[] smtCycles = array.new<CycleData>(8, na)
        array<int> cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(prevCycles) - 1
            prevCycle = array.get(prevCycles, i)
            bool cycleHasSMT = false
            
            if enableSymbol1
                if na(array.get(smtCycles, 0)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 0, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 1)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 1, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 4)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 4, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 5)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 5, prevCycle)
                    cycleHasSMT := true
            
            if enableSymbol2
                if na(array.get(smtCycles, 2)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 2, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 3)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 3, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 6)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 6, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 7)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 7, prevCycle)
                    cycleHasSMT := true
            
            if not cycleHasSMT and array.size(prevCycles) > 3 and i < array.size(prevCycles) - 3
                array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(prevCycles, array.get(cyclesToRemove, i))
        
        string[] labels = array.from("SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2))
        bool[] isEnabled = array.from(enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2, enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2)
        
        for idx = 0 to 7
            smtCycle = array.get(smtCycles, idx)
            if array.get(isEnabled, idx) and not na(smtCycle)
                isHigh = idx == 0 or idx == 2 or idx == 4 or idx == 6
                isBearish = idx == 0 or idx == 2 or idx == 4 or idx == 6
                mainBar = isHigh ? smtCycle.mainHighBar : smtCycle.mainLowBar
                mainPrice = isHigh ? smtCycle.mainHigh : smtCycle.mainLow
                currBar = isHigh ? cycle.mainHighBar : cycle.mainLowBar
                currPrice = isHigh ? cycle.mainHigh : cycle.mainLow
                drawOrUpdateSMT(mainBar, mainPrice, currBar, currPrice, array.get(labels, idx) + " " + timeLabel, isBearish)

processSMT10(cycle10, prevCycles10, "10")

processSMT3(cycle, prevCycles, timeLabel) =>
    if cycle.active and array.size(prevCycles) > 0
        CycleData[] smtCycles = array.new<CycleData>(8, na)
        array<int> cyclesToRemove = array.new<int>()
        
        for i = 0 to array.size(prevCycles) - 1
            prevCycle = array.get(prevCycles, i)
            bool cycleHasSMT = false
            
            if enableSymbol1
                if na(array.get(smtCycles, 0)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 0, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 1)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 1, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 4)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s1High, prevCycle.s1High)
                    array.set(smtCycles, 4, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 5)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s1Low, prevCycle.s1Low)
                    array.set(smtCycles, 5, prevCycle)
                    cycleHasSMT := true
            
            if enableSymbol2
                if na(array.get(smtCycles, 2)) and detectBearishSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 2, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 3)) and detectBullishSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 3, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 6)) and detectBearishInverseSMT(cycle.mainHigh, prevCycle.mainHigh, cycle.s2High, prevCycle.s2High)
                    array.set(smtCycles, 6, prevCycle)
                    cycleHasSMT := true
                if na(array.get(smtCycles, 7)) and detectBullishInverseSMT(cycle.mainLow, prevCycle.mainLow, cycle.s2Low, prevCycle.s2Low)
                    array.set(smtCycles, 7, prevCycle)
                    cycleHasSMT := true
            
            if not cycleHasSMT and array.size(prevCycles) > 3 and i < array.size(prevCycles) - 3
                array.push(cyclesToRemove, i)
        
        if array.size(cyclesToRemove) > 0
            for i = array.size(cyclesToRemove) - 1 to 0
                array.remove(prevCycles, array.get(cyclesToRemove, i))
        
        string[] labels = array.from("SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol1), "SMT-" + getSymbolAbbr(symbol2), "SMT-" + getSymbolAbbr(symbol2))
        bool[] isEnabled = array.from(enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2, enableSymbol1, enableSymbol1, enableSymbol2, enableSymbol2)
        
        for idx = 0 to 7
            smtCycle = array.get(smtCycles, idx)
            if array.get(isEnabled, idx) and not na(smtCycle)
                isHigh = idx == 0 or idx == 2 or idx == 4 or idx == 6
                isBearish = idx == 0 or idx == 2 or idx == 4 or idx == 6
                mainBar = isHigh ? smtCycle.mainHighBar : smtCycle.mainLowBar
                mainPrice = isHigh ? smtCycle.mainHigh : smtCycle.mainLow
                currBar = isHigh ? cycle.mainHighBar : cycle.mainLowBar
                currPrice = isHigh ? cycle.mainHigh : cycle.mainLow
                drawOrUpdateSMT(mainBar, mainPrice, currBar, currPrice, array.get(labels, idx) + " " + timeLabel, isBearish)

if isValidTimeframeFor3Min
    processSMT3(cycle3, prevCycles3, "3")
