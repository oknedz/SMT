//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SMT V-4.0 - SMT Divergence Detector
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Description:
//      Advanced SMT divergence detector that tracks and
//      compares price action across multiple correlated symbols in real-time.
//      Identifies divergences between main chart and comparison symbols across
//      multiple time cycles (90min, 30min, 10min & 3min) to spot potential reversal points.
//
//  Key Features:
//      • Real-time cycle high/low tracking with dynamic line updates
//      • Multi-symbol comparison (up to 2 additional symbols)
//      • 4 independent time cycles (90min, 30min, 10min, 3min)
//      • 8 SMT detection types (Normal & Inverse for Bullish/Bearish)
//      • Combined symbol labels when multiple SMTs align
//      • Session-based filtering with timezone support
//      • Automatic invalidation of broken SMT patterns
//      • Smart symbol abbreviation for clean chart display
//
//  Use Cases:
//      • Identify divergences between correlated futures (ES, NQ, BTC, EUR, JPY, GBP, etc)
//      • Spot institutional order flow differences
//      • Find high-probability reversal zones
//      • Confirm trend strength across multiple timeframes
//      • Detect smart money vs retail money positioning
//
//  Version: 4.0
//  Author: StoneFace / StoneFace_Trading
//  Release Date: Jan. 23. 2026
//  
//  © 2025. Stoneface. All rights reserved.
//  This source code is protected. Unauthorized distribution or modification
//  is strictly prohibited.
//
// ═══════════════════════════════════════════════════════════════════════════════

indicator("SMT V-4.0 - SMT Detector", 
     shorttitle="SMT V-4.0 [StoneFace]", 
     overlay=true, 
     max_lines_count=500, 
     max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//                              INPUTS & SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
//
//  COMPARISON SYMBOLS:
//      Select up to 2 symbols to compare against your main chart. 
//      Best results with correlated assets (e.g., ES vs NQ, BTC vs ETH).
//      Use continuous contracts (ES1!, NQ1!) or specific contract months.
//
//  CYCLE TIMEFRAMES:
//      Enable cycles based on your trading timeframe:
//      • 90-min: Swing trading, higher timeframe confirmation
//      • 30-min: Intraday trends, session-based setups
//      • 10-min: Scalping entries, precise timing
//      • 3-min: Ultra-short-term, quick reversals (1-min chart recommended)
//
//  SESSION FILTER:
//      Limit detection to specific trading sessions (e.g., NYSE hours).
//      Helps avoid low-volume periods and reduces false signals.
//
//  DISPLAY:
//      Max Total SMT Lines controls chart clutter. Higher values show more
//      historical SMTs but may make chart harder to read.
//
// ═══════════════════════════════════════════════════════════════════════════════

// Auto-detect MNQ contract suffix or use manual inputs
autoDetectContracts = input.bool(true, "Auto-Detect Contracts", group="Comparison Symbols", tooltip="Automatically set MES/MYM with matching contract month when on MNQ chart")

getContractSuffix(ticker) =>
    // Extract suffix after removing exchange prefix
    parts = str.split(ticker, ":")
    cleanTicker = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    
    // Look for MNQ pattern and extract suffix (e.g., MNQH2025 -> H2025)
    if str.contains(cleanTicker, "MNQ")
        suffixStart = str.pos(cleanTicker, "MNQ") + 3
        str.substring(cleanTicker, suffixStart)
    else
        na

contractSuffix = getContractSuffix(syminfo.ticker)
autoSymbol1 = na(contractSuffix) ? na : "MES" + contractSuffix
autoSymbol2 = na(contractSuffix) ? na : "MYM" + contractSuffix

manualSymbol1 = input.symbol("CME_MINI:MES1!", "Symbol 1", confirm=false, group="Comparison Symbols", inline="sym1")
manualSymbol2 = input.symbol("CBOT_MINI:MYM1!", "Symbol 2", confirm=false, group="Comparison Symbols", inline="sym2")

symbol1 = autoDetectContracts and not na(autoSymbol1) ? autoSymbol1 : manualSymbol1
symbol2 = autoDetectContracts and not na(autoSymbol2) ? autoSymbol2 : manualSymbol2

enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="en1")
enableSymbol2 = input.bool(true, "Enable Symbol 2", group="Comparison Symbols", inline="en2")

enable90min = input.bool(true, "90-Minute Cycle", group="Cycle Timeframes", inline="c90")
lineStyle90min = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], group="Cycle Timeframes", inline="c90")
enable30min = input.bool(true, "30-Minute Cycle", group="Cycle Timeframes", inline="c30")
lineStyle30min = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Cycle Timeframes", inline="c30")
enable10min = input.bool(true, "10-Minute Cycle", group="Cycle Timeframes", inline="c10")
lineStyle10min = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Cycle Timeframes", inline="c10")
enable3min = input.bool(true, "3-Minute Cycle", group="Cycle Timeframes", inline="c3")
lineStyle3min = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Cycle Timeframes", inline="c3")

enableDaily = input.bool(true, "Daily Cycle (D)", group="Long Term Cycles", inline="cD")
enableWeekly = input.bool(true, "Weekly Cycle (W)", group="Long Term Cycles", inline="cW")
enableMonthly = input.bool(true, "Monthly Cycle (M)", group="Long Term Cycles", inline="cM")
enableYearly = input.bool(true, "Yearly Cycle (Y)", group="Long Term Cycles", inline="cY")

enableSession = input.bool(true, "Enable Session Filter", group="Session Filter")
sessionStart = input.session("0230-1600", "Session Time", group="Session Filter")
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London"], group="Session Filter")

// ═══════════════════════════════════════════════════════════════════════════════
//                            SESSION SMT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
enableSessionSMT = input.bool(true, "Enable Session SMT Detection", group="Session SMT")
showAsiaSession = input.bool(true, "Show Asia Session SMTs", group="Session SMT")
showLondonSession = input.bool(true, "Show London Session SMTs", group="Session SMT")
showNYSession = input.bool(true, "Show NY Session SMTs", group="Session SMT")
showNYPMSession = input.bool(true, "Show NY PM Session SMTs", group="Session SMT")
maxSessionSMTs = input.int(3, "Max Session SMTs per Session", minval=1, maxval=10, group="Session SMT")

maxTotalLines = input.int(4, "Max Total SMT Lines", minval=1, maxval=20, group="Display")
enableOldSmtDeletion = input.bool(true, "Delete Old SMTs", group="Display")
enable369Ids = input.bool(true, "Enable 369 SMTs", group="Display")
max369Lines = input.int(10, "Max 369 SMT Lines", minval=1, maxval=50, tooltip="Maximum number of 369 SMT lines to display. 369 SMTs are tracked separately from regular SMTs.", group="Display")
labelOffset = input.int(25, "Label Offset (Pips/Points)", minval=5, maxval=500, tooltip="Distance of labels from SMT lines. Uses mintick multiplication (25 = 2.5 pips for forex, ~6.25 pts for NQ/ES)", group="Display")
bullishSmtColor = input.color(color.rgb(74, 150, 98), "Bullish SMT", group="Display")
bearishSmtColor = input.color(color.rgb(148, 43, 43), "Bearish SMT", group="Display")

// ═══════════════════════════════════════════════════════════════════════════════
//                    SWING HIGH / LOW DETECTION SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
enableSwingDetection = input.bool(false, "Enable Swing Detection", group="Swing Detection",
  tooltip="Detect 3-candle swing highs/lows on target minutes with colored dots")



// ═══════════════════════════════════════════════════════════════════════════════
//                              TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type IntArray
    array<int> values

type PivotPoint
    float price
    int barIndex
    int time
    int dayId            // trading-day id of the bar that produced `time` (== getDayId(time))
    int num369           // 369 numerology of that bar in the session timezone (== get369(time))

type CycleData
    int startTime
    int startBar
    PivotPoint mainPivotHigh
    PivotPoint mainPivotLow
    PivotPoint s1PivotHigh
    PivotPoint s1PivotLow
    PivotPoint s2PivotHigh
    PivotPoint s2PivotLow
    bool active
    int startCycleId     // cycleIdFromMins(start bar) - constant for the life of the cycle
    int startDayId       // NY y*10000+m*100+d of the start bar (calendar cycles)
    int startWeekId      // NY y*100+w of the start bar
    int startMonthId     // NY y*100+m of the start bar
    int startYear        // NY year of the start bar

type CycleManager
    int duration
    string label
    CycleData current
    array<CycleData> history

type LineMetadata
    line lineObj
    label labelObj
    bool isBearish
    int smtTypeId
    float mainPrice
    float compPrice
    string symbols
    string cycleLabel
    int historyCycleStart
    bool isForCurrentCycle
    int num369
    int mgrIdx           // index into `managers`; -1 for session SMTs
    int cycleOrder       // cached getStackOrder(cycleLabel)
    int x1               // mirror of the line's x1 (xloc.bar_time)
    float y1
    int x2               // mirror of the line's x2
    float y2
    string key1          // cached repositionAllLabels() pass-1 key
    string x2Str         // cached str.tostring(x2)
    string labTxt        // last text written to labelObj
    float labX           // last x written to labelObj
    float labY           // last y written to labelObj

type DailySession
    string name
    string sessionTime
    string timezone
    bool enabled
    CycleData data


// ═══════════════════════════════════════════════════════════════════════════════
//                              GLOBAL STATE
// ═══════════════════════════════════════════════════════════════════════════════

// FIXED: Use ticker.standard() to normalize ticker IDs and remove session modifiers
// This ensures compatibility with both continuous contracts (NQ1!) and monthly contracts (MNQZ2024)
// ticker.standard() strips extended session data, modifiers, etc. that can cause issues
s1_normalized = ticker.standard(symbol1)
s2_normalized = ticker.standard(symbol2)

// Use gaps_off to automatically handle missing data (replaces manual latching)
// `close` is never read from the comparison symbols, so it is not requested
[s1_high, s1_low] = request.security(s1_normalized, timeframe.period, [high, low], barmerge.gaps_off, barmerge.lookahead_off)
[s2_high, s2_low] = request.security(s2_normalized, timeframe.period, [high, low], barmerge.gaps_off, barmerge.lookahead_off)

// Bar times with gaps_on: na when the comparison symbol has no candle at this bar
s1_bar_time = request.security(s1_normalized, timeframe.period, time, barmerge.gaps_on, barmerge.lookahead_off)
s2_bar_time = request.security(s2_normalized, timeframe.period, time, barmerge.gaps_on, barmerge.lookahead_off)

var array<CycleManager> managers = array.new<CycleManager>()
// Manager label -> index in `managers` (1:1; built once on the first bar)
var map<string, int> mgrIdxByLabel = map.new<string, int>()

// Label spacing using fixed points/pips based on user input
// For forex (5-digit brokers): syminfo.mintick = 0.00001, so 50 = 5 pips
// For indices/crypto: syminfo.mintick varies, this adapts automatically
// Both are constant for the life of the run (input x mintick), so they are cached
var float labelBaseOffset = labelOffset * syminfo.mintick  // User-defined base offset from line
var float labelStackSpacing = (labelOffset * 0.3) * syminfo.mintick  // 30% of base for stack spacing
var array<LineMetadata> lines = array.new<LineMetadata>()
var array<DailySession> dailySessions = array.new<DailySession>()
var int lastDay = na
var string s1Abbr = ""
var string s2Abbr = ""

// OPTIMIZATION: Pre-cache line styles and constants
var line_style_90 = line.style_solid
var line_style_30 = line.style_solid
var line_style_10 = line.style_solid
var line_style_3 = line.style_solid
s1Enabled = enableSymbol1
s2Enabled = enableSymbol2



// Reposition flag. Functions cannot assign script globals in Pine, so every
// mutating function reports through its return value and this flag is set at the
// call site. (Replaces the single-element `stateFlags` array.)
bool needReposition = false

// ── Per-bar time cache ────────────────────────────────────────────────────────
// Timezone conversions are the dominant per-bar cost of this script (~76/bar in
// V-4.0). Every cycle/calendar/369/GBT decision reads these instead of calling
// hour()/minute()/year()/… again.
nyH   = hour(time, "America/New_York")
nyMin = minute(time, "America/New_York")
nyY   = year(time, "America/New_York")
nyMo  = month(time, "America/New_York")
nyD   = dayofmonth(time, "America/New_York")
nyTotalMins = nyH * 60 + nyMin

// Session-timezone clock reading. When the input already is New York the NY
// values are reused instead of paying two more conversions.
var int sessH = 0
var int sessM = 0
if sessionTimezone == "America/New_York"
    sessH := nyH
    sessM := nyMin
else
    sessH := hour(time, sessionTimezone)
    sessM := minute(time, sessionTimezone)

// NY week number — only the weekly cycle reads it.
var int nyWeek = 0
if enableWeekly
    nyWeek := weekofyear(time, "America/New_York")

// Trading day: futures true-day open is 18:00 NY (the counter rolls to tomorrow).
currentDay = nyH >= 18 ? (nyY * 10000 + nyMo * 100 + nyD + 1) : (nyY * 10000 + nyMo * 100 + nyD)



// ═══════════════════════════════════════════════════════════════════════════════
//                              HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

getAbbr(sym) =>
    parts = str.split(sym, ":")
    ticker = array.size(parts) > 1 ? array.get(parts, 1) : array.get(parts, 0)
    
    // Remove common suffixes
    clean = str.replace_all(str.replace_all(str.replace_all(ticker, "USDT", ""), ".P", ""), "USD", "")
    
    // Check if it ends with 1! (futures like ES1!, NQ1!)
    if str.contains(clean, "1!")
        clean := str.replace_all(clean, "1!", "")
        // For indices ending in 1!, take first 2-3 chars (ES, NQ, YM, etc)
        // Check for Micros (MES, MNQ, MYM, M2K)
        if str.length(clean) == 3 and str.startswith(clean, "M")
            // Strip 'M' to show underlying asset (ES, NQ, YM)
            str.substring(clean, 1, 3)
        else
            str.substring(clean, 0, math.min(str.length(clean), 3))
    else
        // Check for monthly contract codes (H, M, U, Z followed by year)
        // Examples: MESH2025, MYMH2025, MNQZ2024
        hasMonthCode = false
        monthCodePos = -1
        
        // Check for common month codes: F, G, H, J, K, M, N, Q, U, V, X, Z
        if str.contains(clean, "H") or str.contains(clean, "M") or str.contains(clean, "U") or str.contains(clean, "Z") or str.contains(clean, "F") or str.contains(clean, "G") or str.contains(clean, "J") or str.contains(clean, "K") or str.contains(clean, "N") or str.contains(clean, "Q") or str.contains(clean, "V") or str.contains(clean, "X")
            // Find position of month code (usually 3rd or 4th character)
            len = str.length(clean)
            for i = 2 to math.min(4, len - 1)
                char = str.substring(clean, i, i + 1)
                if char == "H" or char == "M" or char == "U" or char == "Z" or char == "F" or char == "G" or char == "J" or char == "K" or char == "N" or char == "Q" or char == "V" or char == "X"
                    // Check if next character is a digit (year)
                    if i + 1 < len
                        nextChar = str.substring(clean, i + 1, i + 2)
                        if nextChar == "1" or nextChar == "2" or nextChar == "3" or nextChar == "4" or nextChar == "5" or nextChar == "6" or nextChar == "7" or nextChar == "8" or nextChar == "9" or nextChar == "0"
                            hasMonthCode := true
                            monthCodePos := i
                            break
        
        if hasMonthCode and monthCodePos > 0
            // Extract base symbol before month code (e.g., MES, MYM, MNQ)
            baseSymbol = str.substring(clean, 0, monthCodePos)
            // Remove leading M for micro contracts (MES -> ES, MYM -> YM, MNQ -> NQ)
            if str.length(baseSymbol) == 3 and str.substring(baseSymbol, 0, 1) == "M"
                str.substring(baseSymbol, 1, 3)
            else
                baseSymbol
        else
            // For other symbols (BTCUSDT, ETH, TOTAL, etc), return the full cleaned name so labels aren't truncated
            clean

// Convert line style string to constant
getLineStyle(styleStr) =>
    styleStr == "Dashed" ? line.style_dashed : (styleStr == "Dotted" ? line.style_dotted : line.style_solid)

// Helper to sum digits and reduce to digital root
reduceDigits(n) =>
    val = n
    if val > 9
        val := math.floor(val / 10) + (val % 10)
    if val > 9
        val := math.floor(val / 10) + (val % 10)
    val

// Calculate 369 numerology from a session-timezone clock reading
// (== get369(t) for any chart bar time t, without the timezone conversions)
// Priority: 1. Minutes only sum, 2. Hour+Minutes sum
// Returns 3, 6, or 9 if applicable, otherwise returns 0
get369FromHM(int h, int m) =>
    // 1. Full Time Sum (HH + MM digits)
    sumHHMM = reduceDigits(math.floor(h / 10) + (h % 10) + math.floor(m / 10) + (m % 10))
    
    // 2. Minutes Only Sum
    sumMM = reduceDigits(m)
    
    // Result logic: prioritize Minutes Only (:MM) result
    res = 0
    if sumMM == 3 or sumMM == 6 or sumMM == 9
        res := sumMM
    else if sumHHMM == 3 or sumHHMM == 6 or sumHHMM == 9
        res := sumHHMM
    res

// NOTE: inSession()/isMonthlyContract() and calcLen() were deleted in V-4.1 —
// neither had a live effect (inSession() had no caller; calcLen() only fed
// `LineMetadata.length`, which nothing ever read). The `Enable Session Filter` /
// `Session Time` inputs stay declared so the settings panel is unchanged.
createPivot(float price, int barIdx, int t) =>
    PivotPoint.new(price, barIdx, t, 0, 0)

// Rebuild the cached grouping keys after a line's coordinates change
// (repositionAllLabels() builds its three grouping maps from these).
refreshLineKeys(LineMetadata m) =>
    m.x2Str := str.tostring(m.x2)
    m.key1 := str.tostring(m.x1) + "_" + m.x2Str + "_" + m.cycleLabel + "_" + (m.isBearish ? "1" : "0")

// Stack Order Helper
getStackOrder(lbl) =>
    lbl == "Y" ? 0 : (lbl == "M" ? 1 : (lbl == "W" ? 2 : (lbl == "D" ? 3 : (lbl == "90" ? 4 : (lbl == "30" ? 5 : (lbl == "10" ? 6 : (lbl == "3" ? 7 : 8)))))))


// Strict Cycle Timing Helper
// Cycle slot id for a NY minutes-of-day value.
cycleIdFromMins(int totalMins, int duration) =>
    // All cycles align to 02:30 NY time
    // Return unique ID for specific cycle slot
    // ID = (Minutes from 02:30) / duration
    
    // Dual Anchor Logic:
    // Asia Session (18:00 - 00:00 NY): Anchor at 18:00 (1080 mins)
    // Day Session (02:30 - 18:00 NY): Anchor at 02:30 (150 mins)
    // Gap Period (00:00 - 02:30 NY): Start fresh, align to 00:00 or treat as Gap.
    // However, the critical rule is NO OVERLAP at 02:30.
    
    int anchorMins = 0
    
    // Day Session Block: 02:30 to 18:00
    if totalMins >= 150 and totalMins < 1080
        anchorMins := 150 // 02:30 Anchor
    else
        // Asia / Gap Block: 18:00 to 02:30 (starts at 1080)
        anchorMins := 1080 // 18:00 Anchor
        
    // Calculate raw minutes from anchor
    // If calculated mins is negative (e.g., 01:00 vs 18:00), we add 24h (1440m) to normalize
    minsFromAnchor = totalMins - anchorMins
    if minsFromAnchor < 0
        minsFromAnchor += 1440
        
    // Return Cycle ID
    math.floor(minsFromAnchor / duration)


//                              INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

initCycleData() =>
    CycleData.new(na, na, createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), createPivot(na, na, na), false, 0, 0, 0, 0, 0)

initDailySession(name, sessionTime, timezone, enabled) =>
    DailySession.new(name, sessionTime, timezone, enabled, initCycleData())


if barstate.isfirst
    // Intraday Cycles
    if enable90min
        array.push(managers, CycleManager.new(90, "90", initCycleData(), array.new<CycleData>()))
    if enable30min
        array.push(managers, CycleManager.new(30, "30", initCycleData(), array.new<CycleData>()))
    if enable10min
        array.push(managers, CycleManager.new(10, "10", initCycleData(), array.new<CycleData>()))
    if enable3min and timeframe.in_seconds(timeframe.period) <= 60
        array.push(managers, CycleManager.new(3, "3", initCycleData(), array.new<CycleData>()))
    
    // Calendar Cycles
    if enableDaily
        array.push(managers, CycleManager.new(-1, "D", initCycleData(), array.new<CycleData>()))
    if enableWeekly
        array.push(managers, CycleManager.new(-2, "W", initCycleData(), array.new<CycleData>()))
    if enableMonthly
        array.push(managers, CycleManager.new(-3, "M", initCycleData(), array.new<CycleData>()))
    if enableYearly
        array.push(managers, CycleManager.new(-4, "Y", initCycleData(), array.new<CycleData>()))
    
    // Initialize daily sessions - sequential progression
    array.push(dailySessions, initDailySession("ASIA", "1800-0230", "America/New_York", showAsiaSession))
    array.push(dailySessions, initDailySession("LONDON", "0230-0700", "America/New_York", showLondonSession))
    array.push(dailySessions, initDailySession("NY-AM", "0700-1130", "America/New_York", showNYSession))
    array.push(dailySessions, initDailySession("NY-PM", "1130-1600", "America/New_York", showNYPMSession))
    
    s1Abbr := getAbbr(symbol1)
    s2Abbr := getAbbr(symbol2)
    
    // OPTIMIZATION: Cache line styles once
    line_style_90 := getLineStyle(lineStyle90min)
    line_style_30 := getLineStyle(lineStyle30min)
    line_style_10 := getLineStyle(lineStyle10min)
    line_style_3 := getLineStyle(lineStyle3min)
    // s1Enabled / s2Enabled are now updated every bar (not cached via var)
    
    // Index managers by label once (used by drawSMT/checkInvalidation/updateExistingLines)
    for i = 0 to array.size(managers) - 1
        map.put(mgrIdxByLabel, array.get(managers, i).label, i)

// ═══════════════════════════════════════════════════════════════════════════════
//                              CYCLE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

startCycle(CycleData c, int dur) =>
    c.startTime := time
    c.startBar := bar_index
    c.mainPivotHigh := createPivot(na, na, na)
    c.mainPivotLow := createPivot(na, na, na)
    c.s1PivotHigh := createPivot(na, na, na)
    c.s1PivotLow := createPivot(na, na, na)
    c.s2PivotHigh := createPivot(na, na, na)
    c.s2PivotLow := createPivot(na, na, na)
    c.active := true
    // Cycle-slot / calendar ids of the start bar. Constant for the whole cycle,
    // so they are computed once here instead of being re-derived from
    // c.startTime on every bar inside shouldComplete().
    c.startCycleId := dur > 0 ? cycleIdFromMins(nyTotalMins, dur) : 0
    c.startDayId := nyY * 10000 + nyMo * 100 + nyD
    c.startWeekId := nyY * 100 + nyWeek
    c.startMonthId := nyY * 100 + nyMo
    c.startYear := nyY

updatePivots(CycleData c) =>
    if c.active
        // Track main symbol extremes. Guard order is na-first so the `or` short-circuits
        // on the very first assignment of a cycle (na compares false otherwise).
        if na(c.mainPivotHigh.price) or high > c.mainPivotHigh.price
            c.mainPivotHigh.price := high
            c.mainPivotHigh.barIndex := bar_index
            c.mainPivotHigh.time := time
            c.mainPivotHigh.dayId := currentDay
            c.mainPivotHigh.num369 := get369FromHM(sessH, sessM)
        
        if na(c.mainPivotLow.price) or low < c.mainPivotLow.price
            c.mainPivotLow.price := low
            c.mainPivotLow.barIndex := bar_index
            c.mainPivotLow.time := time
            c.mainPivotLow.dayId := currentDay
            c.mainPivotLow.num369 := get369FromHM(sessH, sessM)
        
        // Track comparison symbols only if enabled
        if s1Enabled or s2Enabled
            // Track Symbol 1 extremes
            if s1Enabled and not na(s1_high) and s1_high > 0
                if na(c.s1PivotHigh.price) or s1_high > c.s1PivotHigh.price
                    c.s1PivotHigh.price := s1_high
                    c.s1PivotHigh.barIndex := bar_index
                    c.s1PivotHigh.time := time
                    c.s1PivotHigh.dayId := currentDay
                    c.s1PivotHigh.num369 := get369FromHM(sessH, sessM)
                if not na(s1_low) and s1_low > 0 and (na(c.s1PivotLow.price) or s1_low < c.s1PivotLow.price)
                    c.s1PivotLow.price := s1_low
                    c.s1PivotLow.barIndex := bar_index
                    c.s1PivotLow.time := time
                    c.s1PivotLow.dayId := currentDay
                    c.s1PivotLow.num369 := get369FromHM(sessH, sessM)
            
            // Track Symbol 2 extremes
            if s2Enabled and not na(s2_high) and s2_high > 0
                if na(c.s2PivotHigh.price) or s2_high > c.s2PivotHigh.price
                    c.s2PivotHigh.price := s2_high
                    c.s2PivotHigh.barIndex := bar_index
                    c.s2PivotHigh.time := time
                    c.s2PivotHigh.dayId := currentDay
                    c.s2PivotHigh.num369 := get369FromHM(sessH, sessM)
                if not na(s2_low) and s2_low > 0 and (na(c.s2PivotLow.price) or s2_low < c.s2PivotLow.price)
                    c.s2PivotLow.price := s2_low
                    c.s2PivotLow.barIndex := bar_index
                    c.s2PivotLow.time := time
                    c.s2PivotLow.dayId := currentDay
                    c.s2PivotLow.num369 := get369FromHM(sessH, sessM)

markLinesAsHistorical(int mgrIdx, int cycleStartBar) =>
    // Mark all lines from a completed cycle as historical
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            meta = array.get(lines, i)
            // Mark lines from this specific cycle (manager, 1:1 with its label) as historical
            if meta.isForCurrentCycle and meta.mgrIdx == mgrIdx and meta.historyCycleStart == cycleStartBar
                meta.isForCurrentCycle := false

repositionAllLabels() =>
    // OPTIMIZED: O(N) implementation using Maps to group labels
    // All geometry/keys/text come from the LineMetadata cache: no line.get_*()
    // built-in calls and no str.tostring() per pass, and label.set_*() only runs
    // when the value actually changes (final label state is identical).
    if array.size(lines) > 0
        // Pass 1: Group by (x1, x2, cycle, isBearish) to merge symbols
        // Key: cached LineMetadata.key1 = x1_x2_cycle_bearish
        // FIX: Use wrapper type IntArray instead of array<int> directly in map
        var p1Map = map.new<string, IntArray>()
        map.clear(p1Map)
        
        for i = 0 to array.size(lines) - 1
            meta = array.get(lines, i)
            // Generate Key (cached; refreshed whenever the line moves)
            k = meta.key1
            
            if not map.contains(p1Map, k)
                map.put(p1Map, k, IntArray.new(array.new<int>()))
            array.push(map.get(p1Map, k).values, i)
            
        // Pass 2: Merge symbols and Group by (x2, symbols, isBearish) to merge cycles
        // Key: x2_symbols_bearish
        var p2Map = map.new<string, IntArray>()
        map.clear(p2Map)
        var displaySymsMap = map.new<int, string>()
        map.clear(displaySymsMap)
        
        // Iterate over Pass 1 groups
        keys1 = map.keys(p1Map)
        for k in keys1
            indices = map.get(p1Map, k).values
            baseIdx = array.get(indices, 0)
            baseMeta = array.get(lines, baseIdx)
            combinedSyms = baseMeta.symbols
            
            // Merge multiple symbols if present
            if array.size(indices) > 1
                for j = 1 to array.size(indices) - 1
                    otherMeta = array.get(lines, array.get(indices, j))
                    combinedSyms += "+" + otherMeta.symbols
                    if otherMeta.labTxt != ""
                        label.set_text(otherMeta.labelObj, "") // Hide merged
                        otherMeta.labTxt := ""
            
            // Store resolved symbols for this group base
            map.put(displaySymsMap, baseIdx, combinedSyms)
            
            // Add to Pass 2 Map
            k2 = baseMeta.x2Str + "_" + combinedSyms + "_" + (baseMeta.isBearish ? "1" : "0")
            if not map.contains(p2Map, k2)
                map.put(p2Map, k2, IntArray.new(array.new<int>()))
            array.push(map.get(p2Map, k2).values, baseIdx)

        // Pass 3: Merge Cycles & Stack
        var p3Map = map.new<string, IntArray>()
        map.clear(p3Map)
        
        keys2 = map.keys(p2Map)
        for k2 in keys2
            indices = map.get(p2Map, k2).values
            baseIdx = array.get(indices, 0)
            baseMeta = array.get(lines, baseIdx)
            currentSyms = map.get(displaySymsMap, baseIdx)
            
            cycleListStr = baseMeta.cycleLabel
            
            // Merge cycles if present
            if array.size(indices) > 1
                for j = 1 to array.size(indices) - 1
                    otherMeta = array.get(lines, array.get(indices, j))
                    cycleListStr += " + " + otherMeta.cycleLabel
                    if otherMeta.labTxt != ""
                        label.set_text(otherMeta.labelObj, "") // Hide merged
                        otherMeta.labTxt := ""
            
            // Update Label Text
            hasDigits = str.contains(cycleListStr, "0") or str.contains(cycleListStr, "3") or str.contains(cycleListStr, "9") or str.contains(cycleListStr, "1")
            suffix = hasDigits ? "m " : " "
            // Use CACHED num369
            suffix369 = enable369Ids and baseMeta.num369 > 0 ? " (" + str.tostring(baseMeta.num369) + ")" : ""
            finalTxt = cycleListStr + suffix + currentSyms + suffix369
            if baseMeta.labTxt != finalTxt
                label.set_text(baseMeta.labelObj, finalTxt)
                baseMeta.labTxt := finalTxt
            
            // Add to Stack Map (Group by Location & Direction)
            k3 = baseMeta.x2Str + "_" + (baseMeta.isBearish ? "1" : "0")
            if not map.contains(p3Map, k3)
                map.put(p3Map, k3, IntArray.new(array.new<int>()))
            array.push(map.get(p3Map, k3).values, baseIdx)
            
        // Apply Stacking
        keys3 = map.keys(p3Map)
        for k3 in keys3
            indices = map.get(p3Map, k3).values
            cnt = array.size(indices)
            
            // Sort by cached stack order (Bubble Sort) if needed
            // Order: Y(0), M(1)... 3(7), sessions 8. Ascending puts the base cycle
            // at offset 0 and the lowest cycle on top - same order as V-4.0.
            if cnt > 1
                for i = 0 to cnt - 2
                    for j = 0 to cnt - 2 - i
                        idxA = array.get(indices, j)
                        idxB = array.get(indices, j + 1)
                        if array.get(lines, idxA).cycleOrder > array.get(lines, idxB).cycleOrder
                            array.set(indices, j, idxB)
                            array.set(indices, j + 1, idxA)
            
            // Apply Offsets
            for i = 0 to cnt - 1
                meta = array.get(lines, array.get(indices, i))
                stackOffset = i * labelStackSpacing
                totalOffset = meta.isBearish ? (labelBaseOffset + stackOffset) : -(labelBaseOffset + stackOffset)
                
                midX = math.floor((meta.x1 + meta.x2) / 2)
                midY = (meta.y1 + meta.y2) / 2
                newY = midY + totalOffset
                if meta.labX != midX or meta.labY != newY
                    label.set_xy(meta.labelObj, midX, newY)
                    meta.labX := midX
                    meta.labY := newY

completeCycle(CycleManager m, int mIdx) =>
    // Mark existing lines for this cycle as historical BEFORE starting new cycle
    markLinesAsHistorical(mIdx, m.current.startBar)
    
    // Create deep copies of pivot points
    mainHighCopy = createPivot(m.current.mainPivotHigh.price, m.current.mainPivotHigh.barIndex, m.current.mainPivotHigh.time)
    mainLowCopy = createPivot(m.current.mainPivotLow.price, m.current.mainPivotLow.barIndex, m.current.mainPivotLow.time)
    s1HighCopy = createPivot(m.current.s1PivotHigh.price, m.current.s1PivotHigh.barIndex, m.current.s1PivotHigh.time)
    s1LowCopy = createPivot(m.current.s1PivotLow.price, m.current.s1PivotLow.barIndex, m.current.s1PivotLow.time)
    s2HighCopy = createPivot(m.current.s2PivotHigh.price, m.current.s2PivotHigh.barIndex, m.current.s2PivotHigh.time)
    s2LowCopy = createPivot(m.current.s2PivotLow.price, m.current.s2PivotLow.barIndex, m.current.s2PivotLow.time)
    savedCycle = CycleData.new(m.current.startTime, m.current.startBar, mainHighCopy, mainLowCopy, s1HighCopy, s1LowCopy, s2HighCopy, s2LowCopy, true, m.current.startCycleId, m.current.startDayId, m.current.startWeekId, m.current.startMonthId, m.current.startYear)
    array.push(m.history, savedCycle)
    
    // OPTIMIZATION: Cap history size
    if array.size(m.history) > 40
        array.shift(m.history)
        
    startCycle(m.current, m.duration)

shouldComplete(CycleData c, int durMin) =>
    if not c.active or na(c.startTime)
        false
    else
        // STRICT TIMING: Check if we have moved to a new cycle slot
        bool shouldFinish = false
        
        if durMin > 0
            // Intraday Cycles (90, 30, 10, 3) — c.startCycleId was cached at cycle start
            shouldFinish := cycleIdFromMins(nyTotalMins, durMin) != c.startCycleId
        else if durMin == -1
            // Calendar Cycles (-1=Daily, -2=Weekly, -3=Monthly, -4=Yearly)
            // Use NY time for all calendar boundaries (per-bar cache).
            // Daily: pure calendar day, 00:00 NY boundary
            shouldFinish := (nyY * 10000 + nyMo * 100 + nyD) != c.startDayId
        else if durMin == -2 // Weekly
            // y*100+w is injective for w <= 53, so this equals (nyWeek != startWeek or nyY != startYear)
            shouldFinish := (nyY * 100 + nyWeek) != c.startWeekId
        else if durMin == -3 // Monthly
            // y*100+m is injective for m <= 12, so this equals (nyMo != startMonth or nyY != startYear)
            shouldFinish := (nyY * 100 + nyMo) != c.startMonthId
        else if durMin == -4 // Yearly
            shouldFinish := nyY != c.startYear

        shouldFinish


// ═══════════════════════════════════════════════════════════════════════════════
//                              SMT DETECTION & DRAWING
// ═══════════════════════════════════════════════════════════════════════════════

// NOTE: detectSMT() was deleted in V-4.1 - it was defined but never called
// (checkAndDrawSMT() carries the four detection branches inline).

// Unified SMT Detection Helper


isInvalidated(meta, isS1, isHigh, bearish, inverse, currMain, currComp) =>
    if na(currComp) or na(currMain)
        false
    else
        if inverse
            bearish ? (currComp < meta.compPrice or currMain > meta.mainPrice) : (currComp > meta.compPrice or currMain < meta.mainPrice)
        else
            bearish ? currComp > meta.compPrice : currComp < meta.compPrice


// NOTE: getDayId() was deleted in V-4.1 - the trading-day id is now cached on
// PivotPoint (`dayId`) at the same bar the pivot is written, which is exactly
// the bar `time2` came from.
drawSMT(int bar1, int time1, float price1, int bar2, int time2, float price2, string symbolStr, string cycleLabel, bool bearish, int typeId, float compPrice, int cycleStartBar, int currentDay, int t2DayId, int t2Num369) =>
    if na(bar1) or na(bar2) or na(time1) or na(time2)
        false
    else
        // Owning cycle manager (session labels have none)
        int mgrIdx = -1
        if map.contains(mgrIdxByLabel, cycleLabel)
            mgrIdx := map.get(mgrIdxByLabel, cycleLabel)
        
        bool isLongTerm = false
        if mgrIdx >= 0
            isLongTerm := array.get(managers, mgrIdx).duration < 0
        
        // ONLY draw SMTs from current trading day for intraday cycles
        // Long-term cycles (D, W, M, Y) can span multiple days
        // t2DayId == getDayId(time2), cached on the pivot that produced time2
        if not isLongTerm and t2DayId != currentDay
            false  // Skip drawing this SMT - it's from a previous trading day
        else
            lineColor = bearish ? bearishSmtColor : bullishSmtColor
            textColor = bearish ? bearishSmtColor : bullishSmtColor
            lineStyle = cycleLabel == "90" ? line_style_90 : (cycleLabel == "30" ? line_style_30 : (cycleLabel == "10" ? line_style_10 : (cycleLabel == "3" ? line_style_3 : line.style_solid)))
            
            shouldAdd = true
            mergeIdx = -1
            
            if array.size(lines) > 0
                for i = 0 to array.size(lines) - 1
                    m = array.get(lines, i)
                    // Check if this is EXACT SAME symbol, cycle, and direction
                    if m.isBearish == bearish and m.isForCurrentCycle and m.mgrIdx == mgrIdx and m.cycleLabel == cycleLabel and m.symbols == symbolStr
                        // Update existing line for this specific symbol
                        mergeIdx := i
                        shouldAdd := false
                        break
            
            isNew = false
            if mergeIdx >= 0
                // Update existing SMT line for this symbol
                existing = array.get(lines, mergeIdx)
                
                // Always redraw the line with new coordinates (intra-cycle may have different endpoints)
                line.delete(existing.lineObj)
                existing.lineObj := line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1, style=lineStyle)
                existing.mainPrice := price1
                existing.compPrice := compPrice
                // Keep the cached geometry mirror in sync with the redrawn line
                existing.x1 := time1
                existing.y1 := price1
                existing.x2 := time2
                existing.y2 := price2
                refreshLineKeys(existing)
                
                // Symbol already matches, just update coordinates (no label change needed)
                
                isNew := false
            else if shouldAdd
                // No need to remove old lines here based on length anymore.
                // Just add the new one and let the FIFO limit handle cleanup.
                
                l = line.new(time1, price1, time2, price2, xloc=xloc.bar_time, color=lineColor, width=1, style=lineStyle)
                
                // Calculate midpoint for label placement
                midTime = math.floor((time1 + time2) / 2)
                midPrice = (price1 + price2) / 2
                
                // The stack offset is recomputed by repositionAllLabels() at the end of
                // every bar that draws, so only the base offset is needed here.
                totalOffset = bearish ? labelBaseOffset : -labelBaseOffset
                
                // Add "m" only for numeric cycle labels (90, 30, 10, 3), not for session or calendar labels
                isSessionLabel = cycleLabel == "ASIA" or cycleLabel == "LONDON" or cycleLabel == "NY-AM" or cycleLabel == "NY-PM" or cycleLabel == "D" or cycleLabel == "W" or cycleLabel == "M" or cycleLabel == "Y"
                
                // 369 numerology of the endpoint (cached on the pivot that produced time2)
                num369 = t2Num369
                suffix369 = enable369Ids and num369 > 0 ? " (" + str.tostring(num369) + ")" : ""
                
                txt = isSessionLabel ? cycleLabel + " " + symbolStr + suffix369 : cycleLabel + "m " + symbolStr + suffix369
                
                // Create label at midpoint of line
                lab = label.new(midTime, midPrice + totalOffset, txt, xloc=xloc.bar_time, style=label.style_none, color=textColor, textcolor=textColor, size=size.small, yloc=yloc.price)
                
                meta = LineMetadata.new(l, lab, bearish, typeId, price1, compPrice, symbolStr, cycleLabel, cycleStartBar, true, num369, mgrIdx, getStackOrder(cycleLabel), time1, price1, time2, price2, "", "", txt, midTime, midPrice + totalOffset)
                refreshLineKeys(meta)
                array.push(lines, meta)
                
                // Calculate regular (non-exempt) and 369 line counts separately
                int regularLineCount = 0
                int line369Count = 0
                if array.size(lines) > 0
                    for i = 0 to array.size(lines) - 1
                        m_chk = array.get(lines, i)
                        // OPTIMIZATION: Use cached num369
                        is369 = enable369Ids and m_chk.num369 > 0
                        if is369
                            line369Count += 1
                        else
                            regularLineCount += 1

                if enableOldSmtDeletion
                    // Delete excess regular SMTs (lowest priority first = highest cycleOrder)
                    while regularLineCount > maxTotalLines
                        // Find line with lowest priority to remove (limit search to NON-EXEMPT lines)
                        idxToRemove = -1
                        maxOrder = -1
                        
                        for i = 0 to array.size(lines) - 1
                            checkLn = array.get(lines, i)
                            
                            // EXEMPT 369 SMTs from regular deletion
                            if enable369Ids and checkLn.num369 > 0
                                continue
                            
                            // Strict greater-than keeps the distinct oldest if priorities match (FIFO within priority)
                            if checkLn.cycleOrder > maxOrder
                                maxOrder := checkLn.cycleOrder
                                idxToRemove := i
                        
                        if idxToRemove >= 0
                            old = array.remove(lines, idxToRemove)
                            line.delete(old.lineObj)
                            label.delete(old.labelObj)
                            regularLineCount -= 1
                        else
                            // If we can't find a regular line to remove (shouldn't happen if regularLineCount > max), break
                            break
                    
                    // Delete excess 369 SMTs (FIFO - oldest first)
                    while line369Count > max369Lines
                        idxToRemove = -1
                        
                        for i = 0 to array.size(lines) - 1
                            checkLn = array.get(lines, i)
                            
                            // Only consider 369 SMTs
                            if enable369Ids and checkLn.num369 > 0
                                idxToRemove := i
                                break  // Remove the first (oldest) 369 SMT found
                        
                        if idxToRemove >= 0
                            old = array.remove(lines, idxToRemove)
                            line.delete(old.lineObj)
                            label.delete(old.labelObj)
                            line369Count -= 1
                        else
                            break
                
                isNew := true
            isNew

// Unified SMT Detection Helper
checkAndDrawSMT(PivotPoint currMain, PivotPoint prevMain, PivotPoint currComp, PivotPoint prevComp, string symStr, string lbl, int startBar, int typeBase, bool isBearish, int currentDay) =>
    detected = false
    if not na(currMain.price) and not na(prevMain.price) and not na(currComp.price) and not na(prevComp.price)
        if isBearish
            // Bearish Normal: Main Higher High, Comp Lower High
            if currMain.price > prevMain.price and currComp.price < prevComp.price
                if drawSMT(prevMain.barIndex, prevMain.time, prevMain.price, currMain.barIndex, currMain.time, currMain.price, symStr, lbl, true, typeBase + 0, prevComp.price, startBar, currentDay, currMain.dayId, currMain.num369)
                    detected := true
            // Bearish Inverse: Comp Higher High, Main Lower High
            if currComp.price > prevComp.price and currMain.price < prevMain.price
                if drawSMT(prevMain.barIndex, prevMain.time, prevMain.price, currMain.barIndex, currMain.time, currMain.price, symStr, lbl, true, typeBase + 4, prevComp.price, startBar, currentDay, currMain.dayId, currMain.num369)
                    detected := true
        else
            // Bullish Normal: Main Lower Low, Comp Higher Low
            if currMain.price < prevMain.price and currComp.price > prevComp.price
                if drawSMT(prevMain.barIndex, prevMain.time, prevMain.price, currMain.barIndex, currMain.time, currMain.price, symStr, lbl, false, typeBase + 1, prevComp.price, startBar, currentDay, currMain.dayId, currMain.num369)
                    detected := true
            // Bullish Inverse: Comp Lower Low, Main Higher Low
            if currComp.price < prevComp.price and currMain.price > prevMain.price
                if drawSMT(prevMain.barIndex, prevMain.time, prevMain.price, currMain.barIndex, currMain.time, currMain.price, symStr, lbl, false, typeBase + 5, prevComp.price, startBar, currentDay, currMain.dayId, currMain.num369)
                    detected := true
    detected


checkInvalidation() =>
    bool removed = false
    // Reused across bars instead of re-allocated on every execution
    var array<int> toRemove = array.new<int>()
    // OPTIMIZATION: Early exit if no symbols enabled
    if s1Enabled or s2Enabled
        if array.size(lines) > 0
            array.clear(toRemove)
            for i = 0 to array.size(lines) - 1
                m = array.get(lines, i)
                isS1 = m.smtTypeId == 0 or m.smtTypeId == 1 or m.smtTypeId == 4 or m.smtTypeId == 5
                isHigh = m.smtTypeId == 0 or m.smtTypeId == 2 or m.smtTypeId == 4 or m.smtTypeId == 6
                inverse = m.smtTypeId >= 4
                enabled = isS1 ? s1Enabled : s2Enabled
                
                if enabled
                    // Default to current bar values
                    currMain = isHigh ? high : low
                    currComp = isS1 ? (isHigh ? s1_high : s1_low) : (isHigh ? s2_high : s2_low)
                    
                    // ROBUSTNESS FIX: Attempt to use Cycle Extremes if available
                    // This catches cases where price spiked (invalidating SMT) and came back
                    // (mgrIdx was resolved when the line was created; label <-> manager is 1:1,
                    // so this is the same manager the old manager-label scan found)
                    if m.mgrIdx >= 0
                        mgr = array.get(managers, m.mgrIdx)
                        if mgr.current.active
                            // Found matching manager, use its accumulated extremes
                            cMain = isHigh ? mgr.current.mainPivotHigh.price : mgr.current.mainPivotLow.price
                            cComp = isS1 ? (isHigh ? mgr.current.s1PivotHigh.price : mgr.current.s1PivotLow.price) : (isHigh ? mgr.current.s2PivotHigh.price : mgr.current.s2PivotLow.price)
                            
                            // If cycle extremes are valid, use them as they represent the "widest" excursion
                            if not na(cMain)
                                currMain := cMain
                            if not na(cComp)
                                currComp := cComp

                    if not na(currMain) and not na(currComp)
                        // Checks all SMTs (including 369s) for invalidation/sync
                        if isInvalidated(m, isS1, isHigh, m.isBearish, inverse, currMain, currComp)
                            array.push(toRemove, i)
            
            if array.size(toRemove) > 0
                for i = array.size(toRemove) - 1 to 0
                    old = array.remove(lines, array.get(toRemove, i))
                    line.delete(old.lineObj)
                    label.delete(old.labelObj)
                // Reposition remaining labels after deletion
                removed := true
    removed



updateExistingLines(CycleManager m, int mIdx) =>
    curr = m.current
    bool changed = false
    if array.size(lines) > 0 and curr.active
        for i = 0 to array.size(lines) - 1
            meta = array.get(lines, i)
            // ROBUSTNESS FIX: Remove strict startBar check. Rely on isForCurrentCycle and manager match.
            // This ensures active lines tracks price even if startBar accounting drifts slightly.
            if meta.isForCurrentCycle and meta.mgrIdx == mIdx
                isHigh = meta.smtTypeId == 0 or meta.smtTypeId == 2 or meta.smtTypeId == 4 or meta.smtTypeId == 6
                
                // Get current pivot (the end point of the line)
                currPivot = isHigh ? curr.mainPivotHigh : curr.mainPivotLow
                
                // Cached mirror instead of line.get_x2/get_y2 (set_xy2 below is the only writer)
                if not na(currPivot.price) and (meta.x2 != currPivot.time or meta.y2 != currPivot.price)
                    // Update the line endpoint to current cycle's extreme
                    line.set_xy2(meta.lineObj, currPivot.time, currPivot.price)
                    meta.x2 := currPivot.time
                    meta.y2 := currPivot.price
                    refreshLineKeys(meta)
                    
                    // Update Cached 369 since time changed (pivot cached it at write time)
                    meta.num369 := currPivot.num369
                    
                    changed := true
    changed



    // OPTIMIZATION: Removed dead processSMT logic
// 


// ═══════════════════════════════════════════════════════════════════════════════
//                              SESSION SMT FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

isInSession(sessionTime, timezone) =>
    not na(time("", sessionTime, timezone))

startDailySession(s) =>
    startCycle(s.data, 0)


// Obsolete updateDailySessionPivots removed - use updatePivots(sess.data) instead


compareSessionSMT(curr, prev, int currentDay) =>
    // Note: Sessions use prev.startTime as the identifier (not startBar since sessions don't have startBar)
    sessionStartBar = bar_index  // Use current bar as the session start reference
    
    // Compare current session high to previous session high (Bearish)
    if s1Enabled or s2Enabled
        if not na(curr.data.mainPivotHigh.price) and not na(prev.data.mainPivotHigh.price)
            if s1Enabled
                checkAndDrawSMT(curr.data.mainPivotHigh, prev.data.mainPivotHigh, curr.data.s1PivotHigh, prev.data.s1PivotHigh, s1Abbr, prev.name, sessionStartBar, 0, true, currentDay)
            if s2Enabled
                checkAndDrawSMT(curr.data.mainPivotHigh, prev.data.mainPivotHigh, curr.data.s2PivotHigh, prev.data.s2PivotHigh, s2Abbr, prev.name, sessionStartBar, 2, true, currentDay)
        
        // Compare current session low to previous session low (Bullish)
        if not na(curr.data.mainPivotLow.price) and not na(prev.data.mainPivotLow.price)
            if s1Enabled
                checkAndDrawSMT(curr.data.mainPivotLow, prev.data.mainPivotLow, curr.data.s1PivotLow, prev.data.s1PivotLow, s1Abbr, prev.name, sessionStartBar, 0, false, currentDay)
            if s2Enabled
                checkAndDrawSMT(curr.data.mainPivotLow, prev.data.mainPivotLow, curr.data.s2PivotLow, prev.data.s2PivotLow, s2Abbr, prev.name, sessionStartBar, 2, false, currentDay)







// ═══════════════════════════════════════════════════════════════════════════════
//                              MAIN EXECUTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════
//
//  EXECUTION FLOW:
//      1. Track daily reset - Clear all SMTs at 18:00 NY time (Asia session open)
//      2. Check invalidation - Remove SMTs broken by new price action
//      3. Session filter - Only process during active trading session
//      4. Cycle management - Start, update, or complete cycles
//      5. SMT detection - Compare current vs previous cycles (current day only)
//      6. Real-time updates - Move line endpoints as extremes change
//
//  TRADING DAY:
//      • Trading day starts at 18:00 NY time (Asia session open)
//      • All SMT history is cleared at 18:00 each day
//      • Only cycles from current trading day (18:00 onwards) are compared
//      • This aligns with futures market day boundaries
//
//  SMT DETECTION LOGIC:
//      Bearish SMT (Normal): Main makes higher high, Comparison makes lower high
//      Bullish SMT (Normal): Main makes lower low, Comparison makes higher low
//      Bearish SMT (Inverse): Comparison makes higher high, Main makes lower high
//      Bullish SMT (Inverse): Comparison makes lower low, Main makes higher low
//
//  LINE DISPLAY:
//      • Black lines connect previous cycle extreme to current cycle extreme
//      • Labels show: "SMT-[Symbol(s)] [Cycle]"
//      • Combined labels (e.g., "SMT-BTC+ES 90") indicate multiple SMTs aligned
//      • Lines update in real-time as current cycle's high/low changes
//      • Lines are automatically removed if pattern is invalidated
//
// ═══════════════════════════════════════════════════════════════════════════════


// Track day changes - Use 18:00 as day boundary (futures true day open)
// currentDay / nyHour / nyYear / nyMonth / nyDay are computed once per bar in the
// global-state block at the top of the script (per-bar timezone cache).


// Daily reset logic - reset ALL cycles at 18:00 NY time (Asia session open)
if currentDay != lastDay and not na(lastDay)
    // 1. Reset all Cycle Managers (history and active state)
    // 1. Reset all Cycle Managers (history and active state) - SKIP Long Term Cycles
    for i = 0 to array.size(managers) - 1
        m = array.get(managers, i)
        // Only reset Intraday cycles (duration > 0). Calendar cycles (-1 to -4) persist.
        if m.duration > 0
            array.clear(m.history)
            m.current.active := false
    
    // 2. Reset all Daily Sessions
    for i = 0 to array.size(dailySessions) - 1
        sess = array.get(dailySessions, i)
        // Reset all sessions at new day boundary (18:00)
        sess.data.active := false

    // 3. NUCLEAR LINE WIPE: Delete ALL lines and labels from the previous day/history
    // This ensures NO SMTs (including 369s) persist across the 18:00 boundary
    // 3. PARTIAL LINE WIPE: Delete only Intraday lines/labels from previous day
    // Keep Long Term SMT lines (D, W, M, Y)
    if array.size(lines) > 0
        // Iterate backwards to safely remove
        for j = array.size(lines) - 1 to 0
            l = array.get(lines, j)
            // Check if it is a Long Term line
            isLongTerm = l.cycleLabel == "D" or l.cycleLabel == "W" or l.cycleLabel == "M" or l.cycleLabel == "Y"
            
            if not isLongTerm
                // Delete intraday line
                line.delete(l.lineObj)
                label.delete(l.labelObj)
                array.remove(lines, j)

lastDay := currentDay

if checkInvalidation()
    needReposition := true

// Reposition all labels on every bar to reflect input changes
// Removed implicit call here, handled at end of script if needed


// Process long-term cycles (D, W, M, Y) - ALWAYS active, ignore session filter
for i = 0 to array.size(managers) - 1
    m = array.get(managers, i)
    // Long-term managers are the ones with a negative duration
    if m.duration >= 0
        continue
    
    curr = m.current
    
    // 1. CYCLE LIFECYCLE - start or complete
    if not curr.active
        startCycle(curr, m.duration)
    else if shouldComplete(curr, m.duration)
        completeCycle(m, i)
        curr := m.current
    
    // Skip inactive cycles
    if not curr.active
        continue

    // 2. DATA SNAPSHOT - always snapshot for comparisons
    prevMainHigh = curr.mainPivotHigh.price
    prevMainLow = curr.mainPivotLow.price
    prevS1High = curr.s1PivotHigh.price
    prevS1Low = curr.s1PivotLow.price
    prevS2High = curr.s2PivotHigh.price
    prevS2Low = curr.s2PivotLow.price
    
    // 3. UPDATE CURRENT EXTREMES
    updatePivots(curr)
    
    // 4. INVALIDATION CHECK (only once on first long-term cycle)
    // 4. INVALIDATION CHECK - Moved to global scope once per bar
    // if i == 0 ... checkInvalidation() -> REMOVED
    
    // 5. CHANGE DETECTION - optimized
    anyHighChanged = curr.mainPivotHigh.price != prevMainHigh or curr.s1PivotHigh.price != prevS1High or curr.s2PivotHigh.price != prevS2High
    anyLowChanged = curr.mainPivotLow.price != prevMainLow or curr.s1PivotLow.price != prevS1Low or curr.s2PivotLow.price != prevS2Low
    
    // Skip if no changes
    if not anyHighChanged and not anyLowChanged
        continue

    // 5. REAL-TIME LINE UPDATES - only when this cycle's extremes moved
    if updateExistingLines(m, i)
        needReposition := true

    // 6. INTRA-CYCLE DETECTION - compare the currently-open cycle against the single previous completed cycle only
    if array.size(m.history) >= 1
        mLabel = m.label  // Cache label for alert conditions

        lastCompleted = array.get(m.history, array.size(m.history) - 1)

        if anyHighChanged and s1Enabled
            if checkAndDrawSMT(curr.mainPivotHigh, lastCompleted.mainPivotHigh, curr.s1PivotHigh, lastCompleted.s1PivotHigh, s1Abbr, mLabel, curr.startBar, 0, true, currentDay)
                needReposition := true

        if anyHighChanged and s2Enabled
            if checkAndDrawSMT(curr.mainPivotHigh, lastCompleted.mainPivotHigh, curr.s2PivotHigh, lastCompleted.s2PivotHigh, s2Abbr, mLabel, curr.startBar, 2, true, currentDay)
                needReposition := true

        if anyLowChanged and s1Enabled
            if checkAndDrawSMT(curr.mainPivotLow, lastCompleted.mainPivotLow, curr.s1PivotLow, lastCompleted.s1PivotLow, s1Abbr, mLabel, curr.startBar, 0, false, currentDay)
                needReposition := true

        if anyLowChanged and s2Enabled
            if checkAndDrawSMT(curr.mainPivotLow, lastCompleted.mainPivotLow, curr.s2PivotLow, lastCompleted.s2PivotLow, s2Abbr, mLabel, curr.startBar, 2, false, currentDay)
                needReposition := true

// Process intraday cycles (90m, 30m, 10m, 3m) - always run (session filter does not gate cycle tracking)
for mIdx = 0 to array.size(managers) - 1
    m = array.get(managers, mIdx)
    // Skip long-term cycles (already processed above)
    if m.duration < 0
        continue
    
    curr = m.current
    
    // 1. CYCLE LIFECYCLE - start or complete
    if not curr.active
        startCycle(curr, m.duration)
    else if shouldComplete(curr, m.duration)
        completeCycle(m, mIdx)
        curr := m.current
    
    // Skip inactive cycles
    if not curr.active
        continue

    // 2. DATA SNAPSHOT - always snapshot for comparisons
    prevMainHigh = curr.mainPivotHigh.price
    prevMainLow = curr.mainPivotLow.price
    prevS1High = curr.s1PivotHigh.price
    prevS1Low = curr.s1PivotLow.price
    prevS2High = curr.s2PivotHigh.price
    prevS2Low = curr.s2PivotLow.price
    
    // 3. UPDATE CURRENT EXTREMES
    updatePivots(curr)
    
    // 5. CHANGE DETECTION - optimized
    anyHighChanged = curr.mainPivotHigh.price != prevMainHigh or curr.s1PivotHigh.price != prevS1High or curr.s2PivotHigh.price != prevS2High
    anyLowChanged = curr.mainPivotLow.price != prevMainLow or curr.s1PivotLow.price != prevS1Low or curr.s2PivotLow.price != prevS2Low
    
    // Skip if no changes
    if not anyHighChanged and not anyLowChanged
        continue

    // 5. REAL-TIME LINE UPDATES - only when this cycle's extremes moved
    if updateExistingLines(m, mIdx)
        needReposition := true

    // 6. INTRA-CYCLE DETECTION - compare current cycle against the immediately previous completed cycle only
    if array.size(m.history) > 0
        mLabel = m.label

        lastCompleted = array.get(m.history, array.size(m.history) - 1)

        if anyHighChanged and s1Enabled
            if checkAndDrawSMT(curr.mainPivotHigh, lastCompleted.mainPivotHigh, curr.s1PivotHigh, lastCompleted.s1PivotHigh, s1Abbr, mLabel, curr.startBar, 0, true, currentDay)
                needReposition := true

        if anyHighChanged and s2Enabled
            if checkAndDrawSMT(curr.mainPivotHigh, lastCompleted.mainPivotHigh, curr.s2PivotHigh, lastCompleted.s2PivotHigh, s2Abbr, mLabel, curr.startBar, 2, true, currentDay)
                needReposition := true

        if anyLowChanged and s1Enabled
            if checkAndDrawSMT(curr.mainPivotLow, lastCompleted.mainPivotLow, curr.s1PivotLow, lastCompleted.s1PivotLow, s1Abbr, mLabel, curr.startBar, 0, false, currentDay)
                needReposition := true

        if anyLowChanged and s2Enabled
            if checkAndDrawSMT(curr.mainPivotLow, lastCompleted.mainPivotLow, curr.s2PivotLow, lastCompleted.s2PivotLow, s2Abbr, mLabel, curr.startBar, 2, false, currentDay)
                needReposition := true


// 7. BATCH PROCESSING - removed in V-4.1: the per-manager endpoint update now
// runs inside each manager loop above, guarded by the change flag that loop
// already computed (identical outcome, no extra full pass over `managers`).


// ═══════════════════════════════════════════════════════════════════════════════
//                              SESSION SMT PROCESSING
// ═══════════════════════════════════════════════════════════════════════════════

// Process session SMTs - sequential comparison like cycles
if enableSessionSMT
    for i = 0 to array.size(dailySessions) - 1
        sess = array.get(dailySessions, i)
        
        if not sess.enabled
            continue
        
        inSession = isInSession(sess.sessionTime, sess.timezone)
        
        if inSession and not sess.data.active
            startDailySession(sess)
        
        if sess.data.active
            updatePivots(sess.data)
        
        if not inSession and sess.data.active and not na(sess.data.mainPivotHigh.price) and not na(sess.data.mainPivotLow.price)
            sess.data.active := false
            
            // Compare current session to all previous sessions that happened today
            for j = 0 to i - 1
                prevSess = array.get(dailySessions, j)
                if prevSess.enabled and not na(prevSess.data.mainPivotHigh.price) and not na(prevSess.data.mainPivotLow.price)
                    compareSessionSMT(sess, prevSess, currentDay)
            needReposition := true


// ═══════════════════════════════════════════════════════════════════════════════
//                    SWING HIGH / LOW PLOTTING (TIME-BASED)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Detects 3-candle swing patterns on strict GBT master grid marks:
//  • Rule: HH + MM = GB-set number (full set, hour-dependent minute lattice)
//  • Non-GB numbers (23, 35, 65, 77) labeled with "N" prefix (N23, N35, N65, N77)
//  • Strict marks only - no +/-1 tolerance
//  • GB number printed above (high) / below (low) the swing
//  • FIFO label cap (Max Swing Labels) keeps the total under the 500-label
//    chart limit so recent marks always render (oldest are deleted first)
//
// ═══════════════════════════════════════════════════════════════════════════════

var array<int> gbtNumbers = array.from(3, 11, 17, 23, 29, 35, 41, 47, 53, 59, 65, 71, 77, 83, 89, 97)

// Sum lookup: gbSumLut[s] is true when h + m == s is a GBT master-grid number.
// Built once on the first bar (replaces a 16-element scan per isGbHM() call).
buildGbSumLut(array<int> nums) =>
    lut = array.new<bool>(144, false)
    for i = 0 to array.size(nums) - 1
        array.set(lut, array.get(nums, i), true)
    lut

var array<bool> gbSumLut = buildGbSumLut(gbtNumbers)

// nextMarkOffset[minuteOfDay] = minutes until the next GBT mark exists
// (wrapping past midnight). Built once on the first bar so nextGbtMark() is O(1)
// instead of scanning up to 61 candidate minutes per bar.
buildNextMarkOffsets(array<bool> sumLut) =>
    minuteLut = array.new<bool>(1440, false)
    for i = 0 to 1439
        if array.get(sumLut, math.floor(i / 60) + (i % 60))
            array.set(minuteLut, i, true)
    firstMark = 0
    for i = 0 to 1439
        if array.get(minuteLut, i)
            firstMark := i
            break
    offsets = array.new<int>(1440, 0)
    run = 0
    wrapped = true
    for i = 1439 to 0
        if array.get(minuteLut, i)
            run := 0
            wrapped := false
        else
            run += 1
        array.set(offsets, i, wrapped ? (1440 - i) + firstMark : run)
    offsets

var array<int> nextMarkOffset = buildNextMarkOffsets(gbSumLut)

var array<label> swingLabels = array.new<label>()
maxSwingLabels = input.int(200, "Max Swing Labels", minval=1, maxval=300, group="Swing Detection",
  tooltip="FIFO cap for swing and diamond labels. Oldest labels are deleted so the total stays under the 500-label chart limit, otherwise recent marks stop rendering.")

// Helper: strict GBT master grid check (O(1) LUT lookup).
// Rule: HH + MM must equal a GB-set number. No +/-1 tolerance.
// Non-GB numbers (23, 35, 65, 77) are flagged for the "N" label prefix.
isGbHM(int h, int m) =>
    int s = h + m
    bool isMark = false
    if s >= 0 and s < 144
        isMark := array.get(gbSumLut, s)
    isMark

// Returns [isMark, gbNumber, isNonGb]
isGbtMark(int h, int m) =>
    int s = h + m
    bool isMark = isGbHM(h, m)
    [isMark, s, isMark and (s == 23 or s == 35 or s == 65 or s == 77)]

// Fixed pixel offsets from the bar's high/low (zoom-independent):
// number label closest to the candle, dot stacked further out.
LABEL_PX_NEAR = 3
LABEL_PX_FAR = 28

// Create a number label anchored to the bar: fixed pixel offset from
// the high (above=true) or low (above=false). yloc.abovebar/belowbar keep
// the label glued to the candle at a constant screen distance when zooming.
// px = pixel offset. FIFO-trimmed to stay under the 500-label chart limit.
addSwingLabel(int barIdx, string txt, color col, bool above, int px) =>
    lbl = label.new(barIdx, px, txt, xloc=xloc.bar_index,
      yloc=above ? yloc.abovebar : yloc.belowbar,
      color=color.new(color.black, 100), textcolor=col,
      style=label.style_none, size=size.small)
    array.push(swingLabels, lbl)
    while array.size(swingLabels) > maxSwingLabels
        oldLbl = array.shift(swingLabels)
        label.delete(oldLbl)

// 3-candle swing patterns (middle candle is bar[1])
isSwingHighPattern = high[2] < high[1] and high[0] < high[1]
isSwingLowPattern = low[2] > low[1] and low[0] > low[1]

// Detect and plot Swing High (strict GBT mark only)
if enableSwingDetection and isSwingHighPattern and not na(time[1])
    // sessH[1]/sessM[1] == hour/minute of time[1] in the session timezone (cached)
    [swIsMark, swGbNum, swIsNonGb] = isGbtMark(sessH[1], sessM[1])
    if swIsMark
        // GB number above swing high; "N" prefix for non-GB numbers
        labelTxt = swIsNonGb ? "N" + str.tostring(swGbNum) : str.tostring(swGbNum)
        addSwingLabel(bar_index[1], labelTxt, bearishSmtColor, true, LABEL_PX_NEAR)

// Detect and plot Swing Low (strict GBT mark only)
if enableSwingDetection and isSwingLowPattern and not na(time[1])
    // sessH[1]/sessM[1] == hour/minute of time[1] in the session timezone (cached)
    [swIsMark, swGbNum, swIsNonGb] = isGbtMark(sessH[1], sessM[1])
    if swIsMark
        // GB number below swing low; "N" prefix for non-GB numbers
        labelTxt = swIsNonGb ? "N" + str.tostring(swGbNum) : str.tostring(swGbNum)
        addSwingLabel(bar_index[1], labelTxt, bullishSmtColor, false, LABEL_PX_NEAR)


// ═══════════════════════════════════════════════════════════════════════════════
//                    GB CANDLE SMT (SINGLE-CANDLE DIVERGENCE)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Compares the GB swing stamp of the middle candle across ALL symbols
//  (main chart + enabled comparison symbols).
//  A symbol "stamps" when it forms a 3-candle swing on a strict GBT mark.
//  Single-candle SMT: tiny dot (plotshape circle) ONLY when symbols disagree
//  on the stamp. Direction-aware: above a swing high, below a swing low,
//  with the GB number label beside it (never overlaps).
//
// ═══════════════════════════════════════════════════════════════════════════════

enableGbtCandleSmt = input.bool(false, "Enable GB Candle SMT", group="Candle GB SMT",
  tooltip="Single-candle SMT: dot when symbols disagree on a GB swing stamp. Above swing highs, below swing lows, GB number inside.")
gbtDiamondSize = input.string("Tiny", "Dot Size", options=["Tiny", "Small"], group="Candle GB SMT", inline="gbtDmd")
gbtDiamondColor = input.color(color.yellow, "Dot Color", group="Candle GB SMT", inline="gbtDmd")

// 3-candle swing patterns on each comparison symbol (bars aligned to chart)
s1SwingHigh = s1_high[2] < s1_high[1] and s1_high[0] < s1_high[1]
s1SwingLow = s1_low[2] > s1_low[1] and s1_low[0] > s1_low[1]
s2SwingHigh = s2_high[2] < s2_high[1] and s2_high[0] < s2_high[1]
s2SwingLow = s2_low[2] > s2_low[1] and s2_low[0] > s2_low[1]

// Discrepancy: some symbols stamped the GB swing, some did not.
// The whole computation is skipped when the feature is off (its default); the
// plotshape() calls below stay global because plotshape() cannot be used in
// local scope.
bool gbtCandleDivergence = false
bool dirIsHigh = false
bool dirIsLow = false
string dmdLabelTxt = ""
if enableGbtCandleSmt
    // Per-symbol GB swing stamp on the middle candle (bar[1]):
    // a 3-candle swing formed AND the stamped candle is on a strict GBT mark
    // (sessH[1]/sessM[1] == hour/minute of time[1] in the session timezone, cached)
    mainStampHigh = not na(time[1]) and isGbHM(sessH[1], sessM[1]) and isSwingHighPattern
    mainStampLow = not na(time[1]) and isGbHM(sessH[1], sessM[1]) and isSwingLowPattern
    mainStamp = mainStampHigh or mainStampLow
    
    bool s1StampHigh = false
    bool s1StampLow = false
    if enableSymbol1 and not na(s1_bar_time[1])
        s1IsGb = isGbHM(hour(s1_bar_time[1], sessionTimezone), minute(s1_bar_time[1], sessionTimezone))
        s1StampHigh := s1IsGb and s1SwingHigh
        s1StampLow := s1IsGb and s1SwingLow
    
    bool s2StampHigh = false
    bool s2StampLow = false
    if enableSymbol2 and not na(s2_bar_time[1])
        s2IsGb = isGbHM(hour(s2_bar_time[1], sessionTimezone), minute(s2_bar_time[1], sessionTimezone))
        s2StampHigh := s2IsGb and s2SwingHigh
        s2StampLow := s2IsGb and s2SwingLow
    
    s1Stamp = s1StampHigh or s1StampLow
    s2Stamp = s2StampHigh or s2StampLow
    
    comparedCount = 1 + (enableSymbol1 ? 1 : 0) + (enableSymbol2 ? 1 : 0)
    stampCount = (mainStamp ? 1 : 0) + (s1Stamp ? 1 : 0) + (s2Stamp ? 1 : 0)
    gbtCandleDivergence := stampCount > 0 and stampCount < comparedCount
    
    // Direction: follow the main chart's stamp; fall back to comparison stamps
    dirIsHigh := mainStampHigh or (not mainStampHigh and not mainStampLow and (s1StampHigh or s2StampHigh))
    dirIsLow := mainStampLow or (not mainStampHigh and not mainStampLow and (s1StampLow or s2StampLow) and not (s1StampHigh or s2StampHigh))
    
    // GB number of the stamped candle ("N" prefix for non-GB numbers)
    [dmdIsMark, dmdGbNum, dmdIsNonGb] = isGbtMark(sessH[1], sessM[1])
    dmdLabelTxt := dmdIsNonGb ? "N" + str.tostring(dmdGbNum) : str.tostring(dmdGbNum)

// Tiny dot (plotshape circle - labels enforce a larger minimum size) for the
// single-candle SMT discrepancy. Direction-aware: above a swing high, below
// a swing low. plotshape size must be const, so split by direction+size.
plotshape(gbtCandleDivergence and dirIsHigh and gbtDiamondSize == "Tiny", style=shape.circle, location=location.abovebar,
  color=gbtDiamondColor, size=size.tiny, offset=-1)
plotshape(gbtCandleDivergence and dirIsHigh and gbtDiamondSize != "Tiny", style=shape.circle, location=location.abovebar,
  color=gbtDiamondColor, size=size.small, offset=-1)
plotshape(gbtCandleDivergence and dirIsLow and gbtDiamondSize == "Tiny", style=shape.circle, location=location.belowbar,
  color=gbtDiamondColor, size=size.tiny, offset=-1)
plotshape(gbtCandleDivergence and dirIsLow and gbtDiamondSize != "Tiny", style=shape.circle, location=location.belowbar,
  color=gbtDiamondColor, size=size.small, offset=-1)

// GB number label beside the dot (plain text, pixel-anchored, never overlaps)
if gbtCandleDivergence and dirIsHigh
    addSwingLabel(bar_index[1], dmdLabelTxt, gbtDiamondColor, true, LABEL_PX_FAR)
if gbtCandleDivergence and dirIsLow
    addSwingLabel(bar_index[1], dmdLabelTxt, gbtDiamondColor, false, LABEL_PX_FAR)


// ═══════════════════════════════════════════════════════════════════════════════
//                    NEXT GBT TIME TABLE
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Plain text (top-right, no border): "Next: HH:MM" with the next upcoming
//  GBT master grid mark as wall-clock time in the session timezone.
//  Shows the clock time of the next mark - not the GB number.
//  Optional dynamic dotted vertical line tracks the same next mark; it is
//  deleted and redrawn every bar so it always points at the next upcoming time.
//
// ═══════════════════════════════════════════════════════════════════════════════

// Zero-pad a number to 2 digits (e.g. 5 -> "05")
pad2(int v) =>
    v < 10 ? "0" + str.tostring(v) : str.tostring(v)

// Next GBT mark at or after the current bar time (session timezone clock reading).
// Returns [nextTs, "HH:MM"]: unix ms of the mark and its wall-clock text.
// O(1): nextMarkOffset[] holds the minutes to the next mark (wrapping midnight).
// Note: ts = t + off*60000 (real-time delta); on the 2 DST days/year the line
// may sit one hour off for a single bar - the table text stays correct.
nextGbtMark(int t, int h, int m) =>
    int totalMins = h * 60 + m
    int off = array.get(nextMarkOffset, totalMins)
    int nextMins = (totalMins + off) % 1440
    [t + off * 60000, pad2(math.floor(nextMins / 60)) + ":" + pad2(nextMins % 60)]

showNextGbtLine = input.bool(true, "Show Next GBT Vertical Line", group="Swing Detection")
var table nextGbtTable = table.new(position.top_right, 1, 1)
var line nextGbtLine = na
var string lastNextTxt = ""

if not na(time)
    [nTs, nTxt] = nextGbtMark(time, sessH, sessM)
    
    // Dynamic vertical line at the next mark: deleted and redrawn every bar
    // so it always points at the next upcoming time (one line, no accumulation)
    if showNextGbtLine
        if not na(nextGbtLine)
            line.delete(nextGbtLine)
        nextGbtLine := line.new(nTs, 0, nTs, 0, xloc=xloc.bar_time, extend=extend.both, style=line.style_dotted, color=color.gray, width=1)
    
    // Table text only changes when the next mark changes
    if nTxt != lastNextTxt
        table.cell(nextGbtTable, 0, 0, "Next: " + nTxt, text_color=color.black, text_size=size.normal)
        lastNextTxt := nTxt


// Final check to reposition labels if any changes occurred
// Reposition labels once per bar (not per manager)
if needReposition
    repositionAllLabels()




